<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
            <template id="inherit_payslip_details_report" inherit_id="om_hr_payroll.report_payslip_details">
            <xpath expr="//table[@class='table table-sm mt32']//tbody" position="replace">
                                            <tbody>
                                <tr t-foreach="get_lines_by_contribution_register.get(o.id, [])" t-as="p">
                                    <td>
                                        <span t-esc="p.get('code', '')"/>
                                    </td>
                                    <td>
                                        <span t-esc="p.get('name', '')"/>
                                    </td>
                                    <td>
                                        <span t-esc="p.get('quantity', '')"/>
                                    </td>
<!--                                    <td align="right">-->
                                    <td>
                                        <span t-esc="'%.2f' % p.get('amount', 0)"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % p.get('total', 0)"
                                              t-esc-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>

            </xpath>

            <xpath expr="//table[@class='table table-sm mb32']//tbody" position="replace">
                                            <tbody>
                                <tr t-foreach="get_details_by_rule_category.get(o.id, [])" t-as="h">
                                    <td>
                                        <span t-esc="h['code']"/>
                                    </td>
                                    <td>
                                        <span t-esc="'..'*h['level']"/>
                                        <span t-esc="h['rule_category']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % h['total']"
                                              t-esc-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>

            </xpath>
            </template>
</odoo>