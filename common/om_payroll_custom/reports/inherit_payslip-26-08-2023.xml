        <record id="payslip_paperformat" model="report.paperformat">
        <field name="name">Beta Reports Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">28</field>
        <field name="dpi">99</field>
    </record>



        <report id="om_hr_payroll.action_report_payslip"
            model="hr.payslip"
            string="Payslip"
            report_type="qweb-pdf"
            name="om_hr_payroll.report_payslip"
            file="om_hr_payroll.report_payslip"
            print_report_name="'Payslip - %s' % (object.employee_id.name)"
            paperformat="om_payroll_custom.payslip_paperformat"
    />


        <template id="om_hr_payroll.report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
<!--                <t t-call="web.basic_layout">-->
                    <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
                        <style type="text/css">
                            #details-tbl{
                            border: none;
                            }
                            tr th{
                            padding: 5px 10px;
                            border: none;
                            border-top: 1px solid ;
                            border-bottom: 1px solid ;
                            }
                            #details-tbl tr td{
                            padding: 3px 10px;
                            border: none;
                            border-bottom: 1px solid ;
                            }
                            .text-right{
                            text-align:right !important;
                            }
                            .text-left{
                            text-align:left !important;
                            }
                            .text-center{
                            text-align:center !important;
                            }
                            thead { display: table-header-group; }
                            .table-striped tbody tr:nth-of-type(odd) {
                            background-color: rgba(0, 0, 0, 0.05) !important;
                            }
                            .daybook-table tr td{word-break: break-all; !important}
                            .pagebreak{page-break-after:always}
                            html,body{height:99% !important}
                            @media pdf {
                            a{
                            text-decoration: none !important;
                            color: inherit !important;
                            }
                            thead {display: table-row-group;}
                            tbody tr:nth-of-type(#{$table-striped-order}) {
                            background-color: $table-accent-bg;}
                            .pagebreak{page-break-after:always
                            }
                            }
                            @media print {
                            a{
                            text-decoration: none !important;
                            color: inherit !important;
                            }
                            #branch{padding:0 !important;height: 145px;}
                            .company_name{padding-top:0px !important}
                            .pagebreak{page-break-after:always}}
                            .header_company{display: none;}
                            @media print{
                            .header_company{display: unset;}
                            }
                            @media pdf{
                            .header_company{display: unset;}
                            }
                        </style>
                        <h5 style="font-weight:bold;"><center>Pay Slip</center></h5>
                        <table class="table1">
<!--                            <tr>-->
<!--                                <td colspan="2" class="ta-c fw-b">Pay Slip</td>-->
<!--                            </tr>-->
                            <tr>
                                <td colspan="1" class="table1-tr1">Name:<span class="spacing"><t t-esc="o.employee_id.name"/></span></td>
                                <td colspan="1" class="table1-td">Date:<span class="spacing"><t t-if="o.date"> <t t-esc="o.date.strftime('%d/%m/%Y')"/></t><t t-else=""><br/></t> </span></td>
                            </tr>
                            <tr>
                                <td colspan="1" class="table1-tr1">Period:<span class="spacing"><t t-esc="o.date_from.strftime('%d/%m/%Y')"/>-<t t-esc="o.date_to.strftime('%d/%m/%Y')"/></span></td>
                                <td colspan="1" class="table1-td">Voucher No:<span class="spacing"><t t-esc="o.number"/> </span></td>
                            </tr>
                            <tr>
                                <td colspan="1" class="table1-tr1">Designation:<span class="spacing"><t t-esc="o.contract_id.job_id.name"/> </span></td>
                                <td colspan="1" class="table1-td">No of leaves:<span class="spacing"><t t-esc="o.no_of_leaves"/> </span></td>
                            </tr>
                        </table>

<!--                        <table class="table table-sm">-->
                        <table class="table2">
<!--                            <thead>-->
                                <tr class="table2-tr">
                                    <td class="category">Category</td>
<!--                                    <th class="name">Name</th>-->
                                    <td>Name</td>
                                    <td class="total">Total</td>
                                </tr>
<!--                            </thead>-->
                            <tbody>
                                <tr t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip)" t-as="line">
                                    <td class="table1-tr1">
                                <span t-field="line.category_id.name"/>
                                </td>
                                    <td>
                                <span t-field="line.name"/>
                                </td>

                                <td class="table2-tr1"><t t-if="line.category_id.name == 'Deduction'">
                                -<span t-esc="'{:.2f}'.format(line.total)"/></t><t t-else="line.category_id.name != 'Deduction'"><span t-esc="'{:.2f}'.format(line.total)"/></t>
                                </td>

                                </tr>
                                <tr class="tbody-tr">
                                    <td colspan="2" class="net">Net Salary</td>
                                    <td class="netamount"><t t-esc="'{:.2f}'.format(o.payable_amount)"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row row-padding">
                            <table class="table2">
                                <tr>
                                    <td colspan="1" class="center">--------------<br/>Prepared By</td>
                                    <td colspan="1" class="center">--------------<br/>Authorized By</td>
                                    <td colspan="1" class="center">--------------<br/>Signature</td>
                                </tr>
                            </table>
                        </div>

<!--                        <p class="text-right" >-->
<!--                            <strong>Authorized signature</strong>-->
<!--                        </p>-->
                    </div>
                </t>
            </t>
        </t>
    </template>


    <template id="web.external_layout_standard">
        <t t-if="o._name=='hr.payslip'">

        <div t-attf-class="header o_company_#{company.id}_layout" style="border:1px solid black">
                                <table class="" width="100%">
                        <tr class="company_info">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="7" style="text-align:center;" t-if="'branch_id' in request.env.user._fields and request.env.user.branch_id">
                                <div class="col-12 text-center" style="padding:5px;">
                                    <h6 style="color:#1155cc;" class="directprint-h6" t-esc="request.env.user.company_id.name"/>
                                    <t t-if="request.env.user.branch_id.branch_contactname and request.env.user.branch_id.branch_contactname!=request.env.user.company_id.name">
                                        <span class="f-1rem" t-esc="request.env.user.branch_id.branch_contactname">
                                        </span>
                                        <br/>
                                    </t>
                                    <span class="f-1rem">
                                        <span t-esc="request.env.user.branch_id.branch_street"/>
                                        <span t-esc="request.env.user.branch_id.branch_street2"/>
                                        <span t-esc="request.env.user.branch_id.branch_city"/>
                                        <br/>
                                        <span t-esc="request.env.user.branch_id.branch_state_id.name"/>
                                        , Code:
                                        <span t-esc="request.env.user.branch_id.branch_state_id.l10n_in_tin"/>
                                        ,
                                        <span t-esc="request.env.user.branch_id.branch_country_id.name"/>
                                        <br/>
                                        GSTIN/UIN:
                                        <span t-esc="request.env.user.company_id.vat"/>
                                        <br/>
                                        <t t-if="request.env.user.company_id.company_registry">
                                            CIN:
                                            <span t-esc="request.env.user.company_id.company_registry"/>
                                        </t>
                                    </span>
                                </div>
                            </td>
                            <td t-else="" colspan="7" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center" class="mb4 text-center">
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>
,
                                                <span t-esc="res_company.street2"/>
,
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.city"/>
,
                                                <span t-esc="res_company.state_id.name"/>
,
                                                <span t-esc="res_company.country_id.name"/>
-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
<!--                        <tr>-->
<!--                            <td colspan="7">-->
<!--                                <div class="row zero_min_height">-->
<!--                                    <div class="col-12">-->
<!--                                        <div style="border-bottom: 1px solid #000;"></div>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                            </td>-->
<!--                        </tr>-->
                    </table>

<!--            <div class="row">-->
<!--                <div class="col-3">-->
<!--                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/>-->
<!--                </div>-->
<!--                    <div class="col-9" name="company_address">-->
<!--                    <div t-field="company.partner_id"-->
<!--                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'-->
<!--                    />-->
<!--                </div>-->
<!--            </div>-->
<!--            <div t-if="company.logo or company.report_header" class="row zero_min_height">-->
<!--                <div class="col-12">-->
<!--                    <div style="border-bottom: 1px solid black;"/>-->
<!--                </div>-->
<!--            </div>-->
<!--            <div class="row">-->
<!--                <div class="col-6" name="company_address">-->
<!--                    <div t-field="company.partner_id"-->
<!--                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'-->
<!--                    />-->
<!--                </div>-->
<!--            </div>-->
        </div>
                    </t>
        <t t-else="o._name!='hr.payslip'">
                    <div t-attf-class="header o_company_#{company.id}_layout">
<!--                    <div t-attf-class="header">-->
            <div class="row">
                <div class="col-3 mb4">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/>
                </div>
                <div class="col-9 text-right" style="margin-top:22px;" t-field="company.report_header" name="moto"/>
            </div>
            <div t-if="company.logo or company.report_header" class="row zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
            <div class="row">
                <div class="col-6" name="company_address">
                    <div t-field="company.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'
                    />
                </div>
            </div>
        </div>

        </t>
        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"  t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <t t-raw="0"/>
        </div>

        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div class="text-center" style="border-top: 1px solid black;">
                <ul class="list-inline mb4">
                    <!-- using the list-inline-item class from bootstrap causes weird behaviours in pdf report
                         adding d-inline class fixes the problem-->
                    <li t-if="company.phone" class="list-inline-item d-inline">Phone: <span t-field="company.phone"/></li>
                    <li t-if="company.email" class="list-inline-item d-inline">Email: <span t-field="company.email"/></li>
                    <li t-if="company.website" class="list-inline-item d-inline">Web: <span t-field="company.website"/></li>
                    <li t-if="company.vat" class="list-inline-item d-inline"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/></li>
                </ul>

                <div name="financial_infos">
                    <span t-field="company.report_footer"/>
                </div>

                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page: <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>



</odoo>