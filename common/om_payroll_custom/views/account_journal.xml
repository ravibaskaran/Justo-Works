<odoo>
    <data>

        <record id="payroll_account_journal_view_form" model="ir.ui.view">
            <field name="name">account.journal.payroll.view.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sequence_id']" position="replace">
                        <field name="sequence_id" readonly="0" required="0" string="Sequence"/>
                </xpath>
                <xpath expr="//field[@name='sequence_id']" position="after">
                    <field name="profit_account_id" string="Profit Account"/>
                    <field name="loss_account_id" string="Profit Account"/>
                    <field name="refund_sequence" string="Dedicated Credit Note" attrs="{'invisible': [('type', '!=', 'payslip')]}"/>
                    <label for="refund_sequence_number_next" attrs="{'invisible': ['|',('type', '!=', 'payslip'), ('refund_sequence', '!=', True)]}"/>
                    <div attrs="{'invisible': ['|',('type', '!=', 'payslip'), ('refund_sequence', '!=', True)]}">
                        <field name="refund_sequence_number_next" string="Credit Notes Next Number" style="padding-right: 1.0em"/>
                        <field name="refund_sequence_id" required="0"  readonly="0" />
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>