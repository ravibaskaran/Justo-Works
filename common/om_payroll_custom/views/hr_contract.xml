<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--   ♦ ▼ Inherited 'HR Contract Form View'. ▼ ♦        -->
        <record id="add_pay_per_day" model="ir.ui.view">
            <field name="name">add_pay_per_day</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='wage']/span" position="replace">
                    <span>/&#160;<field name="schedule_pay" readonly="1" force_save="1"/></span>
                </xpath>

            </field>
        </record>


    </data>
</odoo>