<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ♦ ▼ Inherited 'HR Payslip Form View'. ▼ ♦ -->
        <record id="inherit_hr_payslip_mod" model="ir.ui.view">
            <field name="name">inherit_hr_payslip_mod</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='created_date']" position="attributes">
                    <attribute name="readonly">False</attribute>
                    <attribute name="attrs">{'readonly':[('state','not in',['draft'])]}</attribute>
                    <attribute name="string">Voucher Date</attribute>
                </xpath>
                <xpath expr="//field[@name='salary_per_day']" position="after">
                    <field name="pay_type" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='salary_per_day']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='details_by_salary_rule_category']/tree/field[@name='category_id']" position="after">
                    <field name="category_type" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='details_by_salary_rule_category']/tree" position="attributes">
                    <attribute name="decoration-muted">category_type == 'z_adjustment'</attribute>
                    <attribute name="default_order">category_type</attribute>
                </xpath>
                <xpath expr="//form" position="inside">
                    <style>
                        [name='details_by_salary_rule_category'] tr.text-muted{
                            display: none;
                        }
                    </style>
                </xpath>
            </field>
        </record>

    </data>
</odoo>