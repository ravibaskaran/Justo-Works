<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="acquittance_voucher" model="ir.ui.view">
            <field name="name">acquittance_voucher</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="domain">[('type','in',('cash','bank'))]</attribute>
                    <attribute name="options">{'no_quick_create': True,'no_create_edit':True,'no_create':True,'no_open':True}</attribute>
                </xpath>
                <xpath expr="//field[@name='credit_note']" position="attributes">
                     <attribute name="invisible">1</attribute>
                 </xpath>
<!--                 <xpath expr="//field[@name='journal_id']" position="after">-->
<!--                     <field name="fetch_employee" attrs="{'readonly': [('id', '!=', False)]}"/>-->
<!--                 </xpath>-->

                <xpath expr="//sheet/group[1]" position="after">
<!--                        <field name="fetch_employee"/>-->
                        <button string="Mass Compute" name="mass_compute" type="object"  class="oe_highlight"/>
                        <![CDATA[&nbsp;]]>
                        <button name="mass_confirm" type="object"  string="Mass Confirm" class="oe_highlight" />
                </xpath>

<!--                 <xpath expr="//header/button[@class='oe_highlight'][1]" position="attributes">-->
<!--                     <attribute name="invisible">1</attribute>-->
<!--                 </xpath>-->
                <xpath expr="//header/button[@class='oe_highlight'][2]" position="attributes">
                     <attribute name="invisible">1</attribute>
                 </xpath>
                <xpath expr="//field[@name='slip_ids']" position="inside">
                    <tree editable="bottom">
                        <field name="number" readonly="1"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                        <field name="no_of_leaves" />
                        <field name="payable_amount" readonly="1"/>
                        <field name="state" readonly="1"/>
                    </tree>
                 </xpath>



            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="inherit_hr_payslip_tree" model="ir.ui.view">
            <field name="name">hr_payslip_tree_view</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="after">
                    <field name="contract_id" invisible="1"/>
                    <field name="struct_id" invisible="1"/>
<!--                    <field name="branch_id" invisible="1"/>-->
                    <field name="no_of_leaves" invisible="1"/>
                    <field name="salary_per_day" invisible="1"/>
                    <field name="account_journal_id" invisible="1"/>
                    <field name="no_of_days" invisible="1"/>


                </xpath>
                <xpath expr="//field[@name='date_to']" position="after">
<!--                    <field name="no_of_leaves" />-->
                    <field name="payable_amount"/>
                </xpath>

            </field>
        </record>
        <record id="inherit_hr_payslip_employee" model="ir.ui.view">
            <field name="name">hr_payslip_employee_view</field>
            <field name="model">hr.payslip.employees</field>
            <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_by_employees"/>
            <field name="arch" type="xml">
                    <xpath expr="//field[@name='employee_ids']" position="attributes">
                        <attribute name="domain">[('contract_id.state','=','open')]</attribute>
                    </xpath>
            </field>
        </record>
    </data>
</odoo>