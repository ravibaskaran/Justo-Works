<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="hr_payroll_inherit" model="ir.ui.view">
            <field name="name">Hr Payroll Inherit</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[1]" position="before">
                    <xpath expr="//page[3]" position="move"/>
                </xpath>
                <xpath expr="//page[2]/separator[1]" position="attributes">
                        <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='worked_days_line_ids']" position="attributes">
                        <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//button[@name='compute_sheet']" position="after">
                    <button string="Print" name="payslip_print" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//button[@name='action_payslip_cancel']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//button[@name='compute_sheet']" position="after">
                    <button string="Cancel Payslip" name="cancel_sheet" type="object" class="oe_highlight" states="done"/>
                </xpath>

                <xpath expr="//field[@name='name']" position="after">
                    <field name="created_date" readonly="1" force_save="1"/>
                    <field name="no_of_days" readonly="1" force_save="1"/>
                    <field name="no_of_leaves" attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <field name="salary_per_day" attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <field name="leave_deduction_amount" readonly="1" force_save="1" invisible="1"/>
                    <field name="payable_amount" attrs="{'readonly': [('state', '=', 'done')]}" invisible="1"/>
                </xpath>

                 <xpath expr="//field[@name='credit_note']" position="attributes">
                     <attribute name="invisible">1</attribute>

                 </xpath>
                <xpath expr="//field[@name='employee_id']" position="attributes">
                        <attribute name="domain">[('contract_id.state','=','open')]</attribute>
                    </xpath>
                 <xpath expr="//page[3]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                 <xpath expr="//button[@name='refund_sheet']" position="attributes">
                     <attribute name="invisible">1</attribute>
                 </xpath>

                 <xpath expr="//field[@name='details_by_salary_rule_category']" position="after">
                    <group class="oe_subtotal_footer" style="padding: 0;margin:0;border:none;font-weight:bold;font-size:24px;">
                        <field name="payable_amount" string="Net Salary" readonly="1"/>
                    </group>
                 </xpath>

                <xpath expr="//form/sheet" position="after">
              <div class="oe_chatter">
                  <field name="message_follower_ids" widget="mail_followers"/>
                  <field name="activity_ids" widget="mail_activity"/>
                  <field name="message_ids" widget="mail_thread" />
              </div>
          </xpath>
           </field>
        </record>
</odoo>