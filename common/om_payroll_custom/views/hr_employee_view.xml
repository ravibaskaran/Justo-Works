<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_employee_inherit" model="ir.ui.view">
            <field name="name">Hr Employee Inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='address_home_id']" position="replace">
                <field name="address_home_id" context="{'show_address': 1,'default_type': 'private','form_view_ref': 'base.res_partner_view_form_private'}" options="{&quot;always_reload&quot;: True, &quot;highlight_first_line&quot;: True}" readonly="False"/>
                </xpath>
            </field>

    </record>


</odoo>