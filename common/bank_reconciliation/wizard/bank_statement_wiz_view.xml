<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report id="bank_reconciliation_report_action"
            model="sales.man.liability"
            name="bank_reconciliation.bank_reconciliation_report"
            file="bank_reconciliation.bank_reconciliation_report"
            report_type="qweb-html"
            string="Bank Reconciliation Report"/>

    <template id="bank_reconciliation_report">
        <t t-call="web.html_container">
            <t t-if="res_company">
                <table>
                    <tr colspan="11">
                    </tr>
                </table>
                <div class="header o_company_1_layout ">
                    <div class="row">
                        <div class="col-2 mb4">
                            <img style=" width: 120px;" t-if="res_company.logo"
                                 t-att-src="image_data_uri(res_company.logo)" class="float-left" loading="eager"
                                 alt="Logo"/>
                        </div>
                        <div class="col-8 mb4 text-center" style="padding-top: 12px;">
                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;text-align:center;">
                                <span t-esc="res_company.name"/>
                            </h4>
                            <h5 style="font-size: 1.0rem;margin-bottom:0;text-align:center;">
                                <span t-esc="res_company.street"/>,
                                <span t-esc="res_company.street2"/>,
                                <span t-esc="res_company.city"/>,
                                <span t-esc="res_company.state_id.name"/>,
                                <span t-esc="res_company.country_id.name"/>-
                                <span t-esc="res_company.zip"/>
                            </h5>
                            <h5 style="font-size: 1.0rem;margin-bottom:0;text-align:center;">
                                <span style="padding-right:15px">Phone :
                                    <span t-esc="res_company.phone"/>
                                </span>
                                Email :
                                <span t-esc="res_company.email"/>
                            </h5>
                            <h5 style="font-size: 1.0rem;margin-bottom:0;text-align:center;">
                                <span class="list-inline-item d-inline">
                                    GSTIN
                                    :
                                </span>
                                <span t-esc="res_company.vat"/>
                            </h5>
                            <h5 t-if="branch_name" style="font-size: 1.0rem;margin-bottom:0;text-align:center;">
                                <span class="list-inline-item d-inline">
                                    Branch
                                    :
                                </span>
                                <span>
                                    <t t-esc="branch_name"/>
                                </span>
                            </h5>
                        </div>
                        <div class="col-2 mb4"/>
                    </div>
                    <div class="col-14 text-center mb4">
                        <div style="border-bottom: 1px solid;"/>
                    </div>
                </div>
            </t>
            <div class="article">
                <t t-set="decimal_precision" t-value="request.env['decimal.precision'].precision_get('Product Price')"/>
                <h6 style="font-size: 1.2rem;margin-top:10px;text-align:center;">
                    <span>Bank Reconciliation Report</span>
                </h6>
                <table style="margin-top:10px;font-size: .81rem;" width="100%">
                    <tbody width="100%">
                        <tr width="100%">
                            <td width="18%">
                                <p style="padding-left:1rem">
                                    <strong>Date From</strong>
                                </p>
                            </td>
                            <td width="70%">
                                <p t-esc="date_from"/>
                            </td>
                            <td width="8%">
                                <p>
                                    <strong>Date To</strong>
                                </p>
                            </td>
                            <td width="10%">
                                <p t-esc="date_to"/>
                            </td>
                        </tr>
                        <tr>
                            <td width="18%">
                                <p style="padding-left:1rem">
                                    <strong>Ledger Opening</strong>
                                </p>
                            </td>
                            <td width="67%">
                                <p t-esc="ledger_opening"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                       style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                    <style>.table td{ padding: .8px !important;}</style>
                    <thead>
                        <tr>
                            <th style="text-align:center;width:20%">Account</th>
                            <th style="text-align:center;width:20%">Partner</th>
                            <th style="text-align:center;width:12%">Label</th>
                            <th style="text-align:center;width:10%">Reference</th>
                            <th style="text-align:center;width:8%">Date</th>
                            <th style="text-align:center;width:10%">Statement Date</th>
                            <th style="text-align:center;width:10%">Debit</th>
                            <th style="text-align:center;width:10%">Credit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="doc">
                            <tr>
                                <td style="text-align:left">
                                    <t t-esc="doc['account']"/>
                                </td>
                                <td style="text-align:left">
                                    <t t-esc="doc['partner']"/>
                                </td>
                                <td style="text-align:left">
                                    <t t-esc="doc['label']"/>
                                </td>
                                <td style="text-align:left">
                                    <t t-esc="doc['ref']"/>
                                </td>
                                <td style="text-align:center">
                                    <t t-esc="doc['date']"/>
                                </td>
                                <td style="text-align:center">
                                    <t t-esc="doc['statement_date']"/>
                                </td>
                                <td style="text-align:right">
                                    <t t-esc="doc['debit']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="text-align:right">
                                    <t t-esc="doc['credit']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td style="text-align:right" colspan="7">
                                <strong>Balance as per Company Books:</strong>
                            </td>
                            <td style="text-align:right">
                                <t t-esc="gl_balance" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:right" colspan="7">
                                <strong>Amounts not Reflected in Bank:</strong>
                            </td>
                            <td style="text-align:right">
                                <t t-esc="balance_difference" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:right" colspan="7">
                                <strong>Balance as per Bank:</strong>
                            </td>
                            <td style="text-align:right">
                                <t t-esc="bank_balance" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <record id="bank_statement_wiz" model="ir.ui.view">
        <field name="name">bank.statement.reconciliation</field>
        <field name="model">bank.statement</field>
        <field name="arch" type="xml">
            <form string="Bank Statement Reconciliation">
                <group>
                    <group>
                        <field name="id" invisible="1"/>
                        <field name="journal_id" attrs="{'readonly':[('id','>', 0)]}"
                               options="{'no_create': True, 'no_create_edit':True}"/>
                        <field name="account_id" invisible="1"/>
                        <field name="ledger_opening"/>
                        <field name="bank_opening"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <div style="text-align:center">
                    <button name="get_report" string="Fetch Data" type="object" class="oe_highlight bank_reconcil"
                            style="width: 120px;height: 40px;margin-top: 10px;"/>
                    <button name="clear_value" string="Clear" type="object"
                            style="width: 120px;height: 40px;margin-top: 10px;"/>
                    <button name="bank_reconcil_get_report" string="Print" type="object"
                            style="width: 120px;height: 40px;margin-top: 10px;"/>
                </div>
                <group>
                    <field name="statement_lines" nolabel="1" widget="section_and_note_one2many">
                        <tree create="false" class="bank_reconcil_tree" editable="bottom" default_order="date" limit="1000" search_by_fields="1">
                            <field name="move_id" readonly="True" invisible="1" groups="account.group_account_user"/>
                            <field name="account_id" readonly="True"/>
                            <field name="partner_id" readonly="True"/>
                            <field name="name" readonly="True"/>
                            <field name="ref" readonly="True"/>
                            <field name="amount_currency" readonly="True" groups="base.group_multi_currency"/>
                            <field name="currency_id" readonly="True" invisible="1"/>
                            <field name="date" readonly="True"/>
                            <field name="statement_date"/>
                            <field name="company_currency_id" invisible="1" readonly="True"/>
                            <field name="debit" readonly="True"/>
                            <field name="credit" readonly="True"/>
                        </tree>
                    </field>
                </group>
                <group class="oe_subtotal_footer oe_right">
                    <field name="gl_balance"/>
                    <field name="balance_difference"/>
                    <field name="bank_balance"/>
                </group>
                <script>
                    $(document).ready(function() {
                        if ($('.o_technical_modal .modal-dialog .modal-footer')[0] ){
                            var con = $($('.o_technical_modal .modal-dialog .modal-footer')[0])
                            $($('.o_technical_modal .modal-dialog .modal-footer button')[1]).click();
                            $('.bank_reconcil').click();
                        }
                    })
                </script>
                <style>
                    th[data-name="account_id"]{
                        width: 20% !important;
                    }
                    th[data-name="ref"]{
                        max-width: 12% !important;
                    }
                </style>
            </form>
        </field>
    </record>

    <record id="bank_statement_wiz_tree" model="ir.ui.view">
        <field name="name">bank.statement.reconciliation.tree</field>
        <field name="model">bank.statement</field>
        <field name="arch" type="xml">
            <tree string="Bank Statement Reconciliation">
                <field name="journal_id"/>
                <field name="account_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </tree>
        </field>
    </record>

    <record id="action_bank_statement_wiz" model="ir.actions.act_window">
        <field name="name">Bank Statement Reconciliation</field>
        <field name="res_model">bank.statement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids"
               eval="[(5,0,0),(0,0,{'view_mode':'tree','view_id':ref('bank_statement_wiz_tree')}),(0,0,{'view_mode':'form','view_id':ref('bank_statement_wiz')})]"/>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_action_bank_reconciliation" parent="account.menu_finance_entries_actions"
              action="action_bank_statement_wiz" sequence="25"/>
</odoo>