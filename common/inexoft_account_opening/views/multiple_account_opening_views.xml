<odoo>
    <data>
        <record id="view_account_opening_tree" model="ir.ui.view">
            <field name="name">account.opening.view.tree</field>
            <field name="model">multiple.account.opening</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="date" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="view_account_opening_form" model="ir.ui.view">
            <field name="name">account.opening.view.form</field>
            <field name="model">multiple.account.opening</field>
            <field name="arch" type="xml">
                <form string="Account Opening" delete="0">
                    <header>
                        <button name="validate_opening" type="object" string="Validate"
                                groups="account.group_account_user" class="oe_highlight" states="draft"/>
                        <button name="set_to_draft_opening" type="object" string="Reset to Draft"
                                groups="inexoft_account_opening.group_opening_cancel" states="posted"/>
                        <button name="cancel_opening" type="object" string="Cancel"
                                groups="inexoft_account_opening.group_opening_cancel" states="draft"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="account_opening_move_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Account Opening">
                                <group>
                                    <field name="opening_ids" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="account_id"/>
                                            <field name="partner_id"/>
                                            <field name="debit" sum="Total"/>
                                            <field name="credit" sum="Total"/>
                                            <field name="name"/>
                                            <field name="company_id" invisible="1"/>
                                            <field name="company_currency_id" invisible="1"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                            <page string="Account Summary">
                                <group>
                                    <field name="summary_ids" nolabel="1">
                                        <tree>
                                            <field name="account_id"/>
                                            <field name="debit" sum="Total"/>
                                            <field name="credit" sum="Total"/>
                                            <field name="company_id" invisible="1"/>
                                            <field name="company_currency_id" invisible="1"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_account_opening" model="ir.actions.act_window">
            <field name="name">Account Opening</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">multiple.account.opening</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_account_opening_root" name="Opening" parent="account.menu_finance_entries"/>

        <menuitem id="menu_account_opening" name="Account Opening" action="action_account_opening"
                  parent="menu_account_opening_root" sequence="1"/>
    </data>
</odoo>