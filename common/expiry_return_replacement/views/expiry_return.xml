<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Expiry Return Action -->
        <record id="action_expiry_return" model="ir.actions.act_window">
            <field name="name">Expiry Return</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain" eval="[('move_type', '=', 'in_refund'),('direct_move_type', '=', 'incoming'),('journal_id','=',ref('Expiry_Return'))]"/>
            <field name="context" eval="{'default_move_type': 'in_refund', 'default_direct_move_type':'incoming', 'default_journal_id': ref('Expiry_Return'),'default_expiry_type':'expiry_rtn'}"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a direct expiry return
                </p>
                <p>
                    Note that the easiest way to create a direct expiry return it to do it directly from the vendor
                    bill.
                </p>
            </field>
        </record>



        <!-- Purchase Return Action Modification -->
        <record id="inexoft_direct_sales_purchase.action_direct_move_outgoing_return" model="ir.actions.act_window">
            <field name="domain" eval="[('move_type', '=', 'in_refund'),('direct_move_type', '=', 'incoming'),('journal_id','!=',ref('Expiry_Return'))]"/>
        </record>



    </data>
</odoo>