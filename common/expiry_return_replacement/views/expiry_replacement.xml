<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Expiry Replacement Action -->
        <record id="action_expiry_replacement" model="ir.actions.act_window">
            <field name="name">Expiry Replacement</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain" eval="[('move_type', '=', 'in_invoice'),('direct_move_type','=','incoming'),('journal_id','=',ref('Expiry_Replacement'))]"/>
            <field name="context" eval="{'default_journal_id': ref('Expiry_Replacement'),'default_move_type': 'in_invoice','default_direct_move_type' : 'incoming', 'purchase_ok':False,'search_default_today':1,'default_expiry_type':'expiry_rpl'}" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a direct expiry entry
                </p>
                <p>
                    Create expiry, register payments and keep track of the discussions with your vendors.
                </p>
            </field>
        </record>



        <!-- Purchase Action Modification -->
        <record id="inexoft_direct_sales_purchase.action_direct_move_outgoing" model="ir.actions.act_window">
            <field name="domain" eval="[('move_type', '=', 'in_invoice'),('direct_move_type','=','incoming'),('journal_id','!=',ref('Expiry_Replacement'))]"/>
        </record>


    </data>
</odoo>