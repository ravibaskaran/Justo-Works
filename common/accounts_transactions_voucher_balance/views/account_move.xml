<odoo>
    <data>
        <record id="direct_journal_view_move_form_inherit" model="ir.ui.view">
            <field name="name">direct_journal_view_move_form.inherit.template</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="inexoft_account_voucher.direct_journal_view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='direct_journal_id_inx']" position="replace">
                    <div class="o_row o_td_label">
                        <label for="direct_journal_id_inx" string="Journal"/>
                    </div>
                    <div class="o_row" style="width: 100% !important">
                        <field name="direct_journal_id_inx" options="{'no_create':True}"
                               attrs="{'required':[('direct_journal_entry_inx','=', True)],'readonly':[('state','not in',['draft'])]}"/>
                        <field name="journal_balance" nolabel="1"
                               style="max-width:100px;padding-right:35px; float:right"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>