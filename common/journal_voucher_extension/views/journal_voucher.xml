<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">view_move_form_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="attributes">
                    <attribute name="domain">[('hide', '=', False), ('deprecated', '=', False),  ('company_id', '=', parent.company_id)]</attribute>
                </xpath>

            </field>
        </record>

        <record id="hide_account" model="ir.ui.view">
            <field name="name">hide_account</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="inexoft_account_voucher.direct_journal_view_move_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='direct_journal_item_ids']/tree/field[@name='account_id']" position="attributes">
                    <attribute name="domain">[('hide', '=', False), ('deprecated', '=', False),  ('company_id', '=', parent.company_id)]</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>