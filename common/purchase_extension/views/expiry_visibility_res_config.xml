<odoo>

    <!--  ♦ ▼ Inherited 'Configuration Settings'. ▼ ♦  -->
    <record id="res_config_inherit_expiry" model="ir.ui.view">
        <field name="name">res.config.settings.expiry</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- ▼ Expiry Group in Settings ▼ -->
            <xpath expr="//h2[6]" position="before">
                <h2>Expiry Visibility</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box" title="expiry visibility in forms.">
                        <div class="o_setting_left_pane">
                            <field name="group_expiry"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="group_expiry" string="Show Expiry" class="col-5 col-lg-5 o_light_label"/>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>