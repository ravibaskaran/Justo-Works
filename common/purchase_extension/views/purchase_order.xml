<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ♦ Action For Vendor Bills ♦ -->
        <record id="action_get_bills" model="ir.actions.act_window">
            <field name="name">Bill</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="domain">[('purchase_order','=',active_id)]</field>
            <field name="context">{'default_purchase_order':active_id}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a customer invoice
                </p>
                <p>
                    Create bill, register payments and keep track of the discussions with your supplier.
                </p>
            </field>
        </record>

        <!-- ♦ ▼ Inherited 'Purchase Order Form View'. ▼ ♦ -->
        <record id="purchase_order_modification" model="ir.ui.view">
            <field name="name">purchase_order_modification</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="class">purchase_order_lines_style</attribute>
                </xpath>

                <!-- ▼ Replaced Header ▼-->
                <xpath expr="//header" position="replace">
                    <header>
                        <button name="action_rfq_send" states="draft" string="Send by Email" type="object" context="{'send_rfq':True}" class="oe_highlight" data-hotkey="g"/>
                        <button name="print_quotation" string="Print RFQ" type="object" states="draft" class="oe_highlight" groups="base.group_user" data-hotkey="k"/>
                        <button name="action_create_invoice" string="Create Bill" type="object" class="oe_highlight" context="{'create_bill':True}" attrs="{'invisible': ['|', ('state', 'not in', ('purchase', 'done')), ('invoice_status', 'in', ('no', 'invoiced'))]}" data-hotkey="w"/>
                        <button name="action_rfq_send" states="sent" string="Re-Send by Email" type="object" context="{'send_rfq':True}" data-hotkey="g"/>
                        <button name="print_quotation" string="Print RFQ" type="object" states="sent" groups="base.group_user" data-hotkey="k"/>
                        <button name="action_rfq_send" states="purchase" string="Send PO by Email" type="object" context="{'send_rfq':False}" data-hotkey="g"/>
                        <button name="action_create_invoice" string="Create Bill" type="object" context="{'create_bill':True}" attrs="{'invisible': ['|', '|', ('state', 'not in', ('purchase', 'done')), ('invoice_status', 'not in', ('no', 'invoiced')), ('order_line', '=', [])]}" data-hotkey="w"/>
                        <button name="button_confirm" type="object" states="sent" string="Confirm Order" class="oe_highlight" id="bid_confirm" data-hotkey="v"/>
                        <button name="button_confirm" type="object" states="draft" string="Confirm Order" id="draft_confirm"/>
                        <button name="print" string="Print" type="object"  class="oe_highlight" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,sent,purchase" readonly="1"/>
                    </header>
                </xpath>

                <!-- ▼ Vendor Bills ▼-->
                <xpath expr="//sheet/div[@class='oe_button_box'][1]" position="replace">
                    <div class="oe_button_box" name="button_box">
                        <button type="action" name="%(action_get_bills)d" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                        </button>
                    </div>
                </xpath>

                <!-- ▼ Hide GST Treatment ▼ -->
                <xpath expr="//field[@name='l10n_in_gst_treatment']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- ▼ Hide Ask Confirmation ▼ -->
                <xpath expr="//div[@name='reminder']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- ▼ Hide Receipt Date ▼ -->
                <xpath expr="//field[@name='date_planned']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//label[@for='date_planned']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- ▼ Domain filter in Vendor Field ▼-->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="context">{'default_supplier_rank':1}</attribute>
                    <attribute name="domain">[('supplier_rank','&gt;=', 1)]</attribute>
                    <attribute name="required">1</attribute>
                </xpath>

                <!-- Remove Add a note and Add a Selection-->
                <xpath expr="//field[@name='order_line']/tree/control" position='replace'>
                    <control>
                        <create name="add_line_control" string="Add a line"/>
                    </control>
                </xpath>

                <xpath expr="//page[@name='purchase_delivery_invoice']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>

                <xpath expr="//field[@name='product_id']" position="attributes">
                    <attribute name="widget">advance_search_many2one</attribute>
                    <attribute name="adv_fields">{"barcode":["Barcode","l"],"qty_available":["Stock","r"],"uom_id":["Unit","l"],"standard_price":["Cost","r"],"list_price":["Price","r"]}</attribute>
                </xpath>

                <!-- Purchased Quantity -->
<!--                <xpath expr="//field[@name='product_qty']" position="after">-->
<!--                    <field name="qty_purchased" readonly="1"/>-->
<!--                </xpath>-->

                <!-- Form Style -->
                <xpath expr="//form/sheet" position="after">
                        <style>

                            .adv_search_autocomplete_dropdown.product_id .ui-menu-item &gt; a:nth-child(1)
                            {
                                width: 150px;
                            }

                        </style>
                </xpath>



            </field>
        </record>


        <record id="purchase.purchase_form_action" model="ir.actions.act_window">
            <field name="domain">[]</field>
        </record>

        <!-- Search Filter -->
        <record id="purchase_order_today_group" model="ir.ui.view">
            <field name="name">purchase_order_today_group</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <filter name="today" string="Today" domain="[('date_planned', '=', context_today().strftime('%Y-%m-%d'))]" />
                </xpath>
            </field>
        </record>

         <record id="purchase.purchase_form_action" model="ir.actions.act_window">
            <field name="context">{'search_default_today':1}</field>
        </record>


    </data>
</odoo>