<odoo>
    <data>
        <record id="account_move_form_modified" model="ir.ui.view">
            <field name="name">account.move.form.modified</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="inexoft_account_voucher.direct_journal_view_move_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//button[@name='button_draft']" position="attributes">
                        <attribute name="groups">inexoft_account_voucher_access.group_voucher_draft</attribute>
                    </xpath>
                    <xpath expr="//button[@name='button_cancel']" position="attributes">
                        <attribute name="groups">inexoft_account_voucher_access.group_voucher_cancel</attribute>
                        <attribute name="confirm">Are you sure, you want to proceed?</attribute>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="journal_voucher_form_modified" model="ir.ui.view">
            <field name="name">journal.voucher.form.modified</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <data>

                    <xpath expr="//button[@name='button_draft']" position="after">
                        <button name="button_draft_voucher" string="Reset to Draft" type="object" groups="inexoft_account_voucher_access.group_voucher_draft"
                                attrs="{'invisible':['|', ('move_type', 'in',('out_invoice','out_refund','in_invoice','in_refund')), ('state', 'in',('draft'))]}"/>
                        <button name="button_cancel_voucher" string="Cancel" type="object" groups="inexoft_account_voucher_access.group_voucher_cancel" confirm="Are you sure, you want to proceed?"
                                attrs="{'invisible':['|', ('move_type', 'in',('out_invoice','out_refund','in_invoice','in_refund')), ('state', 'not in',('draft'))]}"/>
                    </xpath>
                    <xpath expr="//button[@name='button_cancel']" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>