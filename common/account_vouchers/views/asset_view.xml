<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="account_asset_inherit" model="ir.ui.view">
        <field name="name">account_asset_inherit</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.view_account_asset_asset_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{'default_supplier_rank':1}</attribute>
            </xpath>

        </field>
    </record>
</odoo>