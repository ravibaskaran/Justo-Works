<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@class='oe_invoice_lines_tab']/group[1]" position="before">
                    <group name="tax_description" class="col-md-6" colspan="6"/>
                    <group name="other_charges" string="Other Charges" class="col-md-6" colspan="6" style="margin-top: -20px;" attrs="{'invisible':[('move_type','not in',['in_invoice', 'in_refund'])]}">
                        <field name="freight_charge_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="account_id" width="1.5" options="{'no_create':True,'no_open':True}"/>
                                <field name="amount" width="1"/>
                                <field name="name" width="1.5"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']"  position="after">
                    <field name="partner_id" invisible="0"/>
                </xpath>

                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="attributes">
                    <attribute name="options">options="{'no_create':True,'no_open':True}"</attribute>
                </xpath>

                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_internal_type']" position="after">
                    <field name="is_freight" invisible="1"/>
                    <field name="partner_id" invisible="1"/>

                </xpath>
            </field>
        </record>
    </data>
</odoo>