<odoo>
    <data>

        <!-- Multiple Account Opening Form ( Financial Year )-->
        <record id="view_account_opening_form_financial" model="ir.ui.view">
            <field name="name">view_account_opening_form_financial</field>
            <field name="model">multiple.account.opening</field>
            <field name="inherit_id" ref="inexoft_account_opening.view_account_opening_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date']" position="after">
                    <field name="financial_range" attrs="{'readonly':[('state','!=','draft')]}" force_save="1"
                           context="{'financial_year':True}" required="1" widget="selection"
                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Add Financial Year in tree view -->
        <record id="view_account_opening_tree_financial" model="ir.ui.view">
            <field name="name">view_account_opening_tree_financial</field>
            <field name="model">multiple.account.opening</field>
            <field name="inherit_id" ref="inexoft_account_opening.view_account_opening_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="financial_range"/>
                </xpath>
                <xpath expr="//field[@name='date']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>