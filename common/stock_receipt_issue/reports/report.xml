<odoo>
    <data>

        <record id="stock_receipt_issue_note_print_format" model="report.paperformat">
            <field name="name">Beta Reports Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">28</field>
            <field name="dpi">99</field>
        </record>


        <record id="reports_pdf_action" model="ir.actions.report">
            <field name="name">Print</field>
            <field name="model">stock.inventory</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">stock_receipt_issue.report_stock_receipt_issue_note</field>
            <field name="report_file">stock_receipt_issue.report_stock_receipt_issue_note</field>
            <field name="binding_model_id" ref="stock_receipt_issue.model_stock_inventory"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="beta_reports_base.beta_reports_paper_format_portrait"/>
        </record>

        <record id="stock_report_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">print</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.inventory</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context"
                   eval="{'default_report_id': ref('stock_receipt_issue.reports_pdf_action')}"/>  <!--CHANGE THIS-->
        </record>
        <template id="report_stock_receipt_issue_note">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">

                    <t t-if="res_company">
                        <div class="header">
                            <table class="" width="100%">
                                <tr class="company_info" style="height:130px !important;">
                                    <td id="logo_company" class="text-center logo_company" colspan="0"
                                        style="float: left;position: absolute;">
                                        <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;"
                                             class="mb4">
                                            <img style="width: 100px;" t-if="res_company.logo"
                                                 t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                        </div>
                                    </td>
                                    <td colspan="8" style="float: left;width: 100%;text-align: center;">
                                        <table width="100%" style="margin-top: 12px;text-align:center"
                                               class="mb4 text-center">
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                        <span t-esc="res_company.name"/>
                                                    </h4>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    <p style="margin-bottom:0;">
                                                        <span t-esc="res_company.street"/>,
                                                        <span t-esc="res_company.street2"/>,
                                                        <span t-esc="res_company.city"/>,
                                                        <span t-esc="res_company.state_id.name"/>,
                                                        <span t-esc="res_company.country_id.name"/>-
                                                        <span t-esc="res_company.zip"/>
                                                    </p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    <p style="margin-bottom:0;">
                                                        <span t-if="res_company.phone" style="padding-right:15px">Phone
                                                            :
                                                            <span t-esc="res_company.phone"/>
                                                        </span>
                                                        <span t-if="res_company.email">
                                                            Email :
                                                            <span t-esc="res_company.email"/>
                                                        </span>
                                                    </p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    <p t-if="res_company.vat">
                                                        <span class="list-inline-item d-inline">
                                                            GSTIN
                                                            :
                                                        </span>
                                                        <span t-esc="res_company.vat"/>
                                                    </p>
                                                </td>

                                            </tr>
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    <span t-if="branch_name!=''">Branch :
                                                        <t t-esc="branch_name"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="8">
                                        <div class="row zero_min_height">
                                            <div class="col-12">
                                                <div style="border-bottom: 1px solid #000;"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                    <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
                        <style type="text/css">
                            #details-tbl{
                            border: none;
                            }
                            tr th{
                            padding: 5px 10px;
                            border: none;
                            border-top: 1px solid ;
                            border-bottom: 1px solid ;
                            }
                            #details-tbl tr td{
                            padding: 3px 10px;
                            border: none;
                            border-bottom: 1px solid ;
                            }
                            .text-right{
                            text-align:right !important;
                            }
                            .text-left{
                            text-align:left !important;
                            }
                            .text-center{
                            text-align:center !important;
                            }
                            thead { display: table-header-group; }
                            .table-striped tbody tr:nth-of-type(odd) {
                            background-color: rgba(0, 0, 0, 0.05) !important;
                            }
                            .daybook-table tr td{word-break: break-all; !important}
                            .pagebreak{page-break-after:always}
                            html,body{height:99% !important}
                            @media pdf {
                            a{
                            text-decoration: none !important;
                            color: inherit !important;
                            }
                            thead {display: table-row-group;}
                            tbody tr:nth-of-type(#{$table-striped-order}) {
                            background-color: $table-accent-bg;}
                            .pagebreak{page-break-after:always
                            }
                            }
                            @media print {
                            a{
                            text-decoration: none !important;
                            color: inherit !important;
                            }
                            #branch{padding:0 !important;height: 145px;}
                            .company_name{padding-top:0px !important}
                            .pagebreak{page-break-after:always}}
                            .header_company{display: none;}
                            @media print{
                            .header_company{display: unset;}
                            }
                            @media pdf{
                            .header_company{display: unset;}
                            }
                        </style>
                        <table class="purchase_group_cls" style="margin: 20px 0px 0px 23px;table-layout:fixed"
                               width="100%">
                            <tbody width="100%">
                                <tr width="100%">
                                    <td class="bfont1" width="6%">Voucher</td>
                                    <td class="bfont2" width="31%">
                                        <p t-field="o.seq"/>
                                    </td>
                                    <td class="bfont1" width="4%">Date</td>
                                    <td class="bfont2" width="25%">
                                        <p t-field="o.date"/>
                                    </td>
                                    <td class="bfont1" width="6%">Remarks</td>
                                    <td class="bfont2" width="27%">
                                        <p t-field="o.remarks"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table border="1" class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th width="4%" class="text-center">
                                        <span class="bfont">SlNo</span>
                                    </th>
                                    <th width="35%" class="text-left">
                                        <span class="bfont">Product</span>
                                    </th>
                                    <th width="6%" class="text-center">
                                        <span class="bfont">Qty</span>
                                    </th>
                                    <th width="8%" class="text-center">
                                        <span class="bfont">Lot/Serial</span>
                                    </th>
                                    <th width="5%" class="text-center" t-if="'product_uom_id' in o.line_ids._fields">
                                        <span class="bfont">Pcs</span>
                                    </th>
                                    <th width="8%" class="text-center">
                                        <span class="bfont">Sales Rate</span>
                                    </th>
                                    <th width="8%" class="text-center" t-if="'p_rate' in o.line_ids._fields">
                                        <span class="bfont">P Rate</span>
                                    </th>
                                    <t t-if="o.adj_type=='receipt'">
                                        <th width="8%" class="text-center" t-if="'sales_disc_r' in o.line_ids._fields">
                                            <span class="bfont">Disc R</span>
                                        </th>
                                        <th width="8%" class="text-center" t-if="'sales_disc_w' in o.line_ids._fields">
                                            <span class="bfont">Disc W</span>
                                        </th>
                                    </t>
                                    <th width="10%" class="text-center" t-if="'amount' in o.line_ids._fields">
                                        <span class="bfont">Amount</span>
                                    </th>
                                    <!--                            <th class="text-center"><span class="bfont">Liability</span></th>-->
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="row">
                                    <td class="text-right">
                                        <span class="tfont" t-esc="row.sl_no"/>
                                    </td>
                                    <td>
                                        <span class="tfont" t-esc="row.product_id.name"/>
                                    </td>
                                    <td class="text-right">
                                        <span class="tfont" t-esc="'{:.2f}'.format(row.product_qty)"/>
                                    </td>
                                    <t t-if="o.adj_type=='receipt'">
                                        <td class="text-left">
                                            <span class="tfont" t-esc="row.prod_lot_name"/>
                                        </td>
                                    </t>
                                    <t t-if="o.adj_type=='issue'">
                                        <td class="text-right">
                                            <span class="tfont" t-esc="row.prod_lot_id.name"/>
                                        </td>
                                    </t>
                                    <td class="text-left" t-if="'product_uom_id' in row._fields">
                                            <span class="tfont" t-esc="row.product_uom_id.name"/>
                                        </td>
                                    <td class="text-right">
                                        <span class="tfont" t-field="row.sales_rate"/>
                                    </td>
                                    <td class="text-right" t-if="'p_rate' in row._fields">
                                            <span class="tfont" t-field="row.p_rate"/>
                                        </td>
                                    <t t-if="o.adj_type=='receipt'">
                                        <td class="text-right" t-if="'sales_disc_r' in row._fields">
                                            <span class="tfont" t-esc="'{:.2f}'.format(row.sales_disc_r)"/>
                                        </td>
                                        <td class="text-right" t-if="'sales_disc_w' in row._fields">
                                            <span class="tfont" t-esc="'{:.2f}'.format(row.sales_disc_w)"/>
                                        </td>
                                    </t>
                                    <td class="text-right" t-if="'amount' in row._fields">
                                        <span class="tfont" t-field="row.amount"/>
                                    </td>
                                    <!--                            <td class="text-right"><span class="tfont" t-esc="row.liability"/></td>-->
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="'amount_total' in o._fields" style="float: right;">
                            <span class="bfont" style="padding-right: 30px;font-size:18px;">
                                <b>Amount Total:</b></span>
                            <span style="font-size:18px;" t-field="o.amount_total"/>
                        </div>

                    </div>


                </t>
            </t>
        </template>

    </data>
</odoo>