<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.actions.act_window" id="adjustments_damage_window">
            <field name="name">Damage Voucher</field>
            <field name="res_model">stock.inventory</field>
            <field name="view_mode">form,tree</field>
            <field name="search_view_id" ref="view_inventory_filter_custom"/>
            <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'tree','view_id':ref('adjustments_issue_tree')}),(0,0,{'view_mode':'form','view_id':ref('adjustments_issue_form_ttt')})]"></field>
            <field name="domain">[('adj_type','=','damage')]</field>
            <field name="context">{'default_adj_type':'damage','search_default_today':1}</field>
        </record>

         <menuitem name="Damage" id="adjustments_damage_menu" parent="stock_receipt_issue.adjustments_menu" action="adjustments_damage_window"/>

    </data>
</odoo>