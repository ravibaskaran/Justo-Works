<odoo>
    <data noupdate="1">
        <record id="sequence_adj_issue" model="ir.sequence">
            <field name="name">Sequence Order</field>
            <field name="code">adjustment.issue.sequence</field>
            <field name="number_next_actual">001</field>
            <field name="prefix">SI/%(fyear_range)s/</field>
             <field eval="True" name="use_date_range"/>
            <field name="padding">4</field>
        </record>

        <record id="sequence_adj_receipt" model="ir.sequence">
            <field name="name">Sequence Order</field>
            <field name="code">adjustment.receipt.sequence</field>
            <field name="number_next_actual">001</field>
            <field name="prefix">SR/%(fyear_range)s/</field>
             <field eval="True" name="use_date_range"/>
            <field name="padding">4</field>
        </record>

        <record id="sequence_adj_damage" model="ir.sequence">
            <field name="name">Sequence Order</field>
            <field name="code">adjustment.damage.sequence</field>
            <field name="number_next_actual">001</field>
            <field name="prefix">DA/%(fyear_range)s/</field>
             <field eval="True" name="use_date_range"/>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>