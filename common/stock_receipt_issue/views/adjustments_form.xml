<odoo>
    <data>

        <record model="ir.ui.view" id="adjustments_issue_form_ttt">
            <field name="name">ztock Adjustment Issue</field>
            <field name="model">stock.inventory</field>
            <field name="arch" type="xml">
                <form class="adjustments_form_cls">
                    <header>
                        <button name="action_post_inventory_custom" state="draft" attrs="{'invisible': [('state', '!=', 'draft')]}" string="Post" type="object" class="oe_highlight"/>
                        <!--                <button name="action_start" states="draft" string="Start Inventory" type="object" class="oe_highlight" groups="stock.group_stock_user"/>-->
                        <!--                <button name="action_open_inventory_lines" states="confirm" string="Continue Inventory" type="object" class="oe_highlight" groups="stock.group_stock_user"/>-->
                        <!--                <button name="action_validate" string="Validate Inventory" type="object" attrs="{'invisible': ['|', ('state', '!=', 'confirm'), ('line_ids', '!=', [])]}" groups="stock.group_stock_manager"/>-->
                        <!--                <button name="action_validate" string="Validate Inventory" type="object" attrs="{'invisible': ['|', ('state', '!=', 'confirm'), ('line_ids', '=', [])]}" class="oe_highlight" groups="stock.group_stock_manager"/>-->
                        <!--                <button name="action_cancel_draft" states="cancel" string="Set to Draft" type="object"/>-->
                        <!--                <button name="action_cancel_draft" states="confirm" string="Cancel Inventory" type="object"-->
                        <!-- confirm="If you cancel this inventory adjustment, all its inventory adjustment lines will be lost. Are you sure you want to discard it ?"/>-->
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>

                    <div class="oe_title">
                        <h1>
                            <field name="seq" readonly="1"/>
                        </h1>
                    </div>
                    <group style="width:50%">
                        <field name="remarks"/>
                    </group>
                    <group style="width:50%">
                        <field name="date" string="Date" readonly="0"/>
                        <field name="date_wo_time" invisible="1"/>
                        <field name="adj_type" invisible="1"/>
                        <field invisible="1" name="location_ids" options="{'no_create': True}" widget="many2many_tags" force_save="1" groups="stock.group_stock_multi_locations"/>
                        <field invisible="1" name="company_id" options="{'no_create': True}"/>
<!--                        <field name="branch_id" force_save="1" invisible="0"/>-->
                    </group>

                    <group>
                            <field name="line_ids"  widget="section_and_note_one2many" mode="tree" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sl_no" readonly="1" force_save="1" string="SNo"/>
                                    <field name="product_id"  widget="advance_search_many2one" adv_fields='{"barcode":["Barcode","l"],"qty_available":["Stock","r"],"uom_id":["Unit","l"],"standard_price":["Cost","r"],"list_price":["Price","r"]}' options="{'no_quick_create': True, 'no_create_edit' : True}"/>
                                    <field name="prod_qty" string="OnHand Quantity"  invisible="1" force_save="1"/>
                                    <field name="product_qty" string="Quantity" force_save="1"/>
                                    <field name="product_tracking" string="product_tracking" invisible="1"/>
<!--                                    <field name="prod_lot_name" invisible="1" required="0"/>-->
                                    <field name="prod_lot_id" attrs="{'readonly':[('product_tracking','=','none')],'required':[('product_tracking','!=','none')]}"
                                           groups="stock.group_production_lot" widget="advance_search_many2one" adv_fields='{"product_qty":["Stock","r"],"sales_rate":["S.Rate","r"],"p_rate":["P.Rate","r"]}'  string="Lot/Serial"
                                           options="{'no_quick_create': True, 'no_create_edit' : True}"/>
                                    <field name="product_uom_id" string="UOM" force_save="1" />
                                    <field name="sales_rate" groups="stock.group_production_lot" force_save="1" readonly="1"/>
                                    <field name="p_rate" string="P Rate" readonly="1" force_save="1"/>
                                    <field name="amount" groups="stock.group_production_lot" readonly="1" force_save="1"/>
                                    <!--                                <field name="expiry" placeholder="mm/yy"/>-->
                                    <!--                                <field name="p_price"/>-->
                                    <!--                                <field name="discount"/>-->
                                    <!--                                <field name="tax_id" widget="many2many_tags" force_save="1"/>-->
                                    <!--                                <field name="p_value"/>-->
                                    <!--                                <field name="s_value"/>-->
                                    <field name="company_id" invisible="1"/>
                                    <field name="location_id"  domain="[('usage','=','internal')]" force_save="1" invisible="1"/>

                                </tree>
                            </field>
                    </group>
                    <group colspan="4">
                        <group class="oe_total_footer oe_right">
                            <field name="amount_total" colspan="2"/>
                        </group>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                    <style>

                            .adv_search_autocomplete_dropdown.product_id .ui-menu-item &gt; a:nth-child(1)
                            {
                                width: 150px;
                            }

                            .adv_search_autocomplete_dropdown.prod_lot_id .ui-menu-item &gt; a:nth-child(1)
                            {
                                width: 100px;
                            }

                            .adv_search_autocomplete_dropdown.prod_lot_id .ui-menu-item &gt; a:nth-child(2)
                            {
                                width: 100px;
                            }

                            .adv_search_autocomplete_dropdown.prod_lot_id .ui-menu-item &gt; a:nth-child(3)
                            {
                                width: 100px;
                            }

                        </style>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="adjustments_issue_tree">
            <field name="name">Adjustments Issue</field>
            <field name="model">stock.inventory</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="seq"/>
                    <field name="date"/>
                    <field name="remarks"/>
                    <!--            <field name="include_discount"/>-->
                    <!--            <field name="adjustment_voucher"/>-->
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="adjustments_receipt_form">
            <field name="name">ztock Adjustment Receipt</field>
            <field name="model">stock.inventory</field>
            <field name="arch" type="xml">
                <form class="adjustments_form_cls">
                    <header>
                        <button name="action_post_inventory_custom" state="draft" string="Post" type="object" class="oe_highlight"/>
                        <!--                <button name="action_open_inventory_lines" states="confirm" string="Continue Inventory" type="object" class="oe_highlight" groups="stock.group_stock_user"/>-->
                        <!--                <button name="action_validate" string="Validate Inventory" type="object" attrs="{'invisible': ['|', ('state', '!=', 'confirm'), ('line_ids', '!=', [])]}" groups="stock.group_stock_manager"/>-->
                        <!--                <button name="action_validate" string="Validate Inventory" type="object" attrs="{'invisible': ['|', ('state', '!=', 'confirm'), ('line_ids', '=', [])]}" class="oe_highlight" groups="stock.group_stock_manager"/>-->
                        <!--                <button name="action_cancel_draft" states="cancel" string="Set to Draft" type="object"/>-->
                        <!--                <button name="action_cancel_draft" states="confirm" string="Cancel Inventory" type="object"-->
                        <!-- confirm="If you cancel this inventory adjustment, all its inventory adjustment lines will be lost. Are you sure you want to discard it ?"/>-->
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <div class="oe_title">
                        <h1>
                            <field name="seq" readonly="1"/>
                        </h1>
                    </div>
                    <group style="width:50%">
                        <field name="remarks"/>
                    </group>
                    <group style="width:50%">

                        <field name="date" string="Date" readonly="0"/>
                        <field name="adj_type" invisible="1"/>
                        <field name="date_wo_time" invisible="1"/>
                        <field invisible="1" name="location_ids" options="{'no_create': True}" widget="many2many_tags" force_save="1" />
                        <field invisible="1" name="company_id" options="{'no_create': True}"/>
<!--                        <field name="branch_id" force_save="1" invisible="0"/>-->
                    </group>

                    <group>
                            <field name="line_ids"  widget="section_and_note_one2many" mode="tree" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sl_no" readonly="1" force_save="1" string="SNo"/>
                                    <field name="product_id" widget="advance_search_many2one" adv_fields='{"barcode":["Barcode","l"],"qty_available":["Stock","r"],"uom_id":["Unit","l"],"standard_price":["Cost","r"],"list_price":["Price","r"]}'   options="{'no_quick_create': True, 'no_create_edit' : True}"/>
                                    <field name="prod_qty" string="Current Stock" force_save="1"/>
                                    <field name="product_qty" string="Quantity" force_save="1"/>
                                    <field name="product_tracking" string="product_tracking" invisible="1" />
                                    <field name="prod_lot_name" attrs="{'required':[('product_tracking','!=','none')]}" groups="stock.group_production_lot" string="Lot/Serial" force_save="1"/>
                                    <field name="expiry" groups="purchase_extension.group_expiry" force_save="1" required="1" />
                                    <field name="product_uom_id" string="UOM" force_save="1"/>
                                    <field name="sales_rate" groups="stock.group_production_lot" force_save="1" />
                                    <field name="p_rate" string="P Rate" force_save="1" />
                                    <field name="amount" groups="stock.group_production_lot" readonly="1" force_save="1"/>
                                    <!--                                <field name="expiry" placeholder="mm/yy"/>-->
                                    <!--                                <field name="p_price"/>-->
                                    <!--                                <field name="s_price"/>-->
                                    <!--                                <field name="discount"/>-->
                                    <!--                                <field name="tax_id" widget="many2many_tags" force_save="1"/>-->
                                    <!--                                <field name="p_value"/>-->
                                    <!--                                <field name="s_value"/>-->
                                    <field name="company_id" invisible="1"/>
                                    <field name="location_id" domain="[('usage','=','internal')]" force_save="1" invisible="1"/>

                                    <!--                                <field name="location_id" invisible="1"/>-->
                                </tree>
                            </field>
                    </group>
                    <group colspan="4">
                        <group class="oe_total_footer oe_right">
                            <field name="amount_total" colspan="2"/>
                        </group>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                     <style>

                            .adv_search_autocomplete_dropdown.product_id .ui-menu-item &gt; a:nth-child(1)
                            {
                                width: 150px;
                            }

                        </style>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="adjustments_receipt_tree">
            <field name="name">Adjustments Receipt</field>
            <field name="model">stock.inventory</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="seq"/>
                    <field name="date"/>
                    <field name="remarks"/>
                    <!--            <field name="opening_stock"/>-->
                    <!--            <field name="include_discount"/>-->
                    <!--            <field name="adjustment_voucher"/>-->
                </tree>
            </field>
        </record>

        <record id="view_inventory_filter_custom" model="ir.ui.view">
            <field name="name">stock.inventory.filter</field>
            <field name="model">stock.inventory</field>
            <field name="arch" type="xml">
                <search string="Search Inventory">
                    <field name="name" string="Reference"/>
                    <field name="product_ids" string="Product" filter_domain="['|', ('product_ids', 'ilike', self), ('line_ids.product_id','ilike',self)]"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <!--                <filter string="In Progress" name="confirm" domain="[('state', '=', 'confirm')]"/>-->
                    <filter string="Validated" name="done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),('date', '&lt;=',datetime.datetime.now().strftime('%Y-%m-%d 23:23:59'))]"/>
                    <filter string="Inventory Date" name="inventory_date" date="date"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Inventory Date" name="inventories_month" domain="[]" context="{'group_by': 'date'}" help="Physical Inventories by Date"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="adjustments_issue_window">
            <field name="name">Stock Issue Note</field>
            <field name="res_model">stock.inventory</field>
            <field name="view_mode">form,tree</field>
            <field name="search_view_id" ref="view_inventory_filter_custom"/>
            <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'tree','view_id':ref('adjustments_issue_tree')}),(0,0,{'view_mode':'form','view_id':ref('adjustments_issue_form_ttt')})]"></field>
            <field name="domain">[('adj_type','=','issue')]</field>
            <field name="context">{'default_adj_type':'issue','search_default_today':1}</field>
        </record>

        <record model="ir.actions.act_window" id="adjustments_receipt_window">
            <field name="name">Stock Receipt Note</field>
            <field name="res_model">stock.inventory</field>
            <field name="view_mode">form,tree</field>
            <field name="search_view_id" ref="view_inventory_filter_custom"/>

            <!--<field name="view_id" ref="adjustments_issue_form_ttt"/>-->
            <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'tree','view_id':ref('adjustments_receipt_tree')}),(0,0,{'view_mode':'form','view_id':ref('adjustments_receipt_form')})]"></field>
            <field name="domain">[('adj_type','=','receipt')]</field>
            <field name="context">{'default_adj_type':'receipt','search_default_today':1}</field>
        </record>

        <menuitem name="Inventory" id="adjustments_menu" sequence="0"  web_icon="stock_receipt_issue,static/description/icon.png" />

        <menuitem name="Stock Issue Note" id="adjustments_issue_menu" parent="stock_receipt_issue.adjustments_menu" action="adjustments_issue_window"/>

        <menuitem name="Stock Receipt Note" id="adjustments_receipt_menu" parent="stock_receipt_issue.adjustments_menu" action="adjustments_receipt_window"/>


    </data>
</odoo>