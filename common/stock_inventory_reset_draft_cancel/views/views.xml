<odoo>
    <data>
        <record id="adjustments_receipt_form_inherit" model="ir.ui.view">
            <field name="name">adjustments_receipt_form.inherit.template</field>
            <field name="model">stock.inventory</field>
            <field name="inherit_id" ref="stock_receipt_issue.adjustments_receipt_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_post_inventory_custom']" position="after">
                    <button name="action_reset_draft" groups="stock_inventory_reset_draft_cancel.receipt_issue_reset_draft_group" states="done" string="Reset to Draft" type="object" class="oe_highlight"/>
                </xpath>
            </field>
        </record>

        <record id="adjustments_issue_form_ttt_inherit" model="ir.ui.view">
            <field name="name">adjustments_issue_form_ttt.inherit.template</field>
            <field name="model">stock.inventory</field>
            <field name="inherit_id" ref="stock_receipt_issue.adjustments_issue_form_ttt"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_post_inventory_custom']" position="after">
                    <button name="action_reset_draft" groups="stock_inventory_reset_draft_cancel.receipt_issue_reset_draft_group" states="done" string="Reset to Draft" type="object" class="oe_highlight"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>