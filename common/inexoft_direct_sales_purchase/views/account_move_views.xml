<odoo>
    <data>

        <!-- ♦ ▼ Inherited 'Purchase Form View'. ▼ ♦ -->
        <record id="view_move_form_inherit_purchase" model="ir.ui.view">
            <field name="name">account.move.inherit.purchase</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="purchase.view_move_form_inherit_purchase"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='purchase_vendor_bill_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_post']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|',('state', '!=', 'draft'),('direct_move_type', '!=', False)]}
                    </attribute>
                </xpath>
                <xpath expr="//button[@name='action_post']" position="after">
                    <button name="action_post_custom" string="Post" class="oe_highlight" type="object"
                            groups="account.group_account_invoice"
                            attrs="{'invisible': ['|',('state', '!=', 'draft'),('direct_move_type', '=', False)]}"/>
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="direct_move_type" invisible="1"/>
                    <field name="direct_move_warehouse_id" groups="stock.group_stock_multi_warehouses" options="{'no_create':True}" invisible="1"/>
                    <field name="direct_move_picking_id" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="context">{'show_qty':True}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree" position="inside">
                    <field name="product_tracking" invisible="1"/>
                    <field name="direct_stock_move_id" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="domain">
                        [('purchase_ok','!=',context.get('purchase_ok')),('sale_ok','!=',context.get('sale_ok'))]
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="before">

                    <field name="lot_id" groups="stock_account.group_lot_on_invoice" attrs="{
                            'column_invisible':['|', ('parent.direct_move_type','=', False), ('parent.direct_move_type','=','incoming'), ('parent.move_type','=','in_invoice') ],
                            'readonly':[ ('product_tracking','=','none') ],
                            'required':[ ('product_tracking','in',['serial','lot']), '|',('parent.direct_move_type','=','outgoing'), '&amp;',('parent.direct_move_type','=','incoming'), ('parent.move_type','=','in_refund') ]}"
                            context="{'show_qty':True}"
                            domain="[('product_id','=', product_id),('direct_sellable_qty','>',0)]"
                            options="{'no_create':True, 'no_open':True}"
                    />

                    <field name="lot_name" groups="stock_account.group_lot_on_invoice" attrs="{
                        'column_invisible':['|',('parent.direct_move_type','=', False),'|', ('parent.direct_move_type','=','outgoing'),'&amp;',('parent.direct_move_type','=','incoming'), ('parent.move_type','=','in_refund')],
                        'readonly':[('product_tracking','=','none')],
                        'required':[('parent.move_type','=','in_invoice'),('parent.direct_move_type','=','incoming'),('product_tracking','in',['serial','lot'])]}"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='quantity']" position="before">
                    <field name="lot_id" invisible="1"/>
                    <field name="lot_name" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                    <attribute name="attrs">
                        {'readonly':[('parent.direct_move_type','!=',False),('product_tracking','=','serial')]}
                    </attribute>
                </xpath>
                <xpath expr="//label[@for='invoice_payment_term_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[@class='d-flex']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//notebook/page[2]" position="attributes">
                    <attribute name="attrs">{'invisible':[('direct_move_type','!=', False)]}</attribute>
                </xpath>
                <xpath expr="//notebook/page[3]" position="attributes">
                    <attribute name="groups">base.group_no_one</attribute>
                </xpath>
            </field>
        </record>

        <record id="action_direct_move_outgoing" model="ir.actions.act_window">
            <field name="name">Purchase</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'in_invoice'),('direct_move_type','=','incoming')]</field>
            <field name="context">{'default_move_type': 'in_invoice','default_direct_move_type' : 'incoming', 'purchase_ok':False}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a direct purchase entry
                </p>
                <p>
                    Create purchases, register payments and keep track of the discussions with your vendors.
                </p>
            </field>
        </record>

        <menuitem action="action_direct_move_outgoing" id="menu_direct_move_outgoing"
                parent="purchase.menu_procurement_management"
                sequence="0"/>

        <record id="action_direct_move_outgoing_return" model="ir.actions.act_window">
            <field name="name">Purchase Return</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'in_refund'),('direct_move_type', '=', 'incoming')]</field>
            <field name="context">{'default_move_type': 'in_refund', 'default_direct_move_type':'incoming'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a direct purchase return note
                </p>
                <p>
                    Note that the easiest way to create a direct purchase return it to do it directly from the vendor
                    bill.
                </p>
            </field>
        </record>

        <menuitem action="action_direct_move_outgoing_return" id="menu_direct_move_outgoing_return"
                parent="purchase.menu_procurement_management"
                sequence="0"/>

        <record id="action_direct_move_incoming" model="ir.actions.act_window">
            <field name="name">Sales</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'out_invoice'),('direct_move_type','=','outgoing')]</field>
            <field name="context">{'default_move_type': 'out_invoice','default_direct_move_type' : 'outgoing', 'sale_ok':False}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a direct sale entry
                </p>
                <p>
                    Create sales, register payments and keep track of the discussions with your customers.
                </p>
            </field>
        </record>

        <menuitem id="menu_direct_move_incoming" action="action_direct_move_incoming" parent="sale.sale_order_menu" sequence="1"/>

        <record id="action_direct_move_incoming_return" model="ir.actions.act_window">
            <field name="name">Sales Return</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'out_refund'),('direct_move_type', '=', 'outgoing')]</field>
            <field name="context">{'default_type': 'out_refund', 'default_direct_move_type':'outgoing'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a direct sales return
                </p>
                <p>
                    Note that the easiest way to create a direct sales return is to do it directly
                    from the customer invoice.
                </p>
            </field>
        </record>

        <menuitem id="menu_direct_move_incoming_return" action="action_direct_move_incoming_return" parent="sale.sale_order_menu" sequence="1"/>
    </data>
</odoo>