<odoo>
    <data>
        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='website']" position="attributes">
                    <attribute name="placeholder">e.g. https://www.google.com</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_users_form_simple_modif_debrand" model="ir.ui.view">
            <field name="name">view_users_form_simple_modif_debrand</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='odoobot_state']" position="attributes">
                    <attribute name="string">Bot Status</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_users_form_simple_modif_mail_inherit" model="ir.ui.view">
            <field name="name">view_users_form_simple_modif_mail_inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="mail.view_users_form_simple_modif_mail"/>
            <field name="arch" type="xml">

                <xpath expr="//widget[@name='notification_alert']" position="after">
                    <style>
                        .o_NotificationAlert{
                            display:none !important;
                        }
                    </style>
                </xpath>
            </field>
        </record>

        <record id="view_totp_form_de_brand" model="ir.ui.view">
            <field name="name">view_totp_form_de_brand</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="auth_totp.view_totp_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='security']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_totp_field_de_brand" model="ir.ui.view">
            <field name="name">view_totp_field_de_brand</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="auth_totp.view_totp_field"/>
            <field name="arch" type="xml">
                <xpath expr="//page[2]/group[2]" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>