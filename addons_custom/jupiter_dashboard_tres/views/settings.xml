<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="jupiter_dashboard_tres_config" model="ir.ui.view">
        <field name="name">jupiter_dashboard_tres_config</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[5]" position="after">
                <h2>Dashboard</h2>
                <div class="row mt16 o_settings_container" name="API Configurations">
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_dashboard_walk_in_api" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_dashboard_walk_in_api" string="Enable Dashboard Walk In API"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="dashboard_walk_in_api_url" string="Dashboard Walk In API Url"/>
                            <div class="mt8">
                                <field name="dashboard_walk_in_api_url" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="dashboard_walk_in_api_username" string="Dashboard Walk In API Username"/>
                            <div class="mt8">
                                <field name="dashboard_walk_in_api_username" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="dashboard_walk_in_api_key" string="Dashboard Walk In API Password"/>
                            <div class="mt8">
                                <field name="dashboard_walk_in_api_key" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt16 o_settings_container" name="API Configurations">
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_dashboard_new_cp_api" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_dashboard_new_cp_api" string="Enable Dashboard New CP API"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="dashboard_new_cp_api_url" string="Dashboard New CP API Url"/>
                            <div class="mt8">
                                <field name="dashboard_new_cp_api_url" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="dashboard_new_cp_api_username" string="Dashboard New CP API Username"/>
                            <div class="mt8">
                                <field name="dashboard_new_cp_api_username" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="dashboard_new_cp_api_key" string="Dashboard New CP API Password"/>
                            <div class="mt8">
                                <field name="dashboard_new_cp_api_key" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>