<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.cron" id="booking_wo_regstration_mail_cron">
            <field name="name">Booking Without Registration Mail To CRM</field>
            <field name="model_id" ref="model_unit_reservation"/>
            <field name="state">code</field>
            <field name="code">model.send_mail_to_crm()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
        <record id="booking_reset_alert_mail_template" model="mail.template">
            <field name="name">Booking Reset Alert</field>
            <field name="subject">Booking Reset Alert</field>
            <field name="email_from">{{object.get_from_mail()}}</field>
            <field name="partner_to">{{object.get_hr_partner_ids()}}</field>
            <field name="model_id" ref="itsys_real_estate.model_unit_reservation"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Greetings from Justo,
                        <br/>
                        This is to inform that booking "<strong t-out="object.name">Test Booking</strong>" of the project "<strong t-out="object.building.name">Test Project</strong>" is reset to draft by <strong t-out="object.env.user.name">User</strong>.
                        <br/>
                        With Regards
                    </p>
                </div>
            </field>
        </record>
        <record id="booking_wo_registration_mail_template" model="mail.template">
            <field name="name">Booking Without Registration Alert</field>
            <field name="subject">Booking Without Registration Alert</field>
            <field name="email_from">{{object.get_from_mail()}}</field>
            <field name="partner_to">{{object.get_crm_partner_id()}}</field>
            <field name="model_id" ref="itsys_real_estate.model_unit_reservation"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Greetings from Justo,
                        <br/>
                        This is to inform that booking "<strong t-out="object.name">Test Booking</strong>" is not registered.
                        <br/>
                        With Regards
                    </p>
                </div>
            </field>
        </record>

        <record id="email_template_installment_notification" model="mail.template">
            <field name="name">Real Estate installment - Send by Email</field>
            <field name="email_from">${(object.contract_user_id.email and '%s &lt;%s&gt;' % (object.contract_user_id.name, object.contract_user_id.email) or '')|safe}</field>
            <field name="subject">Hello </field>
            <field name="subject">${object.company_id.name} - Installment reminder</field>
            <field name="partner_to">${object.contract_partner_id.id}</field>
            <field name="model_id" ref="itsys_real_estate.model_loan_line_rs_own"/>
            <field name="auto_delete" eval="True"/>
            <field name="lang">${object.contract_partner_id.lang}</field>
            <field name="body_html"><![CDATA[
Dear ${object.contract_partner_id.name},

We would like to remind you with installment payment ${object.amount} due in ${object.date}

Regarding property # ${object.contract_building_unit.code}


Thanks and best regards,

${object.company_id.name}

]]></field>
        </record>

        <record id="email_template_installment_notification_rent" model="mail.template">
            <field name="name">Real Estate installment - Send by Email</field>
            <field name="email_from">${(object.contract_user_id.email and '%s &lt;%s&gt;' % (object.contract_user_id.name, object.contract_user_id.email) or '')|safe}</field>
            <field name="subject">Hello </field>
            <field name="subject">${object.company_id.name} - Installment reminder</field>
            <field name="partner_to">${object.contract_partner_id.id}</field>
            <field name="model_id" ref="itsys_real_estate.model_loan_line_rs_rent"/>
            <field name="auto_delete" eval="True"/>
            <field name="lang">${object.contract_partner_id.lang}</field>
            <field name="body_html"><![CDATA[
Dear ${object.contract_partner_id.name},

We would like to remind you with installment payment ${object.amount} due in ${object.date}

Regarding property # ${object.contract_building_unit.code}


Thanks and best regards,

${object.company_id.name}

]]></field>
        </record>
    </data>
</odoo>
