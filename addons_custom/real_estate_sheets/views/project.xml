<odoo>
    <record id="building_form_real_estate_sheets" model="ir.ui.view">
        <field name="name">building_form_real_estate_sheets</field>
        <field name="model">building</field>
        <field name="inherit_id" ref="itsys_real_estate.building_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reg_office_address']" position="after">
                <field name="term_sheet_id"/>
            </xpath>
        </field>
    </record>
    <record id="building_filter_real_estate_sheets" model="ir.ui.view">
        <field name="name">building_filter_real_estate_sheets</field>
        <field name="model">building</field>
        <field name="inherit_id" ref="itsys_real_estate.building_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="term_sheet_id"/>
            </xpath>
        </field>
    </record>
</odoo>