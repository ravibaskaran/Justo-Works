<odoo>
    <data noupdate="0">
        <record id="term_sheet_alert_mail_template" model="mail.template">
            <field name="name">Term Sheet Alert</field>
            <field name="subject">Term Sheet Alert</field>
            <field name="email_from">{{object.get_from_mail()}}</field>
            <field name="partner_to">{{object.get_hr_partner_ids()}}</field>
            <field name="model_id" ref="real_estate_sheets.model_term_sheet"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Greetings from Justo,
                        <br/>
                        This is to inform that term sheet of project "<strong t-out="object.name">Test Project</strong>" has been successfully created.
                        <br/>
                        With Regards
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>