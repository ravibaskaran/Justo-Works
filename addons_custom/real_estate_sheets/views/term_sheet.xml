<odoo>
    <record id="term_sheet_view_form" model="ir.ui.view">
        <field name="name">term_sheet_view_form</field>
        <field name="model">term.sheet</field>
        <field name="arch" type="xml">
            <form string="term_sheet_form">
                <header>
                    <button groups="real_estate_sheets.group_evaluation_budgeting_confirm"
                            string="Confirm" states="draft" class="oe_highlight"
                            name="action_confirm" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="form_editable" invisible="1"/>
                        <field name="developer_id" context="{'default_is_owner': True}" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        <span class="o_form_label o_td_label" name="address_name">
                            <b>Address</b>
                        </span>
                        <div class="o_address_format">
                            <field name="street" placeholder="Street..." class="o_address_street" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="street2" placeholder="Street 2..." class="o_address_street" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="city" placeholder="City" class="o_address_city" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="state_id" class="o_address_state" placeholder="State"
                                   options="{'no_open': True, 'no_quick_create': True}" attrs="{'readonly': [('form_editable', '=', False)]}"
                                   context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                            <field name="zip" placeholder="ZIP" class="o_address_zip" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="country_id" placeholder="Country" class="o_address_country" attrs="{'readonly': [('form_editable', '=', False)]}"
                                   options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                        </div>
                    </group>
                    <group>
                        <field name="evaluation_sheet_id" options="{'no_create': True, 'no_open': True,'no_quick_create':True,'no_create_edit':True}" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        <field name="promoter" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        <field name="name" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        <field name="site_address" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        <field name="average_price" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        <field name="date" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        <field name="signing_amount" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                    </group>
                    <group>
                        <group>
                            <field name="market_budgeting_percentage" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="tenure" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="extend" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="crm_fees_applicable" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="avg_rate_sq_ft" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="retainer_fee" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="duration" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                            <field name="template_id" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        </group>
                    </group>
                    <group class="mb-0">
                        <field name="template_head" invisible="1" class="term_sheet_template_area mb-0" nolabel="1" readonly="1" force_save="1"/>
                    </group>
                    <group class="mt-0">
                        <field name="template" class="term_sheet_template_area mt-0" nolabel="1" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                    </group>
                    <group>
                        <group>
                            <field name="director_justo" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="director_developer" attrs="{'readonly': [('form_editable', '=', False)]}"/>
                        </group>
                    </group>
                </sheet>
                <style>
                    .term_sheet_template_area table{
                        table-layout: auto !important;
                    }
                </style>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="term_sheet_view_tree" model="ir.ui.view">
        <field name="name">term_sheet_view_tree</field>
        <field name="model">term.sheet</field>
        <field name="arch" type="xml">
            <tree string="term_sheet_tree">
                <field name="developer_id"/>
                <field name="promoter"/>
                <field name="name"/>
                <field name="average_price"/>
                <field name="date"/>
                <field name="signing_amount"/>
            </tree>
        </field>
    </record>
    <record id="term_sheet_view_kanban" model="ir.ui.view">
        <field name="name">term.sheet.kanban</field>
        <field name="model">term.sheet</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" group_create="0" sample="1">
                <field name="developer_id"/>
                <field name="promoter"/>
                <field name="name"/>
                <field name="average_price"/>
                <field name="date"/>
                <field name="signing_amount"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row mb4">
                                <div class="col-6">
                                    <strong><span>Project: <field name="name"/></span></strong>
                                </div>
                                <div class="col-6 text-right">
                                    <i class="fa fa-clock-o" aria-label="Date" role="img" title="Date"/> <field name="date"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <span>Developer: <field name="developer_id"/></span>
                                </div>
                                <div class="col-6">
                                    <span>Promoter: <field name="promoter"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    Avg Amount: <field name="average_price"/>
                                </div>
                                <div class="col-6">
                                    Signing Amount: <field name="signing_amount"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="term_sheet_filter" model="ir.ui.view">
        <field name="name">term.sheet.search</field>
        <field name="model">term.sheet</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Top Search">
                <group>
                    <field name="developer_id"/>
                    <field name="promoter"/>
                    <field name="name"/>
                </group>
                <newline/>
                <group expand="0" string="Group By...">
                    <filter name="developer" string="Name of Developer" domain="[]"  context="{'group_by':'developer_id'}"/>
                    <filter name="promoter" string="Promoter" domain="[]"  context="{'group_by':'promoter'}"/>
                    <filter name="project_name" string="Project Name" domain="[]"  context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="term_sheet_action" model="ir.actions.act_window">
        <field name="name">Term Sheet</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">term.sheet</field>
        <field name="view_mode">tree,kanban,form,graph</field>
    </record>
</odoo>