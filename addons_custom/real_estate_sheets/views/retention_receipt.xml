<odoo>
    <record id="view_account_payment_tree_retention_receipt" model="ir.ui.view">
        <field name="name">view_account_payment_tree_retention_receipt</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_id"  invisible="context.get('default_is_retention') != True"/>
            </xpath>
        </field>
    </record>
    <record id="retention_receipt_voucher" model="ir.ui.view">
        <field name="name">retention.receipt.voucher</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="is_retention" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="project_id" attrs="{'invisible': [('is_retention', '!=', True)]}"/>
            </xpath>
            <xpath expr="//field[@name='is_internal_transfer']" position="attributes">
                <attribute name="attrs">{'readonly': [('state','!=','draft')], 'invisible':
                    [('is_retention','=',True)]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="attrs">{'readonly': [('state','!=','draft')], 'invisible':
                    [('is_retention','=',True)]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="attrs"/>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="attrs"/>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][3]" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="attrs"/>
            </xpath>
            <xpath expr="//field[@name='partner_id'][2]" position="attributes">
                <attribute name="string">Partner</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <div class="o_td_label">
                    <label for="partner_id" string="Developer" attrs="{'invisible': [('is_retention', '!=', True)]}"/>
                    <label for="partner_id" string="Partner" attrs="{'invisible': ['|', '|', ('is_retention', '=', True), ('partner_type','!=','customer'), ('is_internal_transfer', '=', True)]}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{'default_is_company': True, 'res_partner_search_mode':
                    (context.get('default_is_retention', False) and 'developer')}
                </attribute>
                <attribute name="nolabel">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][2]" position="attributes">
                <attribute name="context">{'default_is_company': True, 'res_partner_search_mode':
                    (context.get('default_is_retention', False) and 'developer'), 'default_is_owner': True}
                </attribute>
            </xpath>
        </field>
    </record>
    <record id="action_retention_receipt_voucher" model="ir.actions.act_window">
        <field name="name">Retention Receipt Voucher</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,kanban,form,graph</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'res_partner_search_mode': 'developer',
            'default_is_retention': True
            }
        </field>
        <field name="view_id" ref="account.view_account_payment_tree"/>
        <field name="domain">[('is_retention','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a Retention Receipt Voucher
            </p>
        </field>
    </record>
</odoo>