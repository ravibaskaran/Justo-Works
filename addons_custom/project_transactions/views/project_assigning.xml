<odoo>
    <record id="project_assigning_view_form" model="ir.ui.view">
        <field name="name">project_assigning_view_form</field>
        <field name="model">project.assigning</field>
        <field name="arch" type="xml">
            <form string="project_assigning_form">
                <sheet>
                    <group>
                        <field name="project_id" required="1"/>
                    </group>
                    <group invisible="1">
                        <group>
                            <field name="business_head"/>
                            <field name="site_head"/>
                            <field name="source_head"/>
                        </group>
                        <group>
                            <field name="closing_head"/>
                            <field name="channel_partner" context="{'default_is_channel': True}"/>
                            <field name="closing_manager"/>
                        </group>
                    </group>
                    <div class="text-right"><strong class="pr-4">Select All <field name="select_all"/></strong></div>
                    <field name="assigning_flat_ids">
                        <tree editable="bottom" create="0" edit="0" delete="0">
                            <field name="flat_id" readonly="1" force_save="1" style="width: 80%;"/>
                            <field name="activate"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                <style>
                    th[data-name='flat_id']{
                        width: 90% !important;
                    }
                </style>
            </form>
        </field>
    </record>
    <record id="project_assigning_view_tree" model="ir.ui.view">
        <field name="name">project_assigning_view_tree</field>
        <field name="model">project.assigning</field>
        <field name="arch" type="xml">
            <tree string="project_assigning_tree">
                <field name="project_id"/>
                <field name="business_head"/>
                <field name="site_head"/>
                <field name="source_head"/>
                <field name="closing_head"/>
                <field name="channel_partner"/>
                <field name="closing_manager"/>
            </tree>
        </field>
    </record>
    <record id="project_assigning_view_kanban" model="ir.ui.view">
        <field name="name">project_assigning_view_kanban</field>
        <field name="model">project.assigning</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" group_create="0" sample="1">
                <field name="project_id"/>
                <field name="business_head"/>
                <field name="site_head"/>
                <field name="source_head"/>
                <field name="closing_head"/>
                <field name="channel_partner"/>
                <field name="closing_manager"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row mb4">
                                <div class="col-12">
                                    <strong><span>Project: <field name="project_id"/></span></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <span><strong>Business Head:</strong><br/> <field name="business_head"/></span>
                                </div>
                                <div class="col-6">
                                    <span><strong>Site Head:</strong><br/> <field name="site_head"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <strong>Source Head:</strong><br/> <field name="source_head"/>
                                </div>
                                <div class="col-6">
                                    <strong>Closing Head:</strong><br/> <field name="closing_head"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <strong>Channel Partner:</strong><br/> <field name="channel_partner"/>
                                </div>
                                <div class="col-6">
                                    <strong>Closing Manager:</strong><br/> <field name="closing_manager"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="project_assigning_action" model="ir.actions.act_window">
        <field name="name">Project Assigning</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.assigning</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
</odoo>