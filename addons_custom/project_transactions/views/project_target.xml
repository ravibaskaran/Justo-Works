<odoo>
    <record id="project_target_view_form" model="ir.ui.view">
        <field name="name">project_target_view_form</field>
        <field name="model">project.target</field>
        <field name="arch" type="xml">
            <form string="project_target_form">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" required="1"/>
                        </group>
                        <group>
                            <field name="financial_year" widget="selection" context="{'financial_year': True}" required="1"/>
                        </group>
                    </group>
                    <field name="target_line_ids">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="month" readonly="1" force_save="1"/>
                            <field name="registration"/>
                            <field name="inventory"/>
                            <field name="registration_amount"/>
                            <field name="amount"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="project_target_view_tree" model="ir.ui.view">
        <field name="name">project_target_view_tree</field>
        <field name="model">project.target</field>
        <field name="arch" type="xml">
            <tree string="project_target_tree">
                <field name="project_id"/>
                <field name="financial_year"/>
            </tree>
        </field>
    </record>
    <record id="project_target_action" model="ir.actions.act_window">
        <field name="name">Project Target</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.target</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>