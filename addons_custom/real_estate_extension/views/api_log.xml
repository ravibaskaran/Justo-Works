<odoo>
    <record id="api_log_view_form" model="ir.ui.view">
        <field name="name">api_log_view_form</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <form string="api_log_form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive" invisible="1">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                        </button>
                    </div>
                    <group>
                        <group string="API Information">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="type"/>
                            <field name="direction"/>
                            <field name="status"/>
                            <field name="record"/>
                        </group>
                        <group string="Audit Information">
                            <field name="date"/>
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                            <field name="execution_time"/>
                        </group>
                    </group>
                    <group string="Security Flags">
                        <group>
                            <field name="sanitized"/>
                            <field name="is_sensitive"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Data">
                            <field name="request_payload" widget="text"/>
                        </page>
                        <page string="Response Data">
                            <field name="response_payload" widget="text"/>
                        </page>
                        <page string="Legacy Data" groups="base.group_no_one">
                            <group>
                                <field name="args" widget="text"/>
                                <field name="response" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="api_log_view_tree" model="ir.ui.view">
        <field name="name">api_log_view_tree</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <tree string="api_log_tree">
                <field name="date"/>
                <field name="name"/>
                <field name="type"/>
                <field name="status" widget="badge" decoration-success="status =='success'" decoration-danger="status == 'failed'"/>
                <field name="direction" widget="badge" decoration-info="direction == 'out'" decoration-success="direction == 'in'"/>
                <field name="ip_address"/>
                <field name="execution_time" string="Exec Time (ms)"/>
                <field name="is_sensitive" widget="boolean_toggle"/>
                <field name="sanitized" widget="boolean_toggle"/>
                <field name="code" optional="hide"/>
                <field name="record" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="api_log_action" model="ir.actions.act_window">
        <field name="name">API Log</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">api.log</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="api_menu" name="API" parent="base.menu_administration" sequence="210"/>
    <menuitem id="api_log_menu" name="API Log" parent="api_menu" action="api_log_action" sequence="10"/>
</odoo>