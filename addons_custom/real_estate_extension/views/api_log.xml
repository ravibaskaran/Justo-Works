<odoo>
    <record id="api_log_view_form" model="ir.ui.view">
        <field name="name">api_log_view_form</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <form string="api_log_form">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="response"/>
                            <field name="args"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="status"/>
                            <field name="type"/>
                            <field name="record"/>
                            <field name="direction"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="api_log_view_tree" model="ir.ui.view">
        <field name="name">api_log_view_tree</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <tree string="api_log_tree">
                <field name="name"/>
                <field name="code"/>
                <field name="date"/>
                <field name="record"/>
                <field name="type"/>
                <field name="status" widget="badge" decoration-success="status =='success'" decoration-danger="status == 'failed'"/>
                <field name="direction" widget="badge" decoration-info="direction == 'out'" decoration-success="direction == 'in'"/>
            </tree>
        </field>
    </record>
    <record id="api_log_action" model="ir.actions.act_window">
        <field name="name">API Log</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">api.log</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="api_menu" name="API" parent="base.menu_administration" sequence="210"/>
    <menuitem id="api_log_menu" name="API Log" parent="api_menu" action="api_log_action" sequence="10"/>
</odoo>