                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="booking_cancel_api_url" string="Booking Cancel API Url"/>
                            <div class="mt8">
                                <field name="booking_cancel_api_url" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="booking_cancel_api_username" string="Booking Cancel API Username"/>
                            <div class="mt8">
                                <field name="booking_cancel_api_username" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="booking_cancel_api_key" string="Booking Cancel API Password"/>
                            <div class="mt8">
                                <field name="booking_cancel_api_key" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>