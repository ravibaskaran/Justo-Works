<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_transactions_account_config" model="ir.ui.view">
        <field name="name">project_transactions_account_config</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[5]" position="after">
                <h2>API</h2>
                <div class="row mt16 o_settings_container" name="API Configurations">
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_employee_out_api" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_employee_out_api" string="Enable Employee Out API"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="employee_api_url" string="Employee API Url"/>
                            <div class="mt8">
                                <field name="employee_api_url" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="employee_api_username" string="Employee API Username"/>
                            <div class="mt8">
                                <field name="employee_api_username" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="employee_api_key" string="Employee API Password"/>
                            <div class="mt8">
                                <field name="employee_api_key" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_project_out_api" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_project_out_api" string="Enable Project Out API"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="project_api_url" string="Project API Url"/>
                            <div class="mt8">
                                <field name="project_api_url" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="project_api_username" string="Project API Username"/>
                            <div class="mt8">
                                <field name="project_api_username" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="project_api_key" string="Project API Password"/>
                            <div class="mt8">
                                <field name="project_api_key" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_project_employee_assign_api" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_project_employee_assign_api" string="Enable Project Employee Assign API"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="project_employee_assign_api_url" string="Project Employee Assign API Url"/>
                            <div class="mt8">
                                <field name="project_employee_assign_api_url" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="project_employee_assign_api_username" string="Project Employee Assign API Username"/>
                            <div class="mt8">
                                <field name="project_employee_assign_api_username" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="project_employee_assign_api_key" string="Project Employee Assign API Password"/>
                            <div class="mt8">
                                <field name="project_employee_assign_api_key" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_booking_cancel_api" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_booking_cancel_api" string="Enable Booking Cancel API"/>
