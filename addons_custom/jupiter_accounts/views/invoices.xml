<odoo>
    <record id="spot_booking_invoice_action" model="ir.actions.act_window">
        <field name="name">Spot Booking Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('project_invoice_type', '=', 'spot_booking'), ('is_project_invoice', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'default_project_invoice_type': 'spot_booking', 'default_is_project_invoice': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a Spot Booking Invoice
          </p>
        </field>
    </record>
