<odoo>
    <record id="project_configurations_view_form" model="ir.ui.view">
        <field name="name">project_configurations_view_form</field>
        <field name="model">project.configurations</field>
        <field name="arch" type="xml">
            <form string="project_configurations_form">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="spot_booking_product" context="{'default_detailed_type': 'service'}"/>
                            <field name="cp_brokerage_product" context="{'default_detailed_type': 'service'}"/>
                        </group>
                        <group>
                            <field name="activate"/>
                            <field name="incentive_product" context="{'default_detailed_type': 'service'}"/>
                            <field name="developer_invoice_product" context="{'default_detailed_type': 'service'}"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="monthly_minimum_booking"/>
                        </group>
                        <group>
                            <field name="incentive_interval"/>
                        </group>
                    </group>
                    <separator string="Minimum Advance Configurations" colspan="4"/>
                    <field name="minimum_advance_ids">
                        <tree editable="bottom">
                            <field name="amount_from"/>
                            <field name="amount_to"/>
                            <field name="advance_amount"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="project_configurations_action" model="ir.actions.act_window">
        <field name="name">Project Configurations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.configurations</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>