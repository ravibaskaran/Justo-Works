<odoo>
    <template id="pdf_payment_form">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    .your-table-class {
                    width: 100%;
                    border-collapse: collapse;
                    }
                    .your-table-class th, .your-table-class td {
                    padding: 8px;
                    border: 1px solid #ddd;
                    text-align: left;
                    }
                    .your-table-class th {
                    background-color: #f2f2f2;
                    }
                    .your-table-class tr:nth-child(even) {
                    background-color: #f9f9f9;
                    }
                    .bordered {
                    border: 1px solid #000;
                    padding: 10px;
                    }
                </style>
                <div class="bordered">
                    <table width="100%" style="margin-top: 12px;text-align:center"
                           class="table table-borderless">
                        <tr>
                            <td class="text-center">
                                <h2 style="margin:0;color:#1155cc;">
                                    <t t-esc="data['company_name']"/>
                                </h2>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <p style="margin-bottom:0;">
                                    <span t-esc="data['company_address']"/>,
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <p style="margin-bottom:0;">
                                    <span t-if="data['company_phone']" style="padding-right:15px">Phone :
                                        <span t-esc="data['company_phone']"/>
                                    </span>
                                    <span t-if="data['company_email']">
                                        Email :
                                        <span t-esc="data['company_email']"/>
                                    </span>
                                </p>
                            </td>
                        </tr>
                    </table>
                    <hr/>
                    <div class="oe_structure"/>
                    <t t-if="data['payment_type'] == 'inbound'">
                        <h4 style="text-align: center;">
                            Receipt Voucher
                        </h4>
                    </t>
                    <t t-else="">
                        <h4 style="text-align: center;">
                            Payment Voucher
                        </h4>
                    </t>
                    <div>
                        <table class="table table-borderless" style="width:100%;">
                            <tr>
                                <td>
                                    <t t-if="data['payment_type'] == 'inbound'">
                                        <label>Received By:</label>
                                    </t>
                                    <t t-else="">
                                        <label>Paid To:</label>
                                    </t>
                                    <t t-esc="data['partner']"/>
                                </td>
                                <td style="text-align: right;">
                                    <label>Date:</label>
                                    <t t-esc="data['date']"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:50%;">
                                    <label>Journal:</label>
                                    <t t-esc="data['journal']"/>
                                </td>
                                <td style="width:50%; text-align: right;">
                                    <label>Vr.No:</label>
                                    <t t-esc="data['voucher_number']"/>
                                </td>
                            </tr>
                        </table>
                        <hr/>
                        <table class="table table-borderless" style="width:100%;">
                            <tr>
                                <td>
                                    <label>Amount<br/>(in words):</label>
                                    <span style="color: #000000; font-size: 22px; font-weight: bold;" t-esc="data['total_in_words']"/><span style="color: #000000; font-size: 22px; font-weight: bold;"> Only</span>
                                </td>
                                <td style="text-align: right;">
                                    <label>Amount:</label>
                                    <span style="color: #030303; font-size: 21px;" t-esc="data['currency']"/><span style="color: #030303; font-size: 21px; font-weight: bold;" t-esc="data['amount']" t-options="{'widget': 'float', 'precision': 2, 'currency_field': 'currency_id'}"/>
                                </td>
                            </tr>
                        </table>
                        <strong>
                            <t t-if="data['payment_type'] == 'inbound'">
                                Invoice Wise Settlement:
                            </t>
                            <t t-else="">
                                Bill Wise Settlement:
                            </t>
                        </strong>
                        <table class="your-table-class" style="width:100%;">
                            <tr>
                                <t t-if="data['payment_type'] == 'inbound'">
                                    <td style="width:15%; text-align: center;">Invoice Date</td>
                                </t>
                                <t t-else="">
                                    <td style="width:15%; text-align: center;">Bill Date</td>
                                </t>
                                <td style="width:14%; text-align: center;">
                                    Number
                                </td>
                                <t t-if="data['payment_type'] == 'inbound'">
                                    <td style="width:14%; text-align: center;">Invoice Amount</td>
                                </t>
                                <t t-else="">
                                    <td style="width:14%; text-align: center;">Bill Amount</td>
                                </t>
                                <td style="width:14%; text-align: center;">
                                    Amount Due
                                </td>
                                <td style="width:14%; text-align: center;">
                                    Settled Amount
                                </td>
                                <td style="width:14%; text-align: center;">
                                    Balance
                                </td>
                                <td style="width:14%; text-align: center;">
                                    Remarks
                                </td>
                            </tr>
                            <t t-set="total_amount" t-value="0"/>
                            <t t-set="total_amount_residual" t-value="0"/>
                            <t t-set="total_settled_amount" t-value="0"/>
                            <t t-set="total_invoice_balance" t-value="0"/>
                            <t t-foreach="data['slips']" t-as="slip">
                                <tr>
                                    <td style="text-align: center;">
                                        <t t-esc="slip['invoice_date']"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <t t-esc="slip['number']"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-esc="slip['bill_value']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-esc="slip['amount_residual']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-esc="slip['settled_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-esc="slip['invoice_balance']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <t t-if="slip['remarks'] == 'full_paid'">
                                            Full Paid
                                        </t>
                                        <t t-elif="slip['remarks'] == 'partial_paid'">
                                            Partially Paid
                                        </t>
                                        <t t-else="">
                                            Not Paid
                                        </t>
                                    </td>
                                </tr>
                                <t t-set="total_amount" t-value="total_amount + slip['bill_value']"/>
                                <t t-set="total_amount_residual" t-value="total_amount_residual + slip['amount_residual']"/>
                                <t t-set="total_settled_amount" t-value="total_settled_amount + slip['settled_amount']"/>
                                <t t-set="total_invoice_balance" t-value="total_invoice_balance + slip['invoice_balance']"/>
                            </t>
                            <tr>
                                <td colspan="2" style="text-align: center">
                                    <strong>Total</strong>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="data['currency']"/>
                                    <t t-esc="total_amount" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="data['currency']"/>
                                    <t t-esc="total_amount_residual" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="data['currency']"/>
                                    <t t-esc="total_settled_amount" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="data['currency']"/>
                                    <t t-esc="total_invoice_balance" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td></td>
                            </tr>
                        </table>
                        <table class="table table-borderless" style="width:100%;">
                            <tr style="text-align:center;">
                                <td style="width:33.33%;"><br/><br/><br/>------------------<br/>Prepared By</td>
                                <td style="width:33.33%;"><br/><br/><br/>------------------<br/>Authorized By</td>
                                <td style="width:33.33%;"><br/><br/><br/>------------------<br/>Signature</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>