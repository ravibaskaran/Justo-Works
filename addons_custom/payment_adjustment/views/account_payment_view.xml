<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="account_payment_inherited_view">
            <field name="name">account.payment.view.form.inherited</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
<!--                <xpath expr="//field[@name='state']" position="attributes">-->
<!--                    <attribute name="widget">statusbar</attribute>-->
<!--                    <attribute name="statusbar_visible">draft,posted,cancelled</attribute>-->
<!--                    <attribute name="tracking">True</attribute>-->
<!--                </xpath>-->
                <xpath position="inside" expr="//sheet">
                    <field name="is_reconciled_payment" invisible="1"/>
                    <notebook invisible="context.get('active_model') == 'account.move'">
                        <page string="Invoice/Bill">
                            <field name="payment_invoice_ids" widget="one2many_list" options="{'no_create': True}" attrs="{'readonly': [('state', '=', 'posted')]}">
                                <tree editable="bottom">
                                    <field name="invoice_date" widget="date"/>
                                    <field name="invoice_number_id" invisible="1"/>
                                    <field name="invoice_number" />
                                    <field name="amount_total_in_currency_signed" sum="Total Invoice/Bill Amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_residual" sum="Total Amount Residual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="settled_amount" sum="Total Settled Amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_balance" invisible="1"/>
                                    <field name="invoice_balance" sum="Total Invoice Balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="payment_amount" invisible="1"/>
                                    <field name="remarks"/>
                                    <field name="payment_invoice_checkbox"/>
                                    <field name="is_account_opening" invisible="1"/>
                                    <field name="opening_move_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <field name="sub_amount" invisible="1"/>
                </xpath>
                <xpath position="before" expr="//button[@name='action_draft']">
                    <field name="hide_reconcile_button" invisible="1"/>
<!--                    <field name="state" invisible="1"/>-->
                    <field name="draft_boolean" invisible="1"/>
                    <button name="create_payments_for_invoices" string="Reconcile" class="oe_highlight" type="object"
                            attrs="{'invisible': ['|',('state', 'not in', ['posted']),('hide_reconcile_button', 'in', True)]}"/>
<!--                    <button name="print_payment_voucher" string="Print" class="oe_highlight" type="object"-->
<!--                            attrs="{'invisible': ['|',('state', 'not in', ['posted']),('hide_reconcile_button', 'not in', True)]}"/>-->
                </xpath>
                <xpath expr="//button[@name='action_draft']" position="replace">
                    <button name="custom_reset_draft" string="Reset To Draft" class="" type="object"
                            attrs="{'invisible': ['|',('state', 'not in', ['posted']),('hide_reconcile_button', 'not in', True)]}"/>
                    </xpath>
            </field>
        </record>
    </data>
</odoo>
