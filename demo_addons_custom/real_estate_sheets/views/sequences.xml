<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="sequence_evaluation_sheet" model="ir.sequence">
            <field name="name">Project Evaluation Sheet</field>
            <field name="code">project.evaluation.sheet</field>
            <field name="prefix">PES/%(range_year)s/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="use_date_range"/>
            <field eval="False" name="company_id"/>
            <field name="padding">4</field>
        </record> 
        <record id="sequence_budget_sheet" model="ir.sequence">
            <field name="name">Project Budget Sheet</field>
            <field name="code">project.budget.sheet</field>
            <field name="prefix">B/%(range_year)s/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="use_date_range"/>
            <field eval="False" name="company_id"/>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
