<odoo>
    <record id="competition_sheet_import_view_form" model="ir.ui.view">
        <field name="name">competition_sheet_import_view_form</field>
        <field name="model">competition.sheet.import</field>
        <field name="arch" type="xml">
            <form string="competition_sheet_import_form">
                <sheet>
                    <group>
                        <field name="file" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary" data-hotkey="i"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>