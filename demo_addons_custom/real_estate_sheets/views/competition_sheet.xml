<odoo>
    <record id="competition_sheet_view_form" model="ir.ui.view">
        <field name="name">competition_sheet_view_form</field>
        <field name="model">competition.sheet</field>
        <field name="arch" type="xml">
            <form string="competition_sheet_form">
                <sheet>
                    <group class="mb-0">
                        <field name="name"/>
                        <field name="developer_id" context="{'default_is_owner': True}"/>
                        <field name="configuration"/>
                        <field name="carpet_area"/>
                        <field name="saleable_area"/>
                        <field name="quoted_agreement_value"/>
                        <field name="discount"/>
                        <field name="all_in_package"/>
                        <field name="location"/>
                        <field name="transacted_av"/>
                    </group>
                    <group>
                        <group>
                            <field name="transacted_rate_sale_area"/>
                        </group>
                        <group>
                            <field name="transacted_rate_carpet_area"/>
                        </group>
                    </group>
                    <group class="mt-0">
                        <field name="approx_after_discount"/>
                        <field name="possession_date"/>
                        <field name="evaluation_sheet_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                <style>
                    .o_form_view .o_group.o_inner_group > tbody > tr > td.o_td_label{
                        min-width: 260px !important;
                    }
                </style>
            </form>
        </field>
    </record>
    <record id="competition_sheet_view_tree" model="ir.ui.view">
        <field name="name">competition_sheet_view_tree</field>
        <field name="model">competition.sheet</field>
        <field name="arch" type="xml">
            <tree string="competition_sheet_tree">
                <field name="name"/>
                <field name="developer_id"/>
                <field name="configuration"/>
                <field name="possession_date"/>
            </tree>
        </field>
    </record>
    <record id="competition_sheet_view_kanban" model="ir.ui.view">
        <field name="name">competition.sheet.kanban</field>
        <field name="model">competition.sheet</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" group_create="0" sample="1">
                <field name="name"/>
                <field name="developer_id"/>
                <field name="configuration"/>
                <field name="possession_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row mb4">
                                <div class="col-6">
                                    <strong><span>Project: <field name="name"/></span></strong>
                                </div>
                                <div class="col-6 text-right">
                                    <i class="fa fa-clock-o" aria-label="Date" role="img" title="Date"/> <field name="possession_date"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span>Developer: <field name="developer_id"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    Configuration: <field name="configuration"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="competition_sheet_filter" model="ir.ui.view">
        <field name="name">competition.sheet.search</field>
        <field name="model">competition.sheet</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Top Search">
                <group>
                    <field name="name"/>
                    <field name="developer_id"/>
                </group>
                <newline/>
                <group expand="0" string="Group By...">
                    <filter name="project_name" string="Name of Project" domain="[]"  context="{'group_by':'name'}"/>
                    <filter name="developer" string="Name of Developer" domain="[]"  context="{'group_by':'developer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="competition_sheet_action" model="ir.actions.act_window">
        <field name="name">Competition Sheet</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">competition.sheet</field>
        <field name="view_mode">tree,kanban,form,graph</field>
    </record>
</odoo>