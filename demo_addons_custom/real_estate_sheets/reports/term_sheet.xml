		<template id="report_term_sheet">
			<t t-call="web.html_container">
				<t t-foreach="docs" t-as="o">
					<t t-call="real_estate_sheets.report_term_sheet_document"/>
				</t>
			</t>
		</template>
        <record id="term_sheet_paper_format" model="report.paperformat">
            <field name="name">Reservation</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">95</field>
        </record>

        <record id="report_term_sheet_action" model="ir.actions.report">
            <field name="name">Term Sheet</field>
            <field name="model">term.sheet</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">real_estate_sheets.report_term_sheet</field>
            <field name="report_file">real_estate_sheets.report_term_sheet</field>
            <field name="binding_model_id" ref="model_term_sheet"/>
            <field name="paperformat_id" ref="term_sheet_paper_format"/>
        </record>
	</data>
</odoo>
