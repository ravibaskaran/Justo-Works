<odoo>
    <record id="view_account_payment_form_inherited_2" model="ir.ui.view">
        <field name="name">view_account_payment_form_inherited_2</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_check_printing.view_account_payment_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_number']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '|', ('payment_method_code', 'not in',
                    ['check_printing','pdc']), ('check_number', '=', 0), ('check_number', 'in', (False, None))]}
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>