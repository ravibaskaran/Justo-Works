<odoo>
    <record id="purchase_modification_real_estate_extension" model="ir.ui.view">
        <field name="name">purchase_modification_real_estate_extension</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="purchase_extension.purchase_modification"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_vendor', '=', True)]</attribute>
                <attribute name="context">{'default_supplier_rank': 1, 'default_is_vendor': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="payment.action_invoice_order_generate_link" model="ir.actions.act_window">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="account.action_move_switch_invoice_to_credit_note" model="ir.actions.server">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
</odoo>