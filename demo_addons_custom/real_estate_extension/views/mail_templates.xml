<odoo>
    <data noupdate="0">
        <record id="project_creation_alert_mail_template" model="mail.template">
            <field name="name">Project Creation HR Alert</field>
            <field name="subject">Project Creation Alert</field>
            <field name="email_from">{{object.get_from_mail()}}</field>
            <field name="partner_to">{{object.get_hr_partner_ids()}}</field>
            <field name="model_id" ref="itsys_real_estate.model_building"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Greetings from Justo,
                        <br/>
                        This is to inform that project "<strong t-out="object.name">Test Project</strong>" has been successfully created. Please allocate the employees.
                        <br/>
                        With Regards
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>