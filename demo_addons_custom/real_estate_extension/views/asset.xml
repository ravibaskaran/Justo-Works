<odoo>
    <record id="view_account_asset_asset_form_real_estate_extension" model="ir.ui.view">
        <field name="name">view_account_asset_asset_form_real_estate_extension</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.view_account_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="manufacture"/>
                <field name="holder"/>
                <field name="purpose"/>
                <field name="ser_number"/>
            </xpath>
        </field>
    </record>
</odoo>