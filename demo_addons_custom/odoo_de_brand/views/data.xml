<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <function model="res.users"
                  name="remove_odoo_from_action_help"/>

        <record id="base.partner_root" model="res.partner">
            <field name="name">InexoftBot</field>
            <field name="email">bot@inexoft.com</field>
            <field name="image_1920" type="base64" file="odoo_de_brand/static/src/img/ibot.png"/>
        </record>

        <record model="mail.message" id="mail.module_install_notification">
            <field name="model">mail.channel</field>
            <field name="res_id" ref="mail.channel_all_employees"/>
            <field name="message_type">email</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="subject">Welcome to Inexoft!</field>
            <field name="body"><![CDATA[<p>Welcome to the #general channel.</p>
            <p>This channel is accessible to all users to <b>easily share company information</b>.</p>]]></field>
        </record>
    </data>
</odoo>