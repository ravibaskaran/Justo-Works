<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_transactions_account_config" model="ir.ui.view">
        <field name="name">project_transactions_account_config</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[5]" position="after">
                <h2>Incentive Service</h2>
                <div class="row mt16 o_settings_container" name="incentive_product_id">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="incentive_product_id" string="Incentive Service"/>
                            <div class="mt8">
                                <field name="incentive_product_id" class="o_light_label"
                                       context="{'default_detailed_type': 'service'}"
                                       domain="[('detailed_type', '=', 'service')]"
                                       force_save="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>