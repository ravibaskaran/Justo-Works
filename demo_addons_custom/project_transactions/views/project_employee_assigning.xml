                    }
                </style>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="project_employee_assigning_view_tree" model="ir.ui.view">
        <field name="name">project_employee_assigning_view_tree</field>
