<odoo>
    <data>
        <record id="building_create_inventory_view_form" model="ir.ui.view">
            <field name="name">building_create_inventory_view_form</field>
            <field name="model">building.create.inventory</field>
            <field name="arch" type="xml">
                <form string="building_create_inventory_form">
                    <sheet>
                        <group>
                            <group>
                                <field name="file"/>
                                <field name="project_id" invisible="1"/>
                            </group>
                            <group>
                                <button type="object"
                                        class="btn-white fa fa-download sample-dw-btn"
                                        string=" Download a Sample File"
                                        name="action_download_sample"/>
                            </group>
                        </group>
                        <style>
                            .sample-dw-btn:before{
                            color: #004589;
                            }
                        </style>
                    </sheet>
                    <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary" data-hotkey="g"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="c"/>
                </footer>
                </form>

            </field>
        </record>
    </data>
</odoo>