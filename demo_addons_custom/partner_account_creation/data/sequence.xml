<odoo>
    <data noupdate="1">
        <record id="account_payable_sequence" model="ir.sequence">
            <field name="name">Account Payable Sequence</field>
            <field name="code">partner.account.payable.seq</field>
            <field name="active">1</field>
            <field name="prefix">800</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False" />
        </record>
        <record id="account_receivable_sequence" model="ir.sequence">
            <field name="name">Account Receivable Sequence</field>
            <field name="code">partner.account.receivable.seq</field>
            <field name="active">1</field>
            <field name="prefix">900</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False" />
        </record>
    </data>
</odoo>