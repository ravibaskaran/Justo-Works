<odoo>
    <record id="incentive_generation_view_form" model="ir.ui.view">
        <field name="name">incentive_generation_view_form</field>
        <field name="model">incentive.generation</field>
        <field name="arch" type="xml">
            <form string="incentive_generation_form">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="invoice_ids" invisible="1"/>
                        <button name="view_invoices" string="Incentives" type="object" icon="fa-files-o"
                                class="oe_stat_button" attrs="{'invisible' : [('state', '!=', 'generated')]}"/>
                    </div>
                    <group>
                        <group>
                            <field name="financial_range" context="{'financial_year': 1}" widget="selection" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="interval" invisible="1"/>
                            <field name="period_id" domain="[('count', '&lt;=', 12 / interval)]" widget="selection" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="period_from" readonly="1" force_save="1"/>
                            <field name="period_to" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <div class="text-center p-4">
                        <button class="btn-primary" type="object" name="action_generate" string="Generate" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    </div>
                    <field name="line_ids" readonly="1" force_save="1">
                        <tree editable="bottom" create="0" edit="0" delete="0">
                            <field name="employee_id"/>
                            <field name="registration_id"/>
                            <field name="project_id"/>
                            <field name="flat_id"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="incentive_generation_view_tree" model="ir.ui.view">
        <field name="name">incentive_generation_view_tree</field>
        <field name="model">incentive.generation</field>
        <field name="arch" type="xml">
            <tree string="incentive_generation_tree">
                <field name="name"/>
                <field name="date"/>
                <field name="financial_range"/>
            </tree>
        </field>
    </record>
    <record id="incentive_generation_action" model="ir.actions.act_window">
        <field name="name">Incentive Generation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">incentive.generation</field>
        <field name="view_mode">tree,form</field>
    </record>
    <data>
        <record id="incentive_period_1" model="incentive.period">
            <field name="name">Period 1</field>
            <field name="count">1</field>
        </record>
        <record id="incentive_period_2" model="incentive.period">
            <field name="name">Period 2</field>
            <field name="count">2</field>
        </record>
        <record id="incentive_period_3" model="incentive.period">
            <field name="name">Period 3</field>
            <field name="count">3</field>
        </record>
        <record id="incentive_period_4" model="incentive.period">
            <field name="name">Period 4</field>
            <field name="count">4</field>
        </record>
        <record id="incentive_period_5" model="incentive.period">
            <field name="name">Period 5</field>
            <field name="count">5</field>
        </record>
        <record id="incentive_period_6" model="incentive.period">
            <field name="name">Period 6</field>
            <field name="count">6</field>
        </record>
        <record id="incentive_period_7" model="incentive.period">
            <field name="name">Period 7</field>
            <field name="count">7</field>
        </record>
        <record id="incentive_period_8" model="incentive.period">
            <field name="name">Period 8</field>
            <field name="count">8</field>
        </record>
        <record id="incentive_period_9" model="incentive.period">
            <field name="name">Period 9</field>
            <field name="count">9</field>
        </record>
        <record id="incentive_period_10" model="incentive.period">
            <field name="name">Period 10</field>
            <field name="count">10</field>
        </record>
        <record id="incentive_period_11" model="incentive.period">
            <field name="name">Period 11</field>
            <field name="count">11</field>
        </record>
        <record id="incentive_period_12" model="incentive.period">
            <field name="name">Period 12</field>
            <field name="count">12</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="sequence_incentive_generation" model="ir.sequence">
            <field name="name">Incentive Generation Sequence</field>
            <field name="code">incentive.generation.sequence</field>
            <field name="prefix">IG</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="use_date_range"/>
            <field eval="False" name="company_id"/>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>