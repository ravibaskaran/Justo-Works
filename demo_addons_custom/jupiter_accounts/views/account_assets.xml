<odoo>
    <record id="view_account_asset_asset_form_jupiter_accounts" model="ir.ui.view">
        <field name="name">view_account_asset_asset_form_jupiter_accounts</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.view_account_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='prorata']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='depreciation_line_ids']/tree/field[@name='parent_state']" position="after">
                <field name="method"/>
            </xpath>
            <xpath expr="//field[@name='depreciation_line_ids']/form/group/group/field[@name='remaining_value']" position="after">
                <field name="method"/>
            </xpath>
        </field>
    </record>
    <record id="asset_modify_form_jupiter_accounts" model="ir.ui.view">
        <field name="name">asset_modify_form_jupiter_accounts</field>
        <field name="model">asset.modify</field>
        <field name="inherit_id" ref="base_accounting_kit.asset_modify_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='method_period']]" position="after">
                <field name="method"/>
            </xpath>
        </field>
    </record>
</odoo>