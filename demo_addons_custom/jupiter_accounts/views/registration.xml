<odoo>
    <!-- Registration Form Inherited -->
    <record id="project_registration_view_form_jupiter_accounts" model="ir.ui.view">
        <field name="name">project_registration_view_form_jupiter_accounts</field>
        <field name="model">project.registration</field>
        <field name="inherit_id" ref="project_transactions.project_registration_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="employee_invoice_ids" invisible="1"/>
                <field name="developer_invoice_id" invisible="1"/>
                <field name="employee_invoice_count" invisible="1"/>
                <button name="view_employee_incentives" string="Incentives" type="object" icon="fa-clipboard"
                        class="oe_stat_button" attrs="{'invisible' : [('employee_invoice_count', '=', 0)]}"/>
                <button name="view_developer_invoice" string="Invoice" type="object" icon="fa-files-o"
                        class="oe_stat_button" attrs="{'invisible' : [('developer_invoice_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>