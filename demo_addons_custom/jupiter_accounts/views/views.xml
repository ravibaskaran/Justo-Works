<odoo>
    <data>
        <record id="view_account_payment_form_inherit_jupiter_accounts" model="ir.ui.view">
            <field name="name">view_account_payment_form_inherit_jupiter_accounts</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="inexoft_account_payments.view_account_payment_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="groups"/>
                    <attribute name="string">Cost Center</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_move_form_jupiter_accounts" model="ir.ui.view">
            <field name="name">view_move_form_jupiter_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="inexoft_account_voucher.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="invisible">0</attribute>
                    <attribute name="widget">selection</attribute>
                    <attribute name="attrs">{'invisible': [('move_type', '!=', 'entry')], 'readonly': [('state', '!=', 'draft')]}</attribute>
                    <attribute name="groups"/>
                </xpath>
                <xpath expr="//group[1]/group[1]" position="inside">
                    <xpath expr="//field[@name='journal_id']" position="move"/>
<!--                    <field name="journal_id" widget="selection" invisible="0" attrs="{'invisible': [('move_type', '!=', 'entry')], 'readonly': [('state', '!=', 'draft')]}"/>-->
                </xpath>
                <xpath expr="//field[@name='analytic_account_id']" position="after">
                    <field name="multiple_cost_center" attrs="{'invisible': [('move_type', '!=', 'entry')], 'readonly': [('state', '!=', 'draft')]}"/>
                </xpath>
                <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="groups"/>
                    <attribute name="optional">show</attribute>
                    <attribute name="attrs">{'invisible':[('multiple_cost_center', '=', True)]}</attribute>
                    <attribute name="string">Cost Center</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='analytic_account_id']" position="attributes">
                    <attribute name="groups"/>
                    <attribute name="optional">show</attribute>
                    <attribute name="attrs">{'column_invisible':[('parent.multiple_cost_center', '=', False)]}</attribute>
                    <attribute name="string">Cost Center</attribute>
                </xpath>
            </field>
        </record>

        <record id="direct_journal_view_move_form_jupiter_accounts" model="ir.ui.view">
            <field name="name">direct_journal_view_move_form_jupiter_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="inexoft_account_voucher.direct_journal_view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="invisible">0</attribute>
                    <attribute name="widget">selection</attribute>
                </xpath>
                <xpath expr="//field[@name='analytic_account_id']" position="after">
                    <field name="multiple_cost_center" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible':[('move_type', '!=', 'entry'),('direct_journal_entry_inx','!=',True)]}"/>
                </xpath>
                <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="groups"/>
                    <attribute name="attrs">{'invisible':[('multiple_cost_center', '=', True)]}</attribute>
                    <attribute name="string">Cost Center</attribute>
                </xpath>
                <xpath expr="//field[@name='direct_journal_item_ids']/tree/field[@name='partner_id']" position="after">
                    <field name="analytic_account_id" attrs="{'column_invisible': [('parent.multiple_cost_center', '=', False)]}"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_invoice_filter_jupiter_accounts" model="ir.ui.view">
            <field name="name">view_account_invoice_filter_jupiter_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='status']" position="after">
                    <filter name="project_id" string="Project" context="{'group_by':'project_id'}"/>
                </xpath>
            </field>
        </record>

        <record id="view_in_invoice_tree_jupiter_accounts" model="ir.ui.view">
            <field name="name">view_in_invoice_tree_jupiter_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_state']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_invoice_tree_jupiter_accounts" model="ir.ui.view">
            <field name="name">view_invoice_tree_jupiter_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_partner_display_name'][1]" position="attributes">
                    <attribute name="string">Partner</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_partner_display_name'][2]" position="attributes">
                    <attribute name="string">Partner</attribute>
                </xpath>
            </field>
        </record>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">view_move_form_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//span[@class='o_form_label']/field[@name='move_type']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('move_type', '=', 'entry'), ('is_project_invoice', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//button[@name='preview_invoice']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//button[@name='action_reverse']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//button[@name='%(account.action_view_account_move_reversal)d']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//group[@id='header_right_group']/div[@class='o_td_label'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="narration" string="Reference" readonly="0" force_save="1" attrs="{'invisible': [('move_type', '=', 'entry')], 'readonly': [('state', '!=', 'draft')]}" placeholder=" "/>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="attributes">
                    <attribute name="string">Accounting Date</attribute>
                    <attribute name="nolabel">0</attribute>
                    <attribute name="attrs">{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund',
                        'in_receipt', 'out_invoice'))], 'required': [('move_type', 'in', ('in_invoice', 'in_refund',
                        'in_receipt', 'out_invoice'))]}
                    </attribute>
                </xpath>
                <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="attributes">
                    <attribute name="attrs">{'invisible': [('move_type', 'in', ('in_invoice', 'in_refund',
                        'out_invoice', 'out_refund'))], 'readonly': [('state', '!=', 'draft')]}
                    </attribute>
                </xpath>
                <xpath expr="//page[@id='other_tab']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="domain">context.get('default_move_type') in ('out_invoice', 'out_refund',
                        'out_receipt') and [('is_property', '=', False), ('sale_ok', '=', True), '|', ('company_id',
                        '=', False), ('company_id', '=', parent.company_id)] or [('is_property', '=', False),
                        ('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=',
                        parent.company_id)]
                    </attribute>
                </xpath>
                <!--            <xpath expr="//field[@name='invoice_line_ids']/tree/control/create[@name='add_section_control']" position="attributes">-->
                <!--                <attribute name="invisible">1</attribute>-->
                <!--            </xpath>-->
                <!--            <xpath expr="//field[@name='invoice_line_ids']/tree/control/create[@name='add_note_control']" position="attributes">-->
                <!--                <attribute name="invisible">1</attribute>-->
                <!--            </xpath>-->
                <xpath expr="//field[@name='l10n_in_gst_treatment']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    <attribute name="attrs">{}</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_reference']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='purchase_vendor_bill_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//label[@for='purchase_vendor_bill_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//label[@name='invoice_vendor_bill_id_label']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="invisible">0</attribute>
                </xpath>
                <xpath expr="//label[@for='journal_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_account_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_tag_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='purchase_order_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="is_project_invoice" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'column_invisible': [('parent.is_project_invoice', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>
        <record id="purchase_modification_jupiter" model="ir.ui.view">
            <field name="name">purchase_modification_jupiter</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="purchase_extension.purchase_modification"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='additional_group']/label[@for='name']" position="attributes">
                    <attribute name="string">Invoice Number</attribute>
                </xpath>
                <xpath expr="//group[@name='additional_group']/field[@name='date']" position="attributes">
                    <attribute name="attrs">{'invisible': [('move_type', 'in', ('out_invoice', 'out_refund',
                        'out_receipt', 'in_invoice', 'in_refund'))], 'readonly': [('state', '!=', 'draft')]}
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='bill_number']" position="before">
                    <xpath expr="//field[@name='invoice_date']" position="move"/>
                </xpath>
                <xpath expr="//field[@name='bill_number']" position="attributes">
                    <attribute name="attrs">{'readonly':[('state','not in',('draft'))],'invisible':['|', ('move_type','not in',('in_invoice','in_refund')), ('is_project_invoice', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@name='additional_group']/field[@name='is_asset_purchase']" position="attributes">
                    <attribute name="attrs">{'readonly':[('state','!=','draft')],'invisible': ['|', ('move_type', 'not in',('in_invoice', 'in_refund')), ('is_project_invoice', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@name='additional_group']/field[@name='is_asset_purchase']" position="before">
                    <field name="bill_date"
                           attrs="{'invisible': ['|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('is_project_invoice', '=', True)]}"/>
                </xpath>
                <xpath expr="//field[@name='purchase_order']" position="attributes">
                    <attribute name="attrs">{'invisible':['|', ('move_type','!=','in_invoice'), ('is_project_invoice', '=', True)],'readonly':[('state','not in',('draft'))]}</attribute>
                </xpath>
                <xpath expr="//field[@name='free_qty']" position="attributes">
                    <attribute name="attrs">{'column_invisible': ['|', ('parent.move_type', 'not in', ('in_invoice', 'in_refund')), ('parent.is_project_invoice', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[field[@name='freight_charge_ids']]" position="attributes">
                    <attribute name="attrs">{'invisible':['|', ('move_type','not in',['in_invoice', 'in_refund']), ('is_project_invoice', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//label[@for='partner_id'][1]" position="attributes">
                    <attribute name="string">Partner</attribute>
                </xpath>
                <xpath expr="//label[@for='partner_id'][2]" position="attributes">
                    <attribute name="string">Partner</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="partner_details" attrs="{'invisible': [('is_project_invoice', '=', False)]}"/>
                </xpath>
                <xpath expr="//group[field[@name='tax_summary_ids']]" position="attributes">
                    <attribute name="attrs">{'invisible': [('move_type','not in',('in_invoice','in_refund'))]}</attribute>
                </xpath>
                <xpath expr="//group[group[field[@name='freight_charge_ids']]]" position="attributes">
                    <attribute name="attrs">{}</attribute>
                </xpath>
                <xpath expr="//group[group[field[@name='freight_charge_ids']]]" position="inside">
                    <xpath expr="//group[group[@class='oe_subtotal_footer oe_right']]" position="move"/>
                </xpath>
                <xpath expr="//group[group[@class='oe_subtotal_footer oe_right']]" position="attributes">
                    <attribute name="style">width: 50%; float: right;</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']" position="after">
                    <style>
                        th[data-name='sequence']{
                            width: 15px !important;
                            max-width: 15px !important;
                            min-width: 15px !important;
                        }
                        th[data-name='price_subtotal']{
                            width: 90px !important;
                            max-width: 15px !important;
                            min-width: 1590px !important;
                        }
                    </style>
                </xpath>
                <xpath expr="//group[@name='additional_group']/field[@name='is_asset_purchase']" position="after">
                    <xpath expr="//field[@name='invoice_origin']" position="move"/>
                    <field name="project_invoice_type" invisible="1"/>
                    <field name="project_id" attrs="{'invisible': [('project_invoice_type', '!=', 'developer_invoice')], 'readonly':[('state','!=','draft')]}" options="{'no_create': True, 'no_open': True,'no_quick_create':True,'no_create_edit':True}"/>
                    <field name="registration_id" attrs="{'invisible': [('project_invoice_type', '!=', 'employee_invoice')], 'readonly':[('state','!=','draft')]}" options="{'no_create': True, 'no_open': True,'no_quick_create':True,'no_create_edit':True}"/>
                    <field name="project_id" attrs="{'invisible': [('project_invoice_type', 'not in', ('spot_booking', 'cp_brokerage'))], 'readonly':[('state','!=','draft')]}" options="{'no_create': True, 'no_open': True,'no_quick_create':True,'no_create_edit':True}"/>
                </xpath>
                <xpath expr="//field[@name='invoice_origin']" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="force_save">1</attribute>
                    <attribute name="invisible">0</attribute>
                    <attribute name="attrs">{'invisible': [('is_project_invoice', '=', False)]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>