<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_booking_confirm_backdate" model="res.groups">
            <field name="name">Allow Booking Confirm Backdate</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>
        <record id="group_booking_cancel_anytime" model="res.groups">
            <field name="name">Booking Cancel Anytime</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>
        <record id="group_booking_confirm_anytime" model="res.groups">
            <field name="name">Booking Confirm Anytime</field>
        </record>

        <record id="group_booking_cancel" model="res.groups">
            <field name="name">Show Booking Cancel</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>
        <record id="group_booking_reset_to_draft" model="res.groups">
            <field name="name">Show Booking Reset To Draft</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>
        <record id="group_booking_reset_to_draft_confirmed" model="res.groups">
            <field name="name">Show Booking Reset To Draft In Confirm State</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>
        <record model="ir.module.category" id="module_real_estate_category">
                <field name="name">Real Estate</field>
                <field name="sequence">0</field>
                <field name="visible" eval="0" />
        </record>

        <record id="group_reservation" model="res.groups">
            <field name="name">Manage Reservations</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>

        <record id="group_ownership_rental_contracts" model="res.groups">
            <field name="name">Manage Ownership/Rental Contracts</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>

        <record id="group_units_structure" model="res.groups">
            <field name="name">Manage Property Structure</field>
            <field name="category_id" ref="module_real_estate_category"/>
        </record>       
        
        <record id="group_payments" model="res.groups">
            <field name="name">Manage Payments</field>
            <field name="category_id" ref="module_real_estate_category"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>            
        </record>

        <record id="group_real_estate_reports" model="res.groups">
            <field name="name">Real Estate Reports</field>
            <field name="category_id" ref="module_real_estate_category"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>            
        </record>   
             
        <record id="group_real_estate_admin" model="res.groups">
            <field name="name">Real Estate Admin</field>
            <field name="category_id" ref="module_real_estate_category"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>
    </data>
</odoo>