<odoo>
    <record id="reservation_payment_template_view_form" model="ir.ui.view">
        <field name="name">reservation_payment_template_view_form</field>
        <field name="model">reservation.payment.template</field>
        <field name="arch" type="xml">
            <form string="reservation_payment_template_form">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="tds_percentage"/>
                        </group>
                        <group>
                            <field name="gst"/>
                        </group>
                    </group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="percentage"/>
                                <field name="payment_schedule"/>
                            </tree>
                        </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="reservation_payment_template_action" model="ir.actions.act_window">
        <field name="name">Reservation Payment Template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">reservation.payment.template</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="reservation_payment_template_menu" parent="itsys_real_estate.menu_settings" action="itsys_real_estate.reservation_payment_template_action" sequence="60"/>
</odoo>