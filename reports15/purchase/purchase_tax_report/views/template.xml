<odoo>
    <template id="report_purchase_tax">
        <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                border: none;
                }
                tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid ;
                border-bottom: 1px solid ;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid ;
                }
                .text-right{
                text-align:right !important;
                }
                .text-left{
                text-align:left !important;
                }
                .text-center{
                text-align:center !important;
                }
                thead { display: table-header-group; }
                .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(0, 0, 0, 0.05) !important;
                }
                .daybook-table tr td{word-break: break-all; !important}
                .pagebreak{page-break-after:always}
                html,body{height:99% !important}
                @media pdf {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                thead {display: table-row-group;}
                tbody tr:nth-of-type(#{$table-striped-order}) {
                background-color: $table-accent-bg;}
                .pagebreak{page-break-after:always
                }
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                #branch{padding:0 !important;height: 145px;}
                .company_name{padding-top:0px !important}
                .pagebreak{page-break-after:always}}
                .header_company{display: none;}
                @media print{
                .header_company{display: unset;}
                }
                @media pdf{
                .header_company{display: unset;}
                }
            </style>
            <t t-if="res_company">
                <div class="header header_company">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="6" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="mb24 mt24" id="dvData">
                <center>
                    <h4 class="text-center mb20 " style="text-align:center">Purchase tax Report</h4>
                    <h6 style="font-size: 13px;text-align:center" class="text-center">Date :
                        <t t-esc="date_from"/>
                        -
                        <t t-esc="date_to"/>
                    </h6>
                </center>
            </div>
            <t t-if="lines['sales']">
                <h5 class="text-center mb12">
                    <u>PURCHASE
                    </u>
                </h5>
                <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                       style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                    <style>.table td{ padding: .8px !important;}</style>

                    <thead>
                        <th class="text-center" width="5%">SNo.</th>
                        <th class="text-center" width="8%">Date</th>
                        <t t-if="order == 'bill_wise' ">
                            <th class="text-center" width="9%">Bill</th>
                            <th class="text-center" width="19%">Supplier</th>
                        </t>
                        <th class="text-right" width="10%">Taxable</th>
                        <th class="text-right" width="8%">CGST</th>
                        <th class="text-right" width="8%">SGST</th>
                        <th class="text-right" width="8%">IGST</th>
                        <th class="text-right" width="8%">CESS</th>
                        <th class="text-right" width="11%">Net Amount</th>
                    </thead>

                    <tbody>
                        <t t-foreach="lines['sales']['lines']" t-as="line">
                            <t t-if="order == 'bill_wise' ">
                                <tr>
                                    <td class="text-left" colspan="10">
                                        <strong>
                                            <t t-esc="lines['sales']['lines'][line]['name']"/>
                                        </strong>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="order == 'date_wise' ">
                                <tr>
                                    <td class="text-left" colspan="8">
                                        <strong>
                                            <t t-esc="lines['sales']['lines'][line]['name']"/>
                                        </strong>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="order == 'month_wise' ">
                                <tr>
                                    <td class="text-left" colspan="8">
                                        <strong>
                                            <t t-esc="lines['sales']['lines'][line]['name']"/>
                                        </strong>
                                    </td>
                                </tr>
                            </t>
                            <t t-set="slno" t-value="1"/>
                            <t t-foreach="lines['sales']['lines'][line]['data']" t-as="data">
                                <tr>
                                    <td class="text-right">
                                        <t t-esc="slno"/>.
                                        <t t-set="slno" t-value="slno + 1"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="lines['sales']['lines'][line]['data'][data]['date']"/>
                                    </td>
                                    <t t-if="order == 'bill_wise' ">
                                        <td class="text-center">
                                            <span t-esc="lines['sales']['lines'][line]['data'][data]['name']"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="lines['sales']['lines'][line]['data'][data]['partner']"/>
                                        </td>
                                    </t>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['data'][data]['base'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['data'][data]['cgst'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['data'][data]['sgst'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['data'][data]['igst'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['data'][data]['cess'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['data'][data]['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <t t-if="order == 'bill_wise' ">
                                    <td class="text-center" colspan="4">
                                        <b>TOTAL</b>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td class="text-center" colspan="2">
                                        <b>TOTAL</b>
                                    </td>
                                </t>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['total_base'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['total_cgst'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['total_sgst'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['total_igst'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['total_cess'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['sales']['lines'][line]['total_amount'])"/>
                                    </b>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <t t-if="order == 'bill_wise' ">
                                <td class="text-center" colspan="4"
                                    style="font-size: 13px;">
                                    <b>
                                        Purchase Total
                                    </b>
                                </td>
                            </t>
                            <t t-if="order == 'date_wise' ">
                                <td class="text-center" colspan="2"
                                    style="font-size: 13px;">
                                    <b>
                                        Purchase Total
                                    </b>
                                </td>
                            </t>
                            <t t-if="order == 'month_wise' ">
                                <td class="text-center" colspan="2"
                                    style="font-size: 13px;">
                                    <b>
                                        Purchase Total
                                    </b>
                                </td>
                            </t>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['sales']['taxable_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['sales']['cgst_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['sales']['sgst_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['sales']['igst_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['sales']['cess_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['sales']['amount_total'])"/>
                                </b>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
            <t t-if="lines['returns']">
                <h5 class="text-center mb12">
                    <u>
                        PURCHASE RETURN
                    </u>
                </h5>
                <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                       style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                    <style>.table td{ padding: .8px !important;}</style>
                    <thead>
                        <th class="text-center" width="5%">SNo.</th>
                        <th class="text-center" width="8%">Date</th>
                        <t t-if="order == 'bill_wise' ">
                            <th class="text-center" width="9%">Bill</th>
                            <th class="text-center" width="19%">Supplier</th>
                        </t>
                        <th class="text-right" width="10%">Taxable</th>
                        <th class="text-right" width="8%">CGST</th>
                        <th class="text-right" width="8%">SGST</th>
                        <th class="text-right" width="8%">IGST</th>
                        <th class="text-right" width="8%">CESS</th>
                        <th class="text-right" width="11%">Net Amount</th>
                    </thead>
                    <tbody>
                        <t t-foreach="lines['returns']['lines']" t-as="line">
                            <t t-if="order == 'bill_wise' ">
                                <tr>
                                    <td class="text-left" colspan="10">
                                        <strong>
                                            <t t-esc="lines['returns']['lines'][line]['name']"/>
                                        </strong>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="order == 'date_wise' ">
                                <tr>
                                    <td class="text-left" colspan="8">
                                        <strong>
                                            <t t-esc="lines['returns']['lines'][line]['name']"/>
                                        </strong>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="order == 'month_wise' ">
                                <tr>
                                    <td class="text-left" colspan="8">
                                        <strong>
                                            <t t-esc="lines['returns']['lines'][line]['name']"/>
                                        </strong>
                                    </td>
                                </tr>
                            </t>
                            <t t-set="slno" t-value="1"/>
                            <t t-foreach="lines['returns']['lines'][line]['data']" t-as="data">
                                <tr>
                                    <td class="text-right">
                                        <t t-esc="slno"/>.
                                        <t t-set="slno" t-value="slno + 1"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="lines['returns']['lines'][line]['data'][data]['date']"/>
                                    </td>
                                    <t t-if="order == 'bill_wise' ">
                                        <td class="text-center">
                                            <span t-esc="lines['returns']['lines'][line]['data'][data]['name']"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="lines['returns']['lines'][line]['data'][data]['partner']"/>
                                        </td>
                                    </t>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['data'][data]['base'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['data'][data]['cgst'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['data'][data]['sgst'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['data'][data]['igst'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['data'][data]['cess'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['data'][data]['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <t t-if="order == 'bill_wise' ">
                                    <td class="text-center" colspan="4">
                                        <b>TOTAL</b>
                                    </td>
                                </t>
                                <t t-if="order == 'date_wise' ">
                                    <td class="text-center" colspan="2">
                                        <b>TOTAL</b>
                                    </td>
                                </t>
                                <t t-if="order == 'month_wise' ">
                                    <td class="text-center" colspan="2">
                                        <b>TOTAL</b>
                                    </td>
                                </t>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['total_base'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['total_cgst'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['total_sgst'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['total_igst'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['total_cess'])"/>
                                    </b>
                                </td>
                                <td class="text-right">
                                    <b>
                                        <t t-esc="'{0:.2f}'.format(lines['returns']['lines'][line]['total_amount'])"/>
                                    </b>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <t t-if="order == 'bill_wise' ">
                                <td class="text-center" colspan="4"
                                    style="font-size: 13px;">
                                    <b>
                                        Purchase Return Total
                                    </b>
                                </td>
                            </t>
                            <t t-if="order == 'date_wise' ">
                                <td class="text-center" colspan="2"
                                    style="font-size: 13px;">
                                    <b>
                                        Purchase Return Total
                                    </b>
                                </td>
                            </t>
                            <t t-if="order == 'month_wise' ">
                                <td class="text-center" colspan="2"
                                    style="font-size: 13px;">
                                    <b>
                                        Purchase Return Total
                                    </b>
                                </td>
                            </t>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['returns']['taxable_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['returns']['cgst_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['returns']['sgst_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['returns']['igst_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['returns']['cess_total'])"/>
                                </b>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <b>
                                    <t t-esc="'{0:.2f}'.format(lines['returns']['amount_total'])"/>
                                </b>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>


        </div>
    </template>

</odoo>