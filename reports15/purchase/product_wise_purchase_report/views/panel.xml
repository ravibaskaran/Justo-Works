        <!--CHANGE THIS-->
        <record id="reports_pdf_action" model="ir.actions.report">
            <field name="name">Report</field>
            <field name="model">report.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">product_wise_purchase_report.beta_reports_pdf</field>
            <field name="report_file">product_wise_purchase_report.beta_reports_pdf</field>
            <field name="binding_model_id" ref="product_wise_purchase_report.model_report_product"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="beta_reports_base.beta_reports_paper_format_portrait"/>
        </record>

        <record id="product_purchase_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">Report</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">report.product</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context"
                   eval="{'default_report_id': ref('product_wise_purchase_report.reports_pdf_action'), 'reload_always': 1}"/>  <!--CHANGE THIS-->
        </record>
    </data>
