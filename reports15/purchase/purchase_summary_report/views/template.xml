<odoo>
    <template id="report_purchase_summary">
        <!--        <t t-call="web.html_container">-->
        <!--            <t t-call="web.basic_layout">-->

        <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                <!--                       *{font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji" !important;}-->

                #details-tbl{
                border: none;
                }
                #details-tbl tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
                .header_company{display: none;}
                @media print{
                .header_company{display: unset;}
                }
                @media pdf{
                .header_company{display: unset;}
                }
            </style>

            <t t-if="res_company">
                <div class="header header_company" id="landscape_print">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="8" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="8">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div id="dvData" class="mb24 mt24">
                <center>
                    <h4 class="text-center mb20" style="text-align:center">Purchase Summary Report</h4>
                    <h6 class="text-center" style="text-align:center">Date :
                        <t t-esc="date_from"/>
                        -
                        <t t-esc="date_to"/>
                    </h6>
                </center>
            </div>
            <t t-if="lines['sales']">
                <h5 class="text-center mb12">
                    <u>PURCHASE
                    </u>
                </h5>
                <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                       style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;table-layout:fixed;">
                    <style>.table td{ padding: .8px !important;}</style>

                    <thead>
                        <th class="text-right" width="4%">
                            SNO.
                        </th>
                        <th class="text-center" width="7%">DATE</th>
                        <th class="text-center" width="10%">
                            BILL
                        </th>
                        <!--<th class="text-center" width="8%">BILL NO.</th>-->
                        <th class="text-center" width="7%">BILL DATE</th>
                        <th class="text-left" width="26%">
                            SUPPLIER
                        </th>
                        <th class="text-right" width="8%">TAXABLE</th>
                        <!--                    <th class="text-right" width="7%">TAX</th>-->
                        <th class="text-right" width="7%">SGST</th>
                        <th class="text-right" width="7%">CGST</th>
                        <th class="text-right" width="7%">IGST</th>
                        <!--<th class="text-right" width="6%">ADJ+/-</th>-->
                        <th class="text-right" width="8%">TOTAL</th>
                        <!--<th class="text-right" width="8%">MRP</th>-->
                    </thead>
                    <tbody>
                        <t t-set="slno" t-value="1"/>
                        <t t-foreach="lines['sales']['sales_lines']" t-as="line">
                            <tr>
                                <td class="text-right">
                                    <t t-esc="slno"/>
                                    .
                                    <t t-set="slno" t-value="slno + 1"/>
                                </td>
                                <td class="text-center">
                                    <span t-esc="line['date']"/>
                                </td>
                                <td class="text-center">
                                    <span t-esc="line['number']"/>
                                </td>
                                <!--<td class="text-left">
                                    <span t-esc="line['bill_number']"/>
                                </td>-->
                                <td class="text-center">
                                    <span t-esc="line['bill_date']"/>
                                </td>
                                <td class="text-left">
                                    <span t-esc="line['customer']"/>
                                </td>
                                <td class="text-right">
                                    <span class="text-nowrap" t-esc="'{:.2f}'.format(line['taxable'])"/>
                                </td>
                                <!--                            <td class="text-right">-->
                                <!--                                <span class="text-nowrap" t-esc="'{:.2f}'.format(line['tax'])"/>-->
                                <!--                            </td>-->
                                <td class="text-right">
                                    <span class="text-nowrap" t-esc="'{:.2f}'.format(line['sgst'])"/>
                                </td>
                                <td class="text-right">
                                    <span class="text-nowrap" t-esc="'{:.2f}'.format(line['cgst'])"/>
                                </td>
                                <td class="text-right">
                                    <span class="text-nowrap" t-esc="'{:.2f}'.format(line['igst'])"/>
                                </td>
                                <!--<td class="text-right">
                                    <span class="text-nowrap" t-esc="'{:.2f}'.format(line['additional_charges'])"/>
                                </td>-->
                                <td class="text-right">
                                    <span class="text-nowrap" t-esc="'{:.2f}'.format(line['total'])"/>
                                </td>
                                <!--<td class="text-right">
                                    <span class="text-nowrap" t-esc="'{:.2f}'.format(line['sales_value'])"/>
                                </td>-->
                            </tr>

                        </t>
                        <tr>
                            <td class="text-center" colspan="5">
                                <b>TOTAL</b>
                            </td>
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['sales']['total']['taxable_total'])"/>
                                </b>
                            </td>
                            <!--                        <td class="text-right">-->
                            <!--                            <b>-->
                            <!--                                <t t-esc="'{:.2f}'.format(lines['sales']['total']['tax_sum'])"/>-->
                            <!--                            </b>-->
                            <!--                        </td>-->
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['sales']['total']['sgst_sum'])"/>
                                </b>
                            </td>
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['sales']['total']['cgst_sum'])"/>
                                </b>
                            </td>
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['sales']['total']['igst_sum'])"/>
                                </b>
                            </td>
                            <!--<td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['sales']['total']['total_add'])"/>
                                </b>
                            </td>-->

                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['sales']['total']['amount_total'])"/>
                                </b>
                            </td>
                            <!--<td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['sales']['total']['sales_value_total'])"/>
                                </b>
                            </td>-->
                        </tr>
                    </tbody>
                </table>
            </t>
            <t t-if="lines['returns']">
                <h5 class="text-center mb12">
                    <u>
                        PURCHASE RETURN
                    </u>
                </h5>
                <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                       style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;table-layout:fixed;">
                    <style>.table td{ padding: .8px !important;}</style>
                    <thead>
                        <th class="text-right" width="4%">
                            SNO.
                        </th>
                        <th class="text-center" width="7%">DATE</th>
                        <th class="text-center" width="10%">
                            BILL
                        </th>
                        <!--<th class="text-center" width="8%">BILL NO.</th>-->
                        <th class="text-center" width="7%">BILL DATE</th>
                        <th class="text-left" width="26%">
                            SUPPLIER

                        </th>
                        <th class="text-right" width="8%">TAXABLE</th>
                        <!--                    <th class="text-right" width="7%">TAX</th>-->
                        <th class="text-right" width="7%">SGST</th>
                        <th class="text-right" width="7%">CGST</th>
                        <th class="text-right" width="7%">IGST</th>
                        <!--<th class="text-right" width="6%">ADJ +/-</th>-->
                        <th class="text-right" width="8%">TOTAL</th>
                        <!--<th class="text-right" width="8%">MRP</th>-->
                    </thead>
                    <tbody>
                        <t t-set="slno2" t-value="1"/>
                        <t t-foreach="lines['returns']['sales_lines']" t-as="returnsline">
                            <tr>
                                <td class="text-right">
                                    <t t-esc="slno2"/>
                                    .
                                    <t t-set="slno2" t-value="slno2 + 1"/>
                                </td>
                                <td class="text-center">
                                    <span t-esc="returnsline['date']"/>
                                </td>
                                <td class="text-center">
                                    <span t-esc="returnsline['number']"/>
                                </td>
                                <!--<td class="text-left">
                                    <span t-esc="returnsline['bill_number']"/>
                                </td>-->
                                <td class="text-center">
                                    <span t-esc="returnsline['bill_date']"/>
                                </td>
                                <td class="text-left">
                                    <span t-esc="returnsline['customer']"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:.2f}'.format(returnsline['taxable'])"/>
                                </td>
                                <!--                            <td class="text-right">-->
                                <!--                                <span t-esc="'{:.2f}'.format(returnsline['tax'])"/>-->
                                <!--                            </td>-->
                                <td class="text-right">
                                    <span t-esc="'{:.2f}'.format(returnsline['sgst'])"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:.2f}'.format(returnsline['cgst'])"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:.2f}'.format(returnsline['igst'])"/>
                                </td>
                                <!--<td class="text-right">
                                    <span t-esc="'{:.2f}'.format(returnsline['additional_charges'])"/>
                                </td>-->

                                <td class="text-right">
                                    <span t-esc="'{:.2f}'.format(returnsline['total'])"/>
                                </td>
                                <!--<td class="text-right">
                                    <span t-esc="'{:.2f}'.format(returnsline['sales_value'])"/>
                                </td>-->
                            </tr>


                        </t>
                        <tr style="width: 100%;font-size:13px;">
                            <td class="text-center" colspan="5" >
                                <b>TOTAL</b>
                            </td>
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['returns']['total']['taxable_total'])"/>
                                </b>
                            </td>
                            <!--                        <td class="text-right">-->
                            <!--                            <b>-->
                            <!--                                <t t-esc="'{:.2f}'.format(lines['returns']['total']['tax_sum'])"/>-->
                            <!--                            </b>-->
                            <!--                        </td>-->
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['returns']['total']['sgst_sum'])"/>
                                </b>
                            </td>
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['returns']['total']['cgst_sum'])"/>
                                </b>
                            </td>
                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['returns']['total']['igst_sum'])"/>
                                </b>
                            </td>
                            <!--<td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['returns']['total']['total_add'])"/>
                                </b>
                            </td>-->

                            <td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['returns']['total']['amount_total'])"/>
                                </b>
                            </td>
                            <!--<td class="text-right">
                                <b>
                                    <t t-esc="'{:.2f}'.format(lines['returns']['total']['sales_value_total'])"/>
                                </b>
                            </td>-->
                        </tr>

                    </tbody>
                </table>
            </t>
            <t t-if="lines['sales'] and lines['returns']">
                <h5 id="dvData" class="mb24 mt24">
                    <table id="tableId2" rules="groups" frame="hsides" border="1"
                           class="table table-bordered table-striped"
                           style="width: 100%;font-size:15px;border-top: 2px solid black;margin-top:10px;table-layout:fixed;">
                        <style>.table td{ padding: .8px !important;}</style>

                        <tbody>
                            <tr>
                                <td class="text-center"  colspan="6">
                                    Grand Total&#160;(Purchase-Purchase Return)

                                </td>
                                <td class="text-right" width="8%">

                                        <t t-esc="'{:.2f}'.format(lines['taxable_total'])"/>

                                </td>
                                <!--                            <td class="text-right" width="7%">-->
                                <!--                                <b>-->
                                <!--                                    <t t-esc="'{:.2f}'.format(lines['tax_sum'])"/>-->
                                <!--                                </b>-->
                                <!--                            </td>-->
                                <td class="text-right" width="7%">

                                        <t t-esc="'{:.2f}'.format(lines['sgst_sum'])"/>

                                </td>
                                <td class="text-right" width="7%">

                                        <t t-esc="'{:.2f}'.format(lines['cgst_sum'])"/>

                                </td>
                                <td class="text-right" width="7%">

                                        <t t-esc="'{:.2f}'.format(lines['igst_sum'])"/>

                                </td>
                                <!--<td class="text-right" width="6%">
                                    <b>
                                        <t t-esc="'{:.2f}'.format(lines['total_add'])"/>
                                    </b>
                                </td>-->
                                <td class="text-right" width="8%">

                                        <t t-esc="'{:.2f}'.format(lines['amount_total'])"/>

                                </td>
                                <!--<td class="text-right" width="8%">
                                    <b>
                                        <t t-esc="'{:.2f}'.format(lines['sales_value_total'])"/>
                                    </b>
                                </td>-->
                            </tr>
                        </tbody>
                    </table>
                </h5>
            </t>

        </div>
    </template>

</odoo>