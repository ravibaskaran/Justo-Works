                                            <span  t-if="branch_name!=''">Branch :
<!--                                                <t t-set="branch_div" t-value='branch_name.split(",")'/>-->
                                                <t t-set="new" t-value="''"/>
                                                <t t-set="index" t-value="0"/>
                                                <t t-foreach="branch_div" t-as="brnch">
                                                    <t t-set="index" t-value="index + 1"/>
                                                    <t t-set="new" t-value="new + brnch"/>
                                                    <t t-if="index % 5 == 0">
                                                        <t t-set="new" t-value="new + '&lt;br/&gt;'"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-set="new" t-value="new + ','"/>
                                                    </t>
                                                </t>
                                                <t t-set="new" t-value="new.rstrip(',')"/>
                                                <t t-raw="new"/>
