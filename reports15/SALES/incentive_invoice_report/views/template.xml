<odoo>
    <template id="report_incentive_invoice">
        <!--        <t t-call="web.html_container">-->
        <!--            <t t-call="web.basic_layout">-->

        <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                <!--                       *{font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji" !important;}-->

                #details-tbl{
                border: none;
                }
                #details-tbl tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
            </style>


            <t t-if="res_company">
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="4" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
<!--                                            <span t-if="branch_name!=''">Branch :-->
<!--                                                <t t-esc="branch_name"/>-->
<!--                                            </span>-->
<!--                                            <span  t-if="branch_name!=''">Branch :-->
<!--                                                <t t-set="branch_div" t-value='branch_name.split(",")'/>-->
<!--                                                <t t-set="new" t-value="''"/>-->
<!--                                                <t t-set="index" t-value="0"/>-->
<!--                                                <t t-foreach="branch_div" t-as="brnch">-->
<!--                                                    <t t-set="index" t-value="index + 1"/>-->
<!--                                                    <t t-set="new" t-value="new + brnch"/>-->
<!--                                                    <t t-if="index % 5 == 0">-->
<!--                                                        <t t-set="new" t-value="new + '&lt;br/&gt;'"/>-->
<!--                                                    </t>-->
<!--                                                    <t t-else="">-->
<!--                                                        <t t-set="new" t-value="new + ','"/>-->
<!--                                                    </t>-->
<!--                                                </t>-->
<!--                                                <t t-set="new" t-value="new.rstrip(',')"/>-->
<!--                                                <t t-raw="new"/>-->
<!--                                            </span>-->

                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="mb24 mt24">
                <table class="" width="100%" style="text-align: center;">
                    <tr>
                        <td colspan="4">
                            <h4 class="text-center mb20" style="text-align: center;">Incentive Invoice Report</h4>
                        </td>
                    </tr>
                    <tr t-if="not outstanding">
                        <td colspan="4">
                            <h6 class="text-center" style="text-align: center;">Date :
                                <t t-esc="date_from"/>
                                -
                                <t t-esc="date_to"/>
                            </h6>
                        </td>
                    </tr>
                </table>
            </div>
            <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                <style>.table td{ padding: .8px !important;}</style>

                <t t-if="case == 1">
                    <thead>

                        <th class="text-center" style="width: 5%">Sl.No</th>
                        <th class="text-center" style="width: 10%">Date</th>
                        <th class="text-center" style="width: 60%">Invoice No</th>
                        <th class="text-center" style="width: 10%">Untaxed</th>
                        <th class="text-center" style="width: 10%">CGST</th>
                        <th class="text-center" style="width: 10%">SGST</th>
                        <th class="text-center" style="width: 10%">IGST</th>
                        <th class="text-center" style="width: 10%">Amount</th>
                        <th t-if="outstanding" class="text-center" style="width: 10%">Due Amount</th>


                    </thead>
                    <tbody>

                        <t t-set="i" t-value="1"/>
                        <t t-foreach="lines['docsnn']" t-as="doc">

                            <t t-if="doc['name'] == 6">
                                <tr>

                                    <td class="text-center" t-att-colspan="9 if outstanding else 8">
                                        <h5 style="!important;font-weight:bold;font-size: 1.1rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="doc['customer']"/>
                                    </td>

                                </tr>
                            </t>
                            <t t-if="doc['name'] == 1">
                                <tr>

                                    <td class="text-center">
                                        <span t-esc="i"/>
                                    </td>

                                    <td class="text-center">
                                        <span t-esc="doc['date']"/>
                                    </td>

                                    <td class="text-left">
                                        <span t-esc="doc['invoice_no']"/>
                                    </td>

                                    <td class="text-right">
                                        <span t-esc="'%.2f'% doc['amount_untaxed']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f'% doc['cgst']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f'% doc['sgst']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f'% doc['igst']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f'% doc['total']"/>
                                    </td>
                                    <td t-if="outstanding" class="text-right">
                                        <span t-esc="'%.2f'% doc['due']"/>
                                    </td>

                                    <t t-set="i" t-value="i+1"/>
                                </tr>
                            </t>
                            <t t-if="doc['name'] == 10">
                                <tr>

                                    <td class="text-center">

                                    </td>

                                    <td class="text-left">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="doc['customer']"/>
                                    </td>

                                    <td class="text-left">

                                    </td>

                                    <td class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'%  doc['amount_untaxed']"/>
                                    </td>

                                    <td class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'%  doc['cgst']"/>
                                    </td>

                                    <td class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'%  doc['sgst']"/>
                                    </td>

                                    <td class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'%  doc['igst']"/>
                                    </td>

                                    <td class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'%  doc['total']"/>
                                    </td>
                                    <td t-if="outstanding" class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'%  doc['due']"/>
                                    </td>


                                </tr>
                            </t>


                        </t>


                    </tbody>

                </t>
                <t t-if="case == 2">
                    <thead>
                        <th class="text-center" style="width: 5%">Sl.No</th>
                        <th class="text-center" style="width: 50%">Employee Name</th>
                        <th class="text-center" style="width: 10%">Number of Invoice</th>
                        <th class="text-center">Amount</th>
                        <th t-if="outstanding" class="text-center">Due Amount</th>
                    </thead>
                    <tbody>
                        <t t-set="i" t-value="1"/>
                        <t t-foreach="lines['docsnn']" t-as="doc">

                            <t t-if="doc['name'] == 1">
                                <tr>

                                    <td class="text-center">
                                        <span t-esc="i"/>
                                    </td>

                                    <td class="text-left">
                                        <span t-esc="doc['partner_name']"/>
                                    </td>


                                    <td class="text-right">
                                        <span t-esc="doc['invoice_count']"/>
                                    </td>


                                    <td class="text-right">
                                        <span t-esc="'%.2f'% doc['total']"/>
                                    </td>
                                    <td t-if="outstanding" class="text-right">
                                        <span t-esc="'%.2f'% doc['due']"/>
                                    </td>
                                    <t t-set="i" t-value="i+1"/>
                                </tr>
                            </t>
                            <t t-if="doc['name'] == 10">
                                <tr>

                                    <td></td>
                                    <td class="text-left">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;">
                                            Grand Total
                                        </h5>
                                    </td>


                                    <td class="text-right">
                                        <!--                                   <span t-esc="doc['invoice_count']"/>-->
                                    </td>


                                    <td class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'% doc['total']"/>
                                    </td>
                                    <td t-if="outstanding" class="text-right">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;"
                                            t-esc="'%.2f'% doc['due']"/>
                                    </td>

                                </tr>
                            </t>

                        </t>


                    </tbody>
                </t>


            </table>
        </div>
        <!--            </t>-->

        <!--        </t>-->
    </template>

</odoo>