<odoo>
        <template id="report_inventory">
<!--        <t t-call="web.html_container">-->
<!--            <t t-call="web.basic_layout">-->

                <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
                    <style type="text/css">
                #details-tbl{
                border: none;
                }
                tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid ;
                border-bottom: 1px solid ;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid ;
                }
                .text-right{
                text-align:right !important;
                }
                .text-left{
                text-align:left !important;
                }
                .text-center{
                text-align:center !important;
                }
                thead { display: table-header-group; }
                .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(0, 0, 0, 0.05) !important;
                }
                .daybook-table tr td{word-break: break-all; !important}
                .pagebreak{page-break-after:always}
                html,body{height:99% !important}
                @media pdf {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                thead {display: table-row-group;}
                tbody tr:nth-of-type(#{$table-striped-order}) {
                background-color: $table-accent-bg;}
                .pagebreak{page-break-after:always
                }
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                #branch{padding:0 !important;height: 145px;}
                .company_name{padding-top:0px !important}
                .pagebreak{page-break-after:always}}
                .header_company{display: none;}
                @media print{
                .header_company{display: unset;}
                }
                @media pdf{
                .header_company{display: unset;}
                }
            </style>

                     <t t-if="res_company">
                <div class="header header_company">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="9" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center" class="mb4 text-center">
                                    <tr>
                                        <td colspan="9" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="9" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="9" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="9" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td colspan="9" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="9">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>

            <!--     Sub Heading       -->
            <div class="mb24 mt24" id="dvData">
                <center>
                    <h4 class="text-center mb20" style="text-align:center">Inventory Report</h4>
                    <h6 class="text-center" style="text-align:center" >Date :
                        <t t-esc="date"/>
                    </h6>
                </center>
            </div>

            <!--     Main Content       -->
            <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped" style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <tr>
                        <th class="text-right" width="5%">Sl No.</th>
                        <th class="text-left" width="25%">Description</th>
                        <th class="text-left" width="10%">HSN Code</th>
                        <th class="text-right" width="10%">Qty</th>
                        <th class="text-right" width="10%">UoM</th>         <!--     Unit of Measure     -->
                        <th class="text-right" width="10%">Pur.Rate</th>    <!--     Purchase Rate       -->
                        <th class="text-right" width="10%">Rate</th>        <!--     Sales Rate          -->
                        <th class="text-right" width="10%">MRP Value</th>
                        <th class="text-right" width="10%">Cost Value</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="tot_qty" t-value="0"/>
                    <t t-set="tot_mrp_value" t-value="0"/>
                    <t t-set="tot_amount" t-value="0"/>
                    <t t-set="slno" t-value="1"/>
                    <t t-if="category">

                        <t t-foreach="lines['data']" t-as="data">
                            <t t-if="data[1] == 'Heading'">
                                <tr>
                                    <td class="text-right">

                                    </td>
                                    <t t-if="data[3] == 'Total'">
                                        <td colspan="2">
                                            <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;">Total (<t t-esc="data[0]"/>)
                                            </h5>
                                        </td>

                                        <td class="text-right">
                                            <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'{:.2f}'.format(data[2])"/>
                                        </td>
                                        <td></td>

                                        <td class="text-right">
                                            <!--                                <t t-esc="'{:.2f}'.format(data[4])" />-->
                                        </td>
                                        <td class="text-right">
                                            <!--                                <t t-esc="'{:.2f}'.format(data[5])" />-->
                                        </td>
                                        <td class="text-right">
                                            <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'{:.2f}'.format(data[6])"/>
                                        </td>
                                        <td class="text-right">
                                            <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'{:.2f}'.format(data[7])"/>
                                        </td>

                                    </t>
                                    <t t-else="">
                                        <td colspan="8" class="text-left" style="font-size:1.1rem;">
                                            <h5 style="!important;font-weight:bold;font-size: 1.1rem;margin-top:7px;margin-bottom:7px;" t-esc="data[0]"/>
                                        </td>
                                    </t>


                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td class="text-right">
                                        <t t-esc="slno"/>
                                    </td>
                                    <td class="text-left">
                                        <t t-esc="data[0]"/>
                                    </td>
                                    <td class="text-left">
                                        <t t-esc="data[1]"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'{:.2f}'.format(data[2])"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="data[3]"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'{:.2f}'.format(data[4])"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'{:.2f}'.format(data[5])"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'{:.2f}'.format(data[6])"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'{:.2f}'.format(data[7])"/>
                                    </td>
                                    <t t-set="tot_qty" t-value="tot_qty + data[2]"/>
                                    <t t-set="tot_mrp_value" t-value="tot_mrp_value + data[6]"/>
                                    <t t-set="tot_amount" t-value="tot_amount + data[7]"/>

                                </tr>
                                <t t-set="slno" t-value="slno + 1"/>

                            </t>
                        </t>
                    </t>
                    <t t-else="">

                        <t t-foreach="lines['data']" t-as="data">
                            <tr>
                                <td class="text-right">
                                    <t t-esc="slno"/>
                                </td>
                                <td class="text-left">
                                    <t t-esc="data[0]"/>
                                </td>
                                <td class="text-left">
                                    <t t-esc="data[1]"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(data[2])"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="data[3]"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(data[4])"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(data[5])"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(data[6])"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(data[7])"/>
                                </td>
                                <t t-set="tot_qty" t-value="tot_qty + data[2]"/>
                                <t t-set="tot_mrp_value" t-value="tot_mrp_value + data[6]"/>
                                <t t-set="tot_amount" t-value="tot_amount + data[7]"/>
                            </tr>
                            <t t-set="slno" t-value="slno + 1"/>
                        </t>
                    </t>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="text-center" style="font-weight:bold;" colspan="3">Grand Total</td>
                        <td class="text-right" style="font-weight:bold;">
                            <t t-esc="'{:.2f}'.format(tot_qty)"/>
                        </td>
                        <td class="text-right" colspan="3"></td>
                        <td class="text-right" style="font-weight:bold;">
                            <t t-esc="'{:.2f}'.format(tot_mrp_value)"/>
                        </td>
                        <td class="text-right" style="font-weight:bold;">
                            <t t-esc="'{:.2f}'.format(tot_amount)"/>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </template>
</odoo>