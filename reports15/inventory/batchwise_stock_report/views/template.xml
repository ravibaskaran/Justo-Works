<odoo>
        <template id="report_batchwise_stock">
<!--        <t t-call="web.html_container">-->
<!--            <t t-call="web.basic_layout">-->

                <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
                    <style type="text/css">
                #details-tbl{
                border: none;
                }
                tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid ;
                border-bottom: 1px solid ;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid ;
                }
                .text-right{
                text-align:right !important;
                }
                .text-left{
                text-align:left !important;
                }
                .text-center{
                text-align:center !important;
                }
                thead { display: table-header-group; }
                .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(0, 0, 0, 0.05) !important;
                }
                .daybook-table tr td{word-break: break-all; !important}
                .pagebreak{page-break-after:always}
                html,body{height:99% !important}
                @media pdf {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                thead {display: table-row-group;}
                tbody tr:nth-of-type(#{$table-striped-order}) {
                background-color: $table-accent-bg;}
                .pagebreak{page-break-after:always
                }
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                #branch{padding:0 !important;height: 145px;}
                .company_name{padding-top:0px !important}
                .pagebreak{page-break-after:always}}
                .header_company{display: none;}
                @media print{
                .header_company{display: unset;}
                }
                @media pdf{
                .header_company{display: unset;}
                }
            </style>

                    <t t-if="res_company" >
                <div class="header header_company" >
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="15" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center"><span  t-if="branch_name!=''">Branch : <t t-esc="branch_name"/></span></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="15">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
                 <div class="mb24 mt24" id="dvData"> <center>
                    <h4 class="text-center mb20" style="text-align:center">Batch Wise Stock Report</h4>

                    <h6 class="text-center" style="text-align:center">Date : <t t-esc="date" /></h6>
                 </center>
                 </div>
               <table id="tableId2" rules="groups" frame="hsides" border="1"  class="table table-bordered table-striped"   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                   <style> .table td{ padding: .8px !important;} </style>
                     <thead>
                        <tr>
                            <th style="text-align: center;" width="5%">Sno</th>
                            <th style="text-align: center;" width="18%">Batch</th>
                            <th style="text-align: center;" width="5%">Qty</th>
<!--                            <th style="text-align: center;" width="4%">Exp</th>-->
                            <th style="text-align: center;" width="5%">Prate</th>
                            <th style="text-align: center;" width="5%">Rate</th>
                            <th style="text-align: center;" width="5%">Tax</th>
                            <th style="text-align: center;" width="5%">Pcs</th>
<!--                            <th style="text-align: center;" width="5%">Disc.%</th>-->
                            <th style="text-align: center;" width="8%">Unit Rate</th>
                            <th style="text-align: center;" width="10%">Taxable Value</th>
                            <th style="text-align: center;" width="10%">Tax Value</th>
                            <th style="text-align: center;" width="10%">Mrp Value</th>
                            <th style="text-align: center;" width="10%">Cost Value</th>
<!--                            <th style="text-align: center;" width="10%">Mrp With Disc</th>-->
                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="i" t-value="1" />
                        <t t-if="lines">
                        <t t-foreach="lines['docsnn']" t-as="doc">
                        <t t-if="doc['name'] == 5">
                            <tr >
                                <td></td>
                                <td class="text-left" colspan="11" >
                               <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="doc['product_name']"/>
                                </td>

                            </tr>
                          </t>
                        <t t-if="doc['name'] == 1">
                            <tr >

                                <td class="text-center"   >
                                <span t-esc="i"/>
                                </td>

                                <td class="text-left">
                                     <span t-esc="doc['lot_name']"/>
                                </td>


                                <td class="text-right">
                                   <span t-esc="'%.2f'% doc['qty']"/>
                                </td>


<!--                                <td class="text-right">-->
<!--                                   <span t-esc="doc['expiry']"/>-->
<!--                                </td>-->
                                <td class="text-right">
                                   <span t-esc="'%.2f'% doc['prate']"/>
                                </td>
                                <td class="text-right">
                                   <span t-esc="'%.2f'% doc['rate']"/>
                                </td>

                                <td class="text-right">
                                   <span t-esc="'%.2f'% doc['tax']"/>
                                </td>
                                <td class="text-left">
                                   <span t-esc="doc['pcs']"/>
                                </td>
<!--                                <td class="text-right">-->
<!--                                   <span t-esc="'%.2f'% doc['sales_disc']"/>-->
<!--                                </td>-->
                                 <td class="text-right">
                                   <span t-esc="'%.2f'% doc['unit_rate']"/>
                                </td>
                                <td class="text-right">
                                   <span t-esc="'%.2f'% doc['taxable_value']"/>
                                </td>
                                 <td class="text-right">
                                   <span t-esc="'%.2f'% doc['tax_value']"/>
                                </td>
                                 <td class="text-right">
                                   <span t-esc="'%.2f'% doc['mrp_value']"/>
                                </td>
                                 <td class="text-right">
                                   <span t-esc="'%.2f'% doc['cost_value']"/>
                                </td>
<!--                                 <td class="text-right">-->
<!--                                   <span t-esc="'%.2f'% doc['mrp_with_disc']"/>-->
<!--                                </td>-->
                             <t t-set="i" t-value="i+1"/>
                            </tr>
                        </t>
                        <t t-if="doc['name'] == 10">
                            <tr >



                                <td class="text-center" colspan="8">
                                     <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="doc['lot_name']"/>
                                </td>



                                <td class="text-right">
                                   <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'%.2f'% doc['taxable_value']"/>
                                </td>
                                 <td class="text-right">
                                   <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'%.2f'% doc['tax_value']"/>
                                </td>
                                 <td class="text-right">
                                   <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'%.2f'% doc['mrp_value']"/>
                                </td>
                                 <td class="text-right">
                                   <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'%.2f'% doc['cost_value']"/>
                                </td>
<!--                                 <td class="text-right">-->
<!--                                   <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="'%.2f'% doc['mrp_with_disc']"/>-->
<!--                                </td>-->

                            </tr>
                        </t>
                        </t>
                        </t>
                    </tbody>


                    </table>
                </div>

    </template>

</odoo>