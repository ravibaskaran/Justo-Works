<odoo>
    <!--CHANGE THIS-->
    <template id="developer_ageing_report">
        <div id="wrapwrap" class="page mb80"
             style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                border: none;
                }
                #details-tbl tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                }
                table a{
                text-decoration: none !important;
                color: inherit !important;
                }
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="18" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="">
                <div class="col-12">
                    <div style="border-bottom: 1px solid #000;"/>
                </div>
            </div>
            <div id="a3_landscape_print" class="mb24 mt24" >
                <center>
                    <h4 class="text-center mb20 "><t t-esc="type"/></h4>
                    <span t-if="date_from">As On Date : <t t-esc="date_from.strftime('%d/%m/%Y')"/></span><br/>
                </center>
            </div>
            <table t-if="date_from" id="tableId" rules="groups" frame="hsides" border="1"
                           class="table table-bordered table-striped"
                           style="table-layout:fixed;width: 100% !important;">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <tr>
                        <th colspan="3" style="text-align: center;"><t t-esc="header[0]"/></th>
                        <th style="text-align: center;"><t t-esc="header[1]"/></th>
                        <th style="text-align: center;"><t t-esc="header[2]"/></th>
                        <th style="text-align: center;"><t t-esc="header[3]"/></th>
                        <th style="text-align: center;"><t t-esc="header[4]"/></th>
                        <th style="text-align: center;"><t t-esc="header[5]"/></th>
                        <th style="text-align: center;"><t t-esc="header[6]"/></th>
                        <th style="text-align: center;"><t t-esc="header[7]"/></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="region">
                        <t t-set="region_doc" t-value="lines[region]"/>
                        <tr t-att-class="'h6' if summary else 'h5'">
                            <td colspan="3" style="text-align:left; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="region.name or 'Unspecified'"/>
                            </td>
                            <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="'{:.2f}'.format(region_doc['1']) if region_doc['1'] != 0 else '__'"/>
                            </td>
                            <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="'{:.2f}'.format(region_doc['2']) if region_doc['2'] != 0 else '__'"/>
                            </td>
                            <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="'{:.2f}'.format(region_doc['3']) if region_doc['3'] != 0 else '__'"/>
                            </td>
                            <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="'{:.2f}'.format(region_doc['4']) if region_doc['4'] != 0 else '__'"/>
                            </td>
                            <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="'{:.2f}'.format(region_doc['5']) if region_doc['5'] != 0 else '__'"/>
                            </td>
                            <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="'{:.2f}'.format(region_doc['6']) if region_doc['6'] != 0 else '__'"/>
                            </td>
                            <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;">
                                <span style="padding-right:4px" t-esc="'{:.2f}'.format(region_doc['7']) if region_doc['7'] != 0 else '__'"/>
                            </td>
                        </tr>
                        <t t-if="not summary" t-foreach="region_doc['partner_doc']" t-as="partner">
                            <t t-set="partner_doc" t-value="region_doc['partner_doc'][partner]"/>
                            <tr class="font-weight-bold">
                                <td colspan="3" style="text-align:left;">
                                    <span style="padding-right:4px" t-esc="partner_doc['name']"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="'{:.2f}'.format(partner_doc['1']) if partner_doc['1'] != 0 else '__'"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="'{:.2f}'.format(partner_doc['2']) if partner_doc['2'] != 0 else '__'"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="'{:.2f}'.format(partner_doc['3']) if partner_doc['3'] != 0 else '__'"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="'{:.2f}'.format(partner_doc['4']) if partner_doc['4'] != 0 else '__'"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="'{:.2f}'.format(partner_doc['5']) if partner_doc['5'] != 0 else '__'"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="'{:.2f}'.format(partner_doc['6']) if partner_doc['6'] != 0 else '__'"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="'{:.2f}'.format(partner_doc['7']) if partner_doc['7'] != 0 else '__'"/>
                                </td>
                            </tr>
                             <tr t-foreach="partner_doc['invoices']" t-as="inv">
                                <td colspan="3" style="text-align:left;">
                                    <span style="padding-right:4px" t-esc="inv[0]"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="inv[1]"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="inv[2]"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="inv[3]"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="inv[4]"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="inv[5]"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="inv[6]"/>
                                </td>
                                <td style="text-align:right;">
                                    <span style="padding-right:4px" t-esc="inv[7]"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <tr class="h5">
                        <td style="text-align:left; padding-top: 7px !important; padding-bottom: 4px !important;" colspan="3"><span style="padding-right:4px; padding-top: 7px !important; padding-bottom: 4px !important;" t-esc="account_total[0]"/></td>
                        <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;"><span style="padding-right:4px;" t-esc="account_total[1]"/></td>
                        <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;"><span style="padding-right:4px;" t-esc="account_total[2]"/></td>
                        <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;"><span style="padding-right:4px;" t-esc="account_total[3]"/></td>
                        <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;"><span style="padding-right:4px;" t-esc="account_total[4]"/></td>
                        <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;"><span style="padding-right:4px;" t-esc="account_total[5]"/></td>
                        <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;"><span style="padding-right:4px;" t-esc="account_total[6]"/></td>
                        <td style="text-align:right; padding-top: 7px !important; padding-bottom: 4px !important;"><span style="padding-right:4px;" t-esc="account_total[7]"/></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>