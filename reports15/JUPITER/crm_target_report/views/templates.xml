<odoo>
    <!--CHANGE THIS-->
    <template id="crm_target_report">
        <div id="wrapwrap" class="page mb80"
             style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                border: none;
                }
                #details-tbl tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                }
                table a{
                text-decoration: none !important;
                color: inherit !important;
                }
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="18" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="">
                <div class="col-12">
                    <div style="border-bottom: 1px solid #000;"/>
                </div>
            </div>
            <div id="a3_landscape_print" class="mb24 mt24">
                <style t-if="report_type=='pdf'">th{white-space: nowrap;}</style>
                <center>
                    <h4 class="text-center mb20">CRM Target Report</h4>
                    <h6 class="text-center">
                        <t t-esc="doc['month']"/>
                    </h6>
                </center>
            </div>
            <table id="" rules="groups" frame="hsides" border="1"
                   class="table table-bordered table-striped"
                   style="width: max-content; font-size:12px; border-top: 2px solid black; margin-top:10px; min-width: 100%;">
                <style>.table td{ padding: .8px 5px !important;}</style>
                <thead>
                    <th class="text-center">SNo.</th>
                    <th class="text-left">Project Name</th>
                    <th class="text-center">Total Units</th>
                    <th class="text-center">Registration Done</th>
                    <th class="text-center">Registration Pending</th>
                    <th class="text-center">SDR Pending</th>
                    <th class="text-center">Projection</th>
                    <th class="text-center">Achieved</th>
                    <th class="text-center">Cancellations</th>
                    <th class="text-center">Projection AV</th>
                    <th class="text-center">Achieved AV</th>
                    <th class="text-center">Cancellation AV</th>
                </thead>
                <tbody>
                    <t t-set="sl" t-value="0"/>
                    <tr t-foreach="doc['data']" t-as="line">
                        <t t-set="sl" t-value="sl + 1"/>
                        <td class="text-right"><t t-esc="sl"/></td>
                        <td class="text-left"><t t-esc="line['project_name']"/></td>
                        <td class="text-center"><t t-esc="line['booking_count']"/></td>
                        <td class="text-center"><t t-esc="line['registered_count']"/></td>
                        <td class="text-center"><t t-esc="line['pending_registration_count']"/></td>
                        <td class="text-center"><t t-esc="line['sdr_pending_count']"/></td>
                        <td class="text-center"><t t-esc="line['projection_count']"/></td>
                        <td class="text-center"><t t-esc="line['achieved_count']"/></td>
                        <td class="text-center"><t t-esc="line['cancellation_count']"/></td>
                        <td class="text-right"><t t-esc="'{:.2f}'.format(line['projection_av'])"/></td>
                        <td class="text-right"><t t-esc="'{:.2f}'.format(line['achieved_av'])"/></td>
                        <td class="text-right"><t t-esc="'{:.2f}'.format(line['cancellation_av'])"/></td>
                    </tr>
                    <tr class="font-weight-bold">
                        <t t-set="totals" t-value="doc['totals']"/>
                        <td class="text-right" colspan="2"/>
                        <td class="text-center"><t t-esc="totals['booking_count']"/></td>
                        <td class="text-center"><t t-esc="totals['registered_count']"/></td>
                        <td class="text-center"><t t-esc="totals['pending_registration_count']"/></td>
                        <td class="text-center"><t t-esc="totals['sdr_pending_count']"/></td>
                        <td class="text-center"><t t-esc="totals['projection_count']"/></td>
                        <td class="text-center"><t t-esc="totals['achieved_count']"/></td>
                        <td class="text-center"><t t-esc="totals['cancellation_count']"/></td>
                        <td class="text-right"><t t-esc="'{:.2f}'.format(totals['projection_av'])"/></td>
                        <td class="text-right"><t t-esc="'{:.2f}'.format(totals['achieved_av'])"/></td>
                        <td class="text-right"><t t-esc="'{:.2f}'.format(totals['cancellation_av'])"/></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>