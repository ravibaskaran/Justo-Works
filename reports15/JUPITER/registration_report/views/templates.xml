<odoo>
    <!--CHANGE THIS-->
    <template id="report_registration_report">
        <div id="wrapwrap" class="page mb80"
             style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                border: none;
                }
                #details-tbl tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                }
                table a{
                text-decoration: none !important;
                color: inherit !important;
                }
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table class="header-table" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td t-att-colspan="6 + (1 if line_wise else 0)" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td t-att-colspan="6 + (1 if line_wise else 0)" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td t-att-colspan="6 + (1 if line_wise else 0)" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td t-att-colspan="6 + (1 if line_wise else 0)" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td t-att-colspan="6 + (1 if line_wise else 0)" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="row zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid #000;"/>
                </div>
            </div>
            <div id="a3_landscape_print" class="mb24 mt24">
                <style t-if="report_type=='pdf'">th{white-space: nowrap;}</style>
                <center>
                    <h4 class="text-center mb20">Registration Report</h4>
                    <h6 class="text-center">Date :
                        <t t-if="date_start">
                            <t t-esc="date_start.strftime('%d/%m/%Y')"/>
                            -
                        </t>
                        <t t-if="date_end">
                            <t t-esc="date_end.strftime('%d/%m/%Y')"/>
                        </t>
                    </h6>
                </center>
            </div>
            <t t-raw="table"/>
            <script>
                $(document).ready(function(){
                    $('.zero_min_height').css('width', $('#tableId').css('width'));
                })
            </script>
            <table id="" rules="groups" frame="hsides" border="1"
                   class="table table-bordered table-striped"
                   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <th class="text-center" t-att-width="line_wise and '8%'">Reg.No</th>
                    <!--   <t t-if="line_wise"><th class="text-center" t-att-width="line_wise and '15%'">Project</th></t>-->
                    <th class="text-center" width="25%">Customer</th>
                    <th class="text-center" width="15%">Project</th>
                    <th class="text-center" t-att-width="line_wise and '10%'">Inventory</th>
                    <th class="text-center" t-att-width="line_wise and '10%'">Registration Date</th>
                    <th class="text-center" t-att-width="line_wise and '10%'">Booking Date</th>
                    <th class="text-center" t-att-width="line_wise and '10%'">Agreement Value</th>
                </thead>
                <tbody>
                    <tr t-foreach="data" t-as="line" t-if="line['sequence'] not in (1000,3000) or (line['sequence'] in (1000,3000) and not line_wise)">
                        <t t-if="line['sequence'] == 1000 and not line_wise">
                            <td colspan="6" class="text-center h4" style="padding-top: 5px !important; padding-bottom: 5px !important;">
                                <span t-esc="line['project_name']"/>
                            </td>
                        </t>
                        <t t-elif="line['sequence'] == 2000">
                            <td class="text-center"><t t-esc="line['registration']"/></td>
                        <!--     <t t-if="line_wise"><td><t t-esc="line['project_name']"/></td></t> -->
                            <td><t t-esc="line['customer']"/></td>
                            <td><t t-esc="line['project_name']"/></td>
                            <td class="text-center"><t t-esc="line['inventory']"/></td>
                            <td class="text-center"><t t-esc="line['registration_date'].strftime('%d/%m/%Y') if line['registration_date'] else ''"/></td>
                            <td class="text-center"><t t-esc="line['booking_date'].strftime('%d/%m/%Y') if line['booking_date'] else ''"/></td>
                            <td class="text-right" style="mso-number-format:'0.00';"><t t-esc="'%.2f' % (line['agreement_value'] or 0)"/></td>
                        </t>
                        <t t-elif="line['sequence'] == 3000 and not line_wise">
                            <t t-if="line_wise"><td></td></t>
                            <td colspan="5" class="text-center font-weight-bold">
                                Project Total
                            </td>
                            <td class="font-weight-bold text-right" style="mso-number-format:'0.00';">
                                <t t-esc="'%.2f' % (line['agreement_value'] or 0)"/>
                            </td>
                        </t>
                        <t t-elif="line['sequence'] == 4000">
                            <t t-if="line_wise"><td></td></t>
                            <td colspan="5" class="text-center font-weight-bold">
                                Grand Total
                            </td>

                            <td class="font-weight-bold text-right" style="mso-number-format:'0.00';">
                                <t t-esc="'%.2f' % (line['agreement_value'] or 0)"/>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>