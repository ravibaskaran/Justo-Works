<odoo>
    <data>
        <record id="booking_report_view_form" model="ir.ui.view">  <!--CHANGE THIS-->
            <field name="name">booking_report_view_form</field>  <!--CHANGE THIS-->
            <field name="model">beta.booking.report</field>  <!--CHANGE THIS-->
            <field name="arch" type="xml">
                <form string="booking_report_form">
                    <div class="beta_main_panel" report="Booking Report">  <!--CHANGE THIS-->
                        <div class="m-0 row report_panel">
                            <div class="report-btn-panel col-12 col-lg-3 my-auto text-center">
                                <a role="button" style="color: #FFFFFF; border-radius:6px; padding: .6rem; margin-top: 5px;"
                                   title="Download Excel" id="beta_excel_print"
                                   class="btn btn-primary btn-prints fa fa-file-excel-o mr-1 col-2 col-lg-3">
                                    Excel
                                </a>
                                <span style="padding-top: 3px;" class="get_report_div col-2 col-lg-12 p-0">
                                    <button name="get_html" type="object"
                                            style="color: #FFFFFF; border-radius:6px; padding: .6rem 2rem;"
                                            class="btn btn-primary o_panel_get_report_beta mt-2">
                                        Get Report
                                    </button>
                                </span>
                            </div>
                            <field name="report_id" invisible="1"/>
                            <div class="col-12 col-lg-9 pt-2">
                                <div class="row mr-3">
                                    <div class="col-12 col-lg-2">
                                        <div class="row">
                                            <strong>Date From</strong>
                                            <div class="col-12 pl-0">
                                                <field name="date_from" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <strong>Date To</strong>
                                            <div class="col-12 pl-0">
                                                <field name="date_to" required="1"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-4">
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Type</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="project_filter" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row" attrs="{'invisible': [('consolidate', '=', True)]}">
                                            <div class="col-4">
                                                <strong>State</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="state" required="1"/>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Region wise</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="region_wise"/>
                                            </div>
                                        </div>

                                        <div class="row" invisible="1">
                                            <div class="col-4">
                                                <strong>Consolidate</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="consolidate"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-3"
                                         attrs="{'invisible': [('project_filter', '=', 'all')]}">
                                        <div>
                                            <strong>Projects</strong>
                                            <div class="col-12">
                                                <field name="project_ids" widget="many2many_tags"
                                                       options="{'no_open': True, 'no_quick_create': True, 'no_create': True}"
                                                       attrs="{'required': [('project_filter', '=', 'selected')]}"/>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Regions Many2many Field -->
                                    <div class="col-12 col-lg-3" attrs="{'invisible': [('region_wise', '=', False)]}">
                                        <div>
                                            <strong>Regions</strong>
                                            <div class="col-12"
                                                 style="width: 305px; overflow-y: auto; display: flex; flex-wrap: wrap;">
                                                <field name="region_ids" widget="many2many_tags"
                                                       options="{'no_open': True, 'no_quick_create': True, 'no_create': True}"
                                                       style="width: 100%; max-height: 120px; overflow-y: auto; padding: 8px; border: 1px solid #ccc;"/>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="mt-5 template_div">
                            <div class="beta_template_area"/>
                            <img src="/booking_report/static/src/img/loading_transparent.gif" invisible="context.get('hide_loading_gif', True)"
                                 alt="Loading..."
                                 class="loading-gif"/>
                            <field name="template_area" class="d-none"/>
                            <field name="form_edit" class="d-none"/>
                        </div>
                        <script>
                            $(document).ready(function(){
                            $('.beta_template_area').append($('[name="template_area"]').val())
                            $('[name="form_edit"]').click();
                            })
                        </script>
                        <style>
                            /* Customize the GIF */
                            .loading-gif {
                                margin-left: 50%;
                                margin-top: 13%;
                            }
                            .o_view_controller .o_control_panel{
                            display: none;
                            }
                            table th,td{
                            overflow-wrap: break-word;
                            }
                            #tableId{
                            width: max-content !important;
                            }
                            #tableId td {
                                padding-left: .5rem !important;
                                padding-right: .5rem !important;
                            }
                            html .o_web_client > .o_action_manager > .o_action > .o_content{
                            overflow: overlay;
                            }
                            .o_form_view {
                            padding: 0 0 14px 0px !important;
                            background: #f9f9f9;
                            }
                            .report_panel{
                            padding-bottom: 1rem;
                            box-shadow: 0px 6px 7px #0000003b;
                            padding-top: 14px;
                            background: white;
                            position: fixed;
                            width: 95%;
                            z-index: 1;
                            top: 46px;
                            left: 50px;
                            max-height: 150px;
                            border-radius: 14px;
                            min-height: 114px;
                            }
                            .template_div{
                            padding-top: 8rem;
                            }
                            .o_field_widget.o_field_many2manytags .o_tag_color_0{
                            box-shadow: inset 0 0 0 1px #777777;
                            }
                            .o_field_many2manytags {
                            max-height: 70px;
                            height: 70px;
                            overflow-y: auto;
                            width: 100%;
                            }
                            .o_field_widget.o_field_many2manytags .badge {
                            font-size: 11px;
                            max-width: 95%;
                            height: 18px;
                            }
                            .o_form_view .o_datepicker {
                            width: 100% !important;
                            }
                            .o_field_widget.o_field_many2manytags .badge .o_badge_text{
                            text-overflow: ellipsis;
                            width: 90%;
                            }
                            .template_div .table thead{
                            top: 130px;
                            position: sticky;
                            background: white;
                            }
                            [name='branch_id'] select {
                            display: none;
                            }
                            @media only screen and (max-width: 990px) {
                                .report_panel{
                                    left: 0px;
                                    width: 100%;
                                }
                                .o_panel_get_report_beta{
                                    margin-top: 0 !important;
                                }
                                table{
                                    table-layout: unset !important;
                                }
                                .report_panel{
                                    max-height: unset;
                                }
                                table td, table th{
                                    white-space: nowrap;
                                }
                                .report-btn-panel{
                                    position: fixed;
                                    bottom: 8px;
                                }
                            }
                            @media only screen and (max-width: 369px) {
                                .o_panel_get_report_beta{
                                    padding: 1.2rem !important;
                                }
                                .btn-prints{
                                padding: 0.375rem 0.75rem !important;
                                }
                            }
                            .header-table{
                                display:none !important;
                            }
                        </style>
                        <style id="style-to-remove" invisible="context.get('hide_loading_gif', True)">

                        </style>
                        <script>
                             $(document).ready(function(){
                                console.log("style-to-remove",$('#style-to-remove.o_invisible_modifier'));
                                if($('#style-to-remove.o_invisible_modifier').length ==0){
                                    $('#style-to-remove').html('.report_panel {top: 84px;}.template_div .table thead{top: 80px;}.o_view_controller .o_control_panel {display: block;}.o_cp_bottom{display: none;}.o_cp_bottom .o_cp_bottom_left{display: none;}.template_div{padding-top: 4rem;}');
                                }else{
                                    $('#style-to-remove.o_invisible_modifier').html('');
                                }
                            })
                        </script>
                    </div>
                </form>
            </field>
        </record>

        <!-- Inherit Form View to Modify it booking by region-->
        <record id="booking_report_view_form_inherit" model="ir.ui.view">
            <field name="name">booking_report_view_form</field>
            <field name="model">beta.booking.report</field>
            <field name="inherit_id" ref="booking_report_view_form"/>
            <field name="groups_id" eval="[(4, ref('project_transactions.group_region_booking_user'))]"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='region_ids']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='region_wise']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
            </field>
        </record>
        <!-- Inherit Form View to Modify it project-->
        <record id="booking_report_view_form_inherit_all_project" model="ir.ui.view">
            <field name="name">booking_report_view_form</field>
            <field name="model">beta.booking.report</field>
            <field name="inherit_id" ref="booking_report_view_form_inherit"/>
            <field name="groups_id" eval="[(4, ref('project_transactions.view_all_projects'))]"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='region_ids']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
                <xpath expr="//field[@name='region_wise']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
            </field>
        </record>

        <template id="beta_reports_pdf">
            <main/>
            <t t-call="web.basic_layout">
                <t t-raw="template_area"/>
            </t>
        </template>

        <record id="beta_booking_paper_format_landscape" model="report.paperformat">
            <field name="name">Beta Booking Reports Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A2</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">28</field>
            <field name="dpi">99</field>
        </record>

        <!--CHANGE THIS-->
        <record id="booking_report_reports_pdf_action" model="ir.actions.report">
            <field name="name">Booking Report</field>
            <field name="model">beta.booking.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">booking_report.beta_reports_pdf</field>
            <field name="report_file">booking_report.beta_reports_pdf</field>
            <field name="binding_model_id" ref="booking_report.model_beta_booking_report"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="beta_booking_paper_format_landscape"/>
        </record>

        <record id="booking_report_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">Booking Report</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">beta.booking.report</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context"
                   eval="{'default_report_id': ref('booking_report.booking_report_reports_pdf_action')}"/>  <!--CHANGE THIS-->
        </record>
<!--        <menuitem id="booking_report_menu" action="booking_report.booking_report_action"/>-->
    </data>
</odoo>