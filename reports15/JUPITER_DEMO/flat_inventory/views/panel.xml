<odoo>
    <data>
        <record id="flat_inventory_view_form" model="ir.ui.view">  <!--CHANGE THIS-->
            <field name="name">flat_inventory_view_form</field>  <!--CHANGE THIS-->
            <field name="model">beta.flat.inventory</field>  <!--CHANGE THIS-->
            <field name="arch" type="xml">
                <form string="flat_inventory_form">
                    <div class="beta_main_panel" report="Flat Inventory">  <!--CHANGE THIS-->
                        <div class="m-0 row report_panel">
                            <div class="report-btn-panel col-12 col-lg-3 my-auto text-center">
                                <a role="button" style="color: #FFFFFF; border-radius:6px; padding: .6rem;"
                                   title="Download Excel" id="beta_excel_print"
                                   class="btn btn-primary btn-prints fa fa-file-excel-o mr-1 col-2 col-lg-3">
                                    Excel
                                </a>
                                <a role="button" style="color: #FFFFFF; border-radius:6px; padding: .6rem;"
                                   title="Print" class="btn btn-primary btn-prints fa fa-print mr-1 col-2 col-lg-3" type="button"
                                   id="beta_direct_print">
                                    Print
                                </a>
                                <button style="color: #FFFFFF; border-radius:6px; padding: .6rem;"
                                        name="beta_pdf_print" type="object"
                                        class="btn btn-primary btn-prints fa fa-file-pdf-o col-2 col-lg-3">
                                    PDF
                                </button>
                                <span style="padding-top: 3px;" class="get_report_div col-2 col-lg-12 p-0">
                                    <button name="get_html" type="object"
                                            style="color: #FFFFFF; border-radius:6px; padding: .6rem 2rem;"
                                            class="btn btn-primary o_panel_get_report_beta mt-2">
                                        Get Report
                                    </button>
                                </span>
                            </div>
                            <field name="report_id" invisible="1"/>
                            <div class="col-12 col-lg-9 pt-2">
                                <div class="row mr-3">
                                    <div class="col-12 col-lg-4">
                                        <div class="row">
                                            <div class="col-3">
                                                <strong>Type</strong>
                                            </div>
                                            <div class="col-9">
                                                <field name="project_filter" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-3">
                                                <strong>Status</strong>
                                            </div>
                                            <div class="col-9">
                                                <field name="state" required="1"/>
                                            </div>
                                            <div class="col-3">
                                                <strong>State (Flat)</strong>
                                            </div>
                                            <div class="col-9">
                                                <field name="status_filter" required="1"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-4" attrs="{'invisible': [('project_filter', '=', 'all')]}">
                                        <div class="row">
                                            <div class="col-3">
                                                <strong>Projects</strong>
                                            </div>
                                            <div class="col-9">
                                                <field name="project_ids" widget="many2many_tags"
                                                       options="{'no_open': True, 'no_quick_create': True, 'no_create': True}"
                                                       attrs="{'required': [('project_filter', '=', 'selected')]}"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-4">
                                        <div class="row">
                                            <div class="col-3">
                                                <strong>Flat Types</strong>
                                            </div>
                                            <div class="col-9">
                                                <field name="flat_type_ids" widget="many2many_tags"
                                                       options="{'no_open': True, 'no_quick_create': True, 'no_create': True}"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 template_div">
                            <div class="beta_template_area"/>
                            <field name="template_area" class="d-none"/>
                            <field name="form_edit" class="d-none"/>
                        </div>
                        <script>
                            $(document).ready(function(){
                            $('.beta_template_area').append($('[name="template_area"]').val())
                            $('[name="form_edit"]').click();
                            })
                        </script>
                        <style>
                            html .o_web_client > .o_action_manager > .o_action > .o_content{
                            overflow: overlay;
                            }
                            .o_form_view {
                            padding: 0 0 14px 0px !important;
                            background: #f9f9f9;
                            }
                            .report_panel{
                            padding-bottom: 1rem;
                            box-shadow: 0px 6px 7px #0000003b;
                            padding-top: 10px;
                            background: white;
                            position: fixed;
                            width: 95%;
                            z-index: 1;
                            top: 46px;
                            left: 48px;
                            max-height: 120px;
                            border-radius: 14px;
                            }
                            .template_div{
                            padding-top: 8rem;
                            }
                            .o_field_widget.o_field_many2manytags .o_tag_color_0{
                            box-shadow: inset 0 0 0 1px #777777;
                            }
                            .o_field_many2manytags {
                            max-height: 70px;
                            height: 70px;
                            overflow-y: auto;
                            width: 100%;
                            }
                            .o_field_widget.o_field_many2manytags .badge {
                            font-size: 11px;
                            max-width: 95%;
                            height: 18px;
                            }
                            .o_form_view .o_datepicker {
                            width: 100% !important;
                            }
                            .o_field_widget.o_field_many2manytags .badge .o_badge_text{
                            text-overflow: ellipsis;
                            width: 90%;
                            }
                            .template_div .table thead{
                            top: 106px;
                            position: sticky;
                            background: white;
                            }
                            [name='branch_id'] select {
                            display: none;
                            }
                            @media only screen and (max-width: 990px) {
                                .report_panel{
                                    left: 0px;
                                    width: 100%;
                                }
                                .o_panel_get_report_beta{
                                    margin-top: 0 !important;
                                }
                                table{
                                    table-layout: unset !important;
                                }
                                .report_panel{
                                    max-height: unset;
                                }
                                table td, table th{
                                    white-space: nowrap;
                                }
                                .report-btn-panel{
                                    position: fixed;
                                    bottom: 8px;
                                }
                            }
                            @media only screen and (max-width: 369px) {
                                .o_panel_get_report_beta{
                                    padding: 1.2rem !important;
                                }
                                .btn-prints{
                                padding: 0.375rem 0.75rem !important;
                                }
                            }
                            .header-table{
                                display:none !important;
                            }
                        </style>
                    </div>
                </form>
            </field>
        </record>

        <template id="beta_reports_pdf">
            <main/>
            <t t-call="web.basic_layout">
                <t t-raw="template_area"/>
            </t>
        </template>
        <!--CHANGE THIS-->
        <record id="flat_inventory_reports_pdf_action" model="ir.actions.report">
            <field name="name">Flat Inventory</field>
            <field name="model">beta.flat.inventory</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">flat_inventory.beta_reports_pdf</field>
            <field name="report_file">flat_inventory.beta_reports_pdf</field>
            <field name="binding_model_id" ref="flat_inventory.model_beta_flat_inventory"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="beta_reports_base.beta_reports_paper_format_portrait"/>
        </record>

        <record id="flat_inventory_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">Flat Inventory</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">beta.flat.inventory</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context"
                   eval="{'default_report_id': ref('flat_inventory.flat_inventory_reports_pdf_action')}"/>  <!--CHANGE THIS-->
        </record>
<!--        <menuitem id="flat_inventory_menu" action="flat_inventory.flat_inventory_action"/>-->
    </data>
</odoo>