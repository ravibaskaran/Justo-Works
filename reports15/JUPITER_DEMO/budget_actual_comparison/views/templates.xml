<odoo>
    <!--CHANGE THIS-->
    <template id="budget_actual_comparison_report">
        <div id="wrapwrap" class="page mb80"
             style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                border: none;
                }
                #details-tbl tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                }
                table a{
                text-decoration: none !important;
                color: inherit !important;
                }
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="18" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="18" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="">
                <div class="col-12">
                    <div style="border-bottom: 1px solid #000;"/>
                </div>
            </div>
            <div id="a3_landscape_print" class="mb24 mt24">
                <style t-if="report_type=='pdf'">th{white-space: nowrap;}</style>
                <center>
                    <h4 class="text-center mb20">Budget Vs Actual</h4>
                </center>
            </div>
            <table id="" rules="groups" frame="hsides" border="1"
                   class="table table-bordered table-striped"
                   style="width: max-content; font-size:12px; border-top: 2px solid black; margin-top:10px; min-width: 100%;">
                <style>
                    .table td{
                    padding: .8px 5px !important;
                    }
                </style>
                <thead>
                    <tr>
                        <th rowspan="2" class="text-center align-middle">Region</th>
                        <th rowspan="2" class="text-center align-middle">Particulars</th>
                        <th class="text-center">Budget</th>
                        <th class="text-center">Actual</th>
                        <th class="text-center">Variance</th>
                        <th class="text-center">Actual</th>
                        <th class="text-center">Variance</th>
                    </tr>
                    <tr>
                        <th class="text-center"><t t-esc="doc['month']"/></th>
                        <th class="text-center"><t t-esc="doc['month']"/></th>
                        <th class="text-center"><t t-esc="doc['month']"/></th>
                        <th class="text-center"><t t-esc="doc['prev_month']"/></th>
                        <th class="text-center"><t t-esc="doc['month']"/> Vs <t t-esc="doc['prev_month']"/></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="data" t-value="doc['data']"/>
                    <t t-foreach="data" t-as="region_data">
                        <t t-set="total_class" t-value="'font-weight-bold' if region_data['region'] == 'Total' else ''"/>
                        <tr t-att-class="total_class">
                            <td rowspan="4" class="text-center align-middle"><t t-esc="region_data['region']"/></td>
                            <td>No of Units</td>
                            <td class="text-right"><t t-esc="region_data['budget_booking_count']"/></td>
                            <td class="text-right"><t t-esc="region_data['actual_booking_count']"/></td>
                            <td class="text-right"><t t-esc="region_data['booking_count_variance']"/></td>
                            <td class="text-right"><t t-esc="region_data['prev_actual_booking_count']"/></td>
                            <td class="text-right"><t t-esc="region_data['prev_booking_count_variance']"/></td>
                        </tr>
                        <tr t-att-class="total_class">
                            <td>Value of Sales</td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['budget_booking_value'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['actual_booking_value'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['booking_value_variance'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['prev_actual_booking_value'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['prev_booking_value_variance'])"/></td>
                        </tr>
                        <tr t-att-class="total_class">
                            <td>Registered No of Units</td>
                            <td class="text-right"><t t-esc="region_data['budget_registration_count']"/></td>
                            <td class="text-right"><t t-esc="region_data['actual_registration_count']"/></td>
                            <td class="text-right"><t t-esc="region_data['registration_count_variance']"/></td>
                            <td class="text-right"><t t-esc="region_data['prev_actual_registration_count']"/></td>
                            <td class="text-right"><t t-esc="region_data['prev_registration_count_variance']"/></td>
                        </tr>
                        <tr t-att-class="total_class">
                            <td>Registered Value of Sales</td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['budget_registration_value'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['actual_registration_value'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['registration_value_variance'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['prev_actual_registration_value'])"/></td>
                            <td class="text-right"><t t-esc="'{:.2f}'.format(region_data['prev_registration_value_variance'])"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </template>
</odoo>