<odoo>

    <!-- ♦ PDF Template ♦ -->
    <template id="profit_reports_pdf">
        <main/>
        <t t-call="web.basic_layout">
            <style>
            .table td{ padding: .8px !important;
                        }
                        .row-size {
                            display: -webkit-box;
                            display: -webkit-flex;
                            display: flex;
                            padding: 0px 16px 0px 16px;
                            -webkit-flex-wrap: wrap;
                            flex-wrap: wrap;
                            margin-right: -16px;
                            margin-left: -16px;
                        }
                        .col-size-6 {
                            flex: 0 0 50%;
                            max-width: 50%;
                            border-left: 1px solid !important;
                            padding: unset !important;

                        }
                        .col-size-6.side-line {
                            border-right: 1px solid;
                        }
                        .col-size-6.bottom-line {
                            border-bottom: 1px solid;
                        }
                        .col-size-6.top-line {
                            border-top: 1px solid;
                        }
                        #tabl-td1{
                             padding: unset !important;
                        }
                        #tabl-td3{
                            padding: unset !important;
                        }
            </style>
            <t t-raw="report"/>
        </t>
    </template>

    <!-- ♦ Paper Format ♦ -->
    <record id="financial_reports_pdf_paper_format" model="report.paperformat">
        <field name="name">Financial Js Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">28</field>
        <field name="dpi">109</field>
    </record>

    <!-- ♦ Action ♦ -->
    <report id="profit_reports_pdf_action"
            model="profit.reports.pdf"
            string="Financial Reports"
            report_type="qweb-pdf"
            name="profit_loss_balance_sheet.profit_reports_pdf"
            file="profit_loss_balance_sheet.profit_reports_pdf"
            paperformat="profit_loss_balance_sheet.financial_reports_pdf_paper_format"

            menu="False"/>

</odoo>