<odoo>

    <!--  ♦ PDF Template ♦  -->
    <template id="rnd_register_pdf">
        <main/>
        <t t-call="web.basic_layout">
            <style>
                .table td{ padding: .8px !important;
                        }
                        .row-size {
                            display: -webkit-box;
                            display: -webkit-flex;
                            display: flex;
                            padding: 0px 16px 0px 16px;
                            -webkit-flex-wrap: wrap;
                            flex-wrap: wrap;
                            margin-right: -16px;
                            margin-left: -16px;
                        }
                        .col-size-6 {
                            flex: 0 0 50%;
                            max-width: 50%;
                            border-left: 1px solid !important;
                            padding: unset !important;

                        }
                        .col-size-67 {
                            flex: 0 0 50%;
                            max-width: 50%;
                            padding: unset !important;

                        }
            </style>
            <t t-raw="report"/>
        </t>
    </template>

    <!-- ♦ Paper Format ♦ -->
    <record id="rnd_register_pdf_paper_format" model="report.paperformat">
        <field name="name">RnD Register Js Paper Format</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">250</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">7</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">30</field>
    </record>

    <!-- ♦ Report Action ♦ -->
    <report id="rnd_register_pdf_action"
            model="rnd_register.pdf"
            string="R&amp;D Register"
            report_type="qweb-pdf"
            name="rnd_register.rnd_register_pdf"
            file="rnd_register.rnd_register_pdf"
            paperformat="rnd_register.rnd_register_pdf_paper_format"
            menu="False"/>

</odoo>