<odoo>

    <template id="general_ledger_pdf">
        <main/>
        <t t-call="web.basic_layout">
            <style type="text/css">
                .o_general_action a{
                text-decoration: none !important;
                color: inherit !important;
                }
                #tableId2{
                border: none;
                }
                tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid ;
                border-bottom: 1px solid ;
                }
                #tableId2 tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid ;
                }


                .text-right{
                text-align:right !important;
                }
                .text-left{
                text-align:left !important;
                }
                .text-center{
                text-align:center !important;
                }
                thead { display: table-header-group; }
                .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(0, 0, 0, 0.05) !important;
                }
                .daybook-table tr td{word-break: break-all; !important}
                .pagebreak{page-break-after:always}
                html,body{height:99% !important}
                @media pdf {
                .o_general_action a{
                text-decoration: none !important;
                color: inherit !important;
                }
                thead {display: table-row-group;}

                tbody tr:nth-of-type(#{$table-striped-order}) {
                background-color: $table-accent-bg;}
                .pagebreak{page-break-after:always
                border: 0px !important;
                }

                }
                @media print {
                .o_general_action a{
                text-decoration: none !important;
                color: inherit !important;
                }
                #branch{padding:0 !important;height: 145px;}
                .company_name{padding-top:0px !important}
                .pagebreak{page-break-after:always;
                border: 0px !important;}

                }
            </style>
            <t t-raw="report"/>
        </t>
    </template>

    <record id="general_ledger_pdf_paper_format" model="report.paperformat">
        <field name="name">General Ledger Js Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">28</field>
        <field name="dpi">109</field>
    </record>

    <record id="general_ledger_pdf_action" model="ir.actions.report">
        <field name="name">General Ledger</field>
        <field name="model">general.ledger.pdf</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">general_ledger_report.general_ledger_pdf</field>
        <field name="report_file">general_ledger_report.general_ledger_pdf</field>
        <field name="binding_model_id" ref="general_ledger_report.model_general_ledger_pdf"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="general_ledger_report.general_ledger_pdf_paper_format"/>
    </record>
</odoo>