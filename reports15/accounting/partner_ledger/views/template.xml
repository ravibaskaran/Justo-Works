                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
                  <div class="mb24 mt24" ><center>
                    <h4 class="text-center mb20 ">
                        Partner Ledger
                    </h4>
<!--                        <span style="position: absolute;right: 30px;" t-if="branch_name!=''">Branch : <t t-esc="branch_name"/></span>-->
                    <h6 style="font-size: 13px;" class="text-center">Date : <t t-esc="date_from" /> - <t t-esc="date_to" /></h6>
                    <!--<h6 class="text-center" t-if="accounts">Account : <t t-esc="accounts" /></h6>-->
                    <h6 style="font-size: 13px;" class="text-center" t-if="partners">Partners : <t t-esc="partners" /></h6>
                    </center>
                    </div>
               <table id="tableId2" rules="groups" frame="hsides" border="1"  class="table table-bordered table-striped"   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                   <style> .table td{ padding: .8px !important;} </style>
                        <thead>
                            <tr>
                                <th class="text-center" width="15%">Date</th>
                                <th class="text-left" width="20%">Voucher</th>
                                <th class="text-left" width="20%">Description</th>
                                <th class="text-right" width="15%">Debit</th>
                                <th class="text-right" width="15%">Credit</th>
                                <th class="text-right" width="15%" style="padding-right: 30px;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="account">
                                <tr t-if="lines[account]['name']" >
                                    <td colspan="6" class="text-center" style="padding-top:5px;padding-bottom:5px;font-size: 14px;font-weight: bold;"><span style=""><t t-esc="lines[account]['name']" /></span></td>
                                </tr>
                                <t t-foreach="lines[account]['data']" t-as="partner">
                                    <t t-set="balance" t-value="0" />
                                    <t t-set="total_debit" t-value="0" />
                                    <t t-set="total_credit" t-value="0" />
                                    <tr>
                                        <td colspan="6" class="text-left" style="padding-left:30px;font-size: 12px;font-weight: bold;"><t t-esc="lines[account]['data'][partner]['name']" /></td>
                                    </tr>
                                    <tr t-if="with_initial_balance">
                                        <td style="border-right: 1px solid white;"></td>
                                        <td colspan="2" style="padding-left:30px ;font-size: 12px;">Opening Balance</td>
                                        <td class="text-right" style="font-size: 12px;">
                                            <t t-esc="'{:.2f}'.format(lines[account]['data'][partner]['debit'])" />
                                            <t t-set="total_debit" t-value="total_debit + lines[account]['data'][partner]['debit']" />
                                        </td>
                                        <td class="text-right" style="font-size: 12px;">
                                            <t t-esc="'{:.2f}'.format(lines[account]['data'][partner]['credit'])" />
                                            <t t-set="total_credit" t-value="total_credit + lines[account]['data'][partner]['credit']" />
                                        </td>
                                        <td class="text-right" style="font-size: 12px;">
                                            <t t-set="opening" t-value="lines[account]['data'][partner]['credit'] - lines[account]['data'][partner]['debit']" />
                                            <t t-set="balance" t-value="balance + opening" />
                                            <t t-esc="'{:.2f}'.format(abs(opening))" />
                                            <t t-if="opening > 0">(Cr)</t>
                                            <t t-if="opening &lt; 0">(Dr)</t>
                                            <t t-if="opening == 0"><span style="visibility:hidden;">(Dr)</span></t>
                                        </td>
                                    </tr>
                                    <t t-foreach="lines[account]['data'][partner]['data']" t-as="row">
                                        <tr>
                                            <td class="text-left" style="padding-left:60px;padding-right:10px;font-size: 12px;"><t t-esc="row[0]" /></td>
                                            <td class="text-left" style="font-size: 12px;"><t t-esc="row[1]" /></td>
                                            <td class="text-left" style="font-size: 12px;"><t t-esc="row[2]" /></td>
                                            <td class="text-right" style="font-size: 12px;">
                                                <t t-esc="'{:.2f}'.format(row[4])" />
                                                <t t-set="total_debit" t-value="total_debit + row[4]" />
                                            </td>
                                            <td class="text-right" style="font-size: 12px;">
                                                <t t-esc="'{:.2f}'.format(row[3])" />
                                                <t t-set="total_credit" t-value="total_credit + row[3]" />
                                            </td>
                                            <td class="text-right" style="font-size: 12px;">
                                                <t t-set="line_balance" t-value="row[3] - row[4]" />
                                                <t t-set="balance" t-value="balance + line_balance" />
                                                <t t-esc="'{:.2f}'.format(abs(balance))" />
                                                <t t-if="balance > 0">(Cr)</t>
                                                <t t-if="balance &lt; 0">(Dr)</t>
                                                <t t-if="balance == 0"><span style="visibility:hidden;">(Dr)</span></t>
                                            </td>
                                        </tr>
                                    </t>
                                <tr>
                                    <td class="text-center" colspan="3"><strong>Total</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}'.format(total_debit)"/></strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}'.format(total_credit)"/></strong></td>
                                    <td class="text-right">
                                      <strong>
                                          <t t-esc="'{:.2f}'.format(abs(balance))" />
                                          <t t-if="balance > 0">(Cr)</t>
                                          <t t-if="balance &lt; 0">(Dr)</t>
                                          <t t-if="balance == 0"><span style="visibility:hidden;">(Dr)</span></t>
                                      </strong>
                                    </td>
                                </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
<!--            </t>-->

<!--        </t>-->
    </template>

</odoo>