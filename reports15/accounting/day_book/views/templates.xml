<odoo>
    <!--CHANGE THIS-->
    <template id="report_daybook">
        <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                border: none;
                }
                tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid ;
                border-bottom: 1px solid ;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid ;
                }
                .text-right{
                text-align:right !important;
                }
                .text-left{
                text-align:left !important;
                }
                .text-center{
                text-align:center !important;
                }
                thead { display: table-header-group; }
                .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(0, 0, 0, 0.05) !important;
                }
                .daybook-table tr td{word-break: break-all; !important}
                .pagebreak{page-break-after:always}
                html,body{height:99% !important}
                @media pdf {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                thead {display: table-row-group;}
                tbody tr:nth-of-type(#{$table-striped-order}) {
                background-color: $table-accent-bg;}
                .pagebreak{page-break-after:always
                }
                }
                @media print {
                a{
                text-decoration: none !important;
                color: inherit !important;
                }
                #branch{padding:0 !important;height: 145px;}
                .company_name{padding-top:0px !important}
                .pagebreak{page-break-after:always}}
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="6" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="mb24 mt24">
                <center>
                    <h4 class="text-center mb20 ">Daybook</h4>
                    <h6 style="font-size: 13px;" class="text-center">Date :
                        <t t-esc="date_from"/>
                        -
                        <t t-esc="date_to"/>
                    </h6>
                </center>
            </div>
            <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <tr>
                        <th class="text-left" width="25%">Description</th>
                        <th class="text-left" width="15%">Voucher</th>
                        <th class="text-left" width="25%">Partner</th>
                        <th class="text-right" width="15%">Debit</th>
                        <th class="text-right" width="15%">Credit</th>
                        <th class="text-center" width="5%">Type</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="details" t-as="date">
                        <t t-set="lines" t-value="details[date]"/>
                        <tr>
                            <td colspan="6" class="text-left">
                                <strong>
                                    <t t-esc="date"/>
                                </strong>
                            </td>
                        </tr>
                        <t t-foreach="lines['records']" t-as="move">
                            <tr t-foreach="lines['records'][move]['data']" t-as="record">
                                <td class="text-left">
                                    <t t-esc="lines['records'][move]['data'][record]['name']"/>
                                </td>
                                <td class="text-left">
                                    <a href="#" class="o_beta_report_action"
                                       t-att-data-res-id="lines['records'][move]['data'][record]['id']"
                                       t-att-data-model="lines['records'][move]['data'][record]['model']"
                                       t-att-data-form="lines['records'][move]['data'][record]['form']">
                                        <t t-esc="lines['records'][move]['data'][record]['move_name']"/>
                                    </a>
                                </td>
                                <td class="text-left">
                                    <t t-esc="lines['records'][move]['data'][record]['partner']"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(lines['records'][move]['data'][record]['debit'])"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(lines['records'][move]['data'][record]['credit'])"/>
                                </td>
                                <td class="text-center">
                                    <t t-esc="lines['records'][move]['data'][record]['type']"/>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td colspan="3" class="text-center">
                                <strong>Day Total</strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(lines['credit_total'])"/>
                                </strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(lines['debit_total'])"/>
                                </strong>
                            </td>
                            <td/>
                        </tr>
                        <t t-if="lines['cash_opening'][1] == 0">
                            <t t-set="day_open" t-value="-1 * lines['cash_opening'][0]"/>
                        </t>
                        <t t-else="">
                            <t t-set="day_open" t-value="lines['cash_opening'][1]"/>
                        </t>
                        <tr>
                            <td colspan="3" class="text-center">
                                <strong>Opening/Closing Balance</strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(day_open)"/>
                                </strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(lines['cash_closing'])"/>
                                </strong>
                            </td>
                            <td/>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-center">
                                <strong>Grand Total</strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(lines['credit_total'] + day_open)"/>
                                </strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(lines['debit_total'] + lines['cash_closing'])"/>
                                </strong>
                            </td>
                            <td/>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </template>
</odoo>