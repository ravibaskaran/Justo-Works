<odoo>
    <data>
        <record id="beta_register_marking_view_form" model="ir.ui.view">  <!--CHANGE THIS-->
            <field name="name">beta_register_marking_view_form</field>  <!--CHANGE THIS-->
            <field name="model">beta.register.making</field>  <!--CHANGE THIS-->
            <field name="arch" type="xml">
                <form string="beta_register_marking_form">
                    <div class="beta_main_panel" report="Register Marking">  <!--CHANGE THIS-->
                        <div class="m-0 row report_panel">
                            <div class="col-3 my-auto">
                                <a role="button" style="color: #FFFFFF; border-radius:6px; padding: 0.60rem 2rem;"
                                   title="Download Excel" id="beta_excel_print"
                                   class="btn btn-primary fa fa-file-excel-o mr-1">
                                    Excel
                                </a>
                                <a role="button" style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                   title="Print" class="btn btn-primary fa fa-print mr-1" type="button"
                                   id="beta_direct_print">
                                    Print
                                </a>
                                <button style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                        name="beta_pdf_print" type="object" id="beta_direct_pdf"
                                        class="btn btn-primary fa fa-file-pdf-o">
                                    PDF
                                </button>
                                <div style="padding-top: 3px;padding-left: 96px;" class="row">
                                    <button name="get_html" type="object" id="beta_get_report"
                                            style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 30px"
                                            class="btn btn-primary o_panel_get_report_beta">
                                        Get Report
                                    </button>
<!--                                    <span class="layout_icon px-3" title="click to change print layout (current:portrait)" style="padding-left: 30px !important;padding-top: 5px;" data-layout="false">-->
<!--                                        <i class="fa fa-mobile fa-2x" style="transition:0.5s"></i>-->
<!--                                    </span>-->
                                </div>
                            </div>
                            <field name="report_id" invisible="1"/>
                            <div class="col-9">
                                <div class="row mr-3">
                                    <div class="col-3">
                                        <div class="row">
                                            <div class="col-6">
                                                <strong>Date From </strong>
                                            </div>
                                            <div class="col-6">
                                                <field name="date_from" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong>Date To </strong>
                                            </div>
                                            <div class="col-6">
                                                <field name="date_to" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row" attrs="{'invisible': [('branch_exist', '=', False)]}">
                                            <div class="col-6">
                                                <strong>All Allowed Branches</strong>
                                            </div>
                                            <div class="col-6">
<!--                                                <field name="all_allowed_branches"/>-->
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Report Type </strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="report_type" required="1"/>
                                            </div>
                                        </div>

                                        <field name="branch_exist" invisible="1"/>
                                        <div attrs="{'invisible': [('branch_exist', '=', False)]}" class="row">
                                            <div class="col-4">
                                                <strong>Branch</strong>
                                            </div>
                                            <div class="col-8 branch_exist" style="height:43px !important">
                                                <field name="branch_id"
                                                       widget="many2many_tags"
                                                       options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edit": True}'/>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-4">
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Register </strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="register_id" options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edit": True}' required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-3">
                                                <strong attrs="{'invisible': [('report_type', '!=', 'selected_employee')]}">Employee </strong>
                                            </div>
                                            <div class="col-9">
                                         <field name="employee_ids"
                                               attrs="{'invisible': [('report_type', '!=', 'selected_employee')], 'required': [('report_type', '=', 'selected_employee')]}"
                                               widget="many2many_tags"
                                               options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edit": True}'/>
                                            </div>
<!--                                            <field name="layout" widget="boolean" invisible="1"/>-->
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="mt-4 template_div">
                            <div class="beta_template_area"/>
                            <field name="template_area" class="template_area d-none"/>
                        </div>
                        <script>
                            $(document).ready(function(){
                                $('.beta_template_area').append($('[name="template_area"]').val());
                                $('.dropdown_hide .dropdown-menu').removeClass('show');
                            })
                        </script>
                        <style>
                            html .o_web_client > .o_main .o_main_content .o_content{
                            overflow: overlay;
                            }
                            .o_form_view {
                            padding: 0 0 14px 0px !important;
                            background: #f9f9f9;
                            }
                            .report_panel{
                            padding-bottom: 1rem;
                            box-shadow: 0px 6px 7px #0000003b;
                            padding-top: 14px;
                            background: white;
                            position: fixed;
                            width: 98%;
                            z-index: 1;
                            top: 45px;
                            max-height: 160px;
                            }
                            .template_div{
                            padding-top: 8rem;
                            }
                            .o_field_widget.o_field_many2manytags .o_tag_color_0{
                            box-shadow: inset 0 0 0 1px #777777;
                            }
                            .o_field_widget.o_field_many2manytags .badge{
                            max-height: 16px;
                            font-size: 11px;
                            }
                            .o_field_widget.o_field_many2manytags .badge .o_badge_text{
                            max-width:180px !important;
                            }
                            .o_field_many2manytags {
                            align-items: stretch !important;
                            max-height: 48px;
                            height: 48px;
                            overflow-y: auto;
                            }
                            .template_div .table thead{
                            top: 99px;
                            }
                            .o_form_view .o_group.o_inner_group > tbody > tr > td.o_td_label{
                            min-width: 100px !important;
                            }
                            .o_field_widget .o_input_dropdown .o_input.ui-autocomplete-input{
                            height:100% !important;
                            }

                        </style>
                    </div>
                </form>
            </field>
        </record>

        <template id="beta_reports_pdf">
            <main/>
            <t t-call="web.basic_layout">
                <style>
                    .dropdown_hide{display: none;}
                </style>
                <t t-if="res_company">
                <div class="">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="15" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <span t-if="branch_names!=''">Branch :
                                                <t t-esc="branch_names"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="15">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
                <t t-raw="template_area"/>
            </t>
        </template>
        <!--CHANGE THIS-->
        <report id="beta_register_marking_reports_pdf_action"
                model="beta.register.making"
                string="Register Marking"
                report_type="qweb-pdf"
                name="beta_register_marking.beta_reports_pdf"
                file="beta_register_marking.beta_reports_pdf"
                paperformat="beta_reports_base.beta_reports_paper_format_portrait"
                menu="False"/>

        <record id="beta_register_marking_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">Register Marking</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">beta.register.making</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="context"
                   eval="{'default_report_id': ref('beta_register_marking.beta_register_marking_reports_pdf_action')}"/>  <!--CHANGE THIS-->
            <field name="target">inline</field>
        </record>
         <!-- <menuitem id="payroll_reports_main_menu" name="Reports" parent="om_hr_payroll.menu_hr_payroll_root"/> -->
        <menuitem id="beta_register_marking_menu"
                  action="beta_register_marking.beta_register_marking_action"
                  parent="beta_payroll_report.beta_payroll_report_main"
                  name="Statutory Register Report" sequence="2"/>
    </data>
</odoo>