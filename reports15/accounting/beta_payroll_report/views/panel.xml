<odoo>
    <data>
        <record id="beta_payroll_report_view_form" model="ir.ui.view">  <!--CHANGE THIS-->
            <field name="name">beta_payroll_report_view_form</field>  <!--CHANGE THIS-->
            <field name="model">beta.payroll.report</field>  <!--CHANGE THIS-->
            <field name="arch" type="xml">
                <form string="beta_payroll_report_form">
                    <div class="beta_main_panel" report="Payroll Report">  <!--CHANGE THIS-->
                        <div class="m-0 row report_panel">
                            <div class="col-3 my-auto">
                                <a role="button" style="color: #FFFFFF; border-radius:6px; padding: 0.60rem 2rem;"
                                   title="Download Excel" id="beta_excel_print"
                                   class="btn btn-primary fa fa-file-excel-o mr-1">
                                    Excel
                                </a>
                                <a role="button" style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                   title="Print" class="btn btn-primary fa fa-print mr-1" type="button"
                                   id="beta_direct_print">
                                    Print
                                </a>
                                <button style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                        name="beta_pdf_print" type="object"
                                        class="btn btn-primary fa fa-file-pdf-o">
                                    PDF
                                </button>
                                <div style="padding-top: 3px;padding-left: 96px;" class="row">
                                    <button name="get_html" type="object"
                                            style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 30px"
                                            class="btn btn-primary o_panel_get_report_beta">
                                        Get Report
                                    </button>
                                </div>
                            </div>
                            <field name="report_id" invisible="1"/>
                            <div class="col-9">
                                <div class="row mr-3">
                                    <div class="col-3">
                                        <div class="row">
                                            <div class="col-5">
                                                <strong>Date From</strong>
                                            </div>
                                            <div class="col-7" style="padding:unset;">
                                                <field name="date_from" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-5">
                                                <strong>Date To</strong>
                                            </div>
                                            <div class="col-7" style="padding:unset;">
                                                <field name="date_to" required="1"/>
                                            </div>
                                        </div>
                                         <field name="branch_exist" invisible="1"/>
                                        <div attrs="{'invisible': [('branch_exist', '=', False)]}" class="row">
                                            <div class="col-5">
                                                <strong>Branch</strong>
                                            </div>
                                            <div class="col-7" style="padding:unset;">
                                                <field name="branch_id"
                                                       options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edit": True}'/>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-3">
                                       <div class="row">
                                            <div class="col-5">
                                                <strong>Order By</strong>
                                            </div>
                                            <div class="col-7">
                                                <field name="order_by" widget="radio"   required="1"/>
                                            </div>
                                        </div>


                                    </div>
                                    <div class="col-5">
                                        <div class="row">
                                            <div class="col-5">
                                                <field name="selection" widget="radio" options="{'horizontal':true}"  required="1"/>
                                            </div>
                                             <div class="col-4">
                                                <field name="type" widget="radio" options="{'horizontal':true}"  attrs="{'invisible':[('selection','=','all')]}"/>
                                            </div>
                                        </div>
                                        <div class="row" attrs="{'invisible':['|',('selection','=','all'),('type','=','department')]}">
                                            <div class="col-3" >
                                                <strong>Employee</strong>
                                            </div>
                                            <div class="col-9" >
                                                <field name="employee_id"
                                                       attrs="{'required':[('selection','=','selection'),('type','=','employee')]}"
                                                       widget="many2many_tags"
                                                       options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edit": True}'/>
                                            </div>

                                        </div>
                                        <div class="row" attrs="{'invisible':['|',('selection','=','all'),('type','=','employee')]}">
                                            <div class="col-3" >
                                                <strong>Department</strong>
                                            </div>
                                            <div class="col-9" >
                                                <field name="department_id"
                                                       attrs="{'required':[('selection','=','selection'),('type','=','department')]}"
                                                       widget="many2many_tags"
                                                       options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edit": True}'/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 template_div">
                            <div class="beta_template_area"/>
                            <field name="template_area" class="d-none"/>
                        </div>
                        <script>
                            $(document).ready(function(){
                                $('.beta_template_area').append($('[name="template_area"]').val())
                            })
                        </script>
                        <style>
                            html .o_web_client > .o_action_manager > .o_action > .o_content{
                                overflow: overlay;
                            }
                            .o_form_view {
                                padding: 0 0 14px 0px !important;
                                background: #f9f9f9;
                            }
                            .report_panel{
                                padding-bottom: 1rem;
                                box-shadow: 0px 6px 7px #0000003b;
                                padding-top: 14px;
                                background: white;
                                position: fixed;
                                width: 98%;
                                z-index: 1;
                                top: 45px;
                                max-height: 150px;
                            }
                            .template_div{
                                padding-top: 8rem;
                            }
                            .o_field_widget.o_field_many2manytags .o_tag_color_0{
                                box-shadow: inset 0 0 0 1px #777777;
                            }
                            .o_field_widget.o_field_many2manytags .badge{
                                font-size: 11px;
                            }
                            .o_field_many2manytags {
                                max-height: 70px;
                                height: 70px;
                                overflow-y: auto;
                                width: 100%;
                            }
                            .o_field_widget.o_field_many2manytags .badge {
                                font-size: 11px;
                                max-width: 95%;
                                max-height: 17px;
                            }
                            .o_form_view .o_datepicker {
                                width: 100% !important;
                            }
                            .o_field_widget.o_field_many2manytags .badge .o_badge_text{
                                text-overflow: ellipsis;
                                width: 90%;
                            }
                            .template_div .table thead{
                                top: 100px;
                            }
                            [name='branch_id'] select {
                                display: none;
                            }


}
                        </style>
                    </div>
                </form>
            </field>
        </record>

        <template id="beta_reports_pdf">
            <main/>
            <t t-call="web.basic_layout">
                <t t-raw="template_area"/>
            </t>
        </template>

        <!--CHANGE THIS-->
        <report id="beta_payroll_report_reports_pdf_action"
                model="beta.payroll.report"
                string="Payroll Report"
                report_type="qweb-pdf"
                name="beta_payroll_report.beta_reports_pdf"
                file="beta_payroll_report.beta_reports_pdf"
                paperformat="beta_reports_base.beta_reports_paper_format_portrait"
                menu="False"/>

        <record id="beta_payroll_report_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">Payroll Report</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">beta.payroll.report</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context"
                   eval="{'default_report_id': ref('beta_payroll_report.beta_payroll_report_reports_pdf_action')}"/>  <!--CHANGE THIS-->
        </record>
        <menuitem id="beta_payroll_report_main" name="Reports" parent="om_hr_payroll.menu_hr_payroll_root" sequence="100"/>
        <menuitem id="beta_payroll_report_menu" parent="beta_payroll_report_main" action="beta_payroll_report.beta_payroll_report_action"/>
    </data>
</odoo>