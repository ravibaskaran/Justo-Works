<odoo>
    <!--CHANGE THIS-->
    <template id="report_payroll">
        <div id="wrapwrap" class="page mb80 " style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                    border: none;
                }

                #details-tbl tr th{
                    padding: 5px 10px;
                    border: none;
                    border-top: 1px solid #dee2e6;
                    border-bottom: 1px solid #dee2e6;
                }

                #details-tbl tr td{
                    padding: 3px 10px;
                    border: none;
                    border-bottom: 1px solid #dee2e6;
                }

                .text-right{
                    text-align:right !important;
                }

                .table-custom{
                    overflow: auto;
                    width: 100%;
                }
                .table-scroll{
                    overflow-x: scroll;
                    width: max-content;
                }

                 @media print {
                    *{
                        font-size:15px;
                    }
                }
            </style>

            <t t-if="res_company">
                <t t-set="colspan_header" t-value="len(lines['header']) + 5"/>
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td t-attf-colspan="{{ colspan_header }}" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td t-attf-colspan="{{ colspan_header }}" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td t-attf-colspan="{{ colspan_header }}" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td t-attf-colspan="{{ colspan_header }}" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td t-attf-colspan="{{ colspan_header }}" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td t-attf-colspan="{{ colspan_header }}" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td t-attf-colspan="{{ colspan_header }}">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div id="landscape_print" class="mb24 mt24 ">
                <center>
                    <h4 class="text-center mb20">Payroll Report</h4>

                    <h6 class="text-center">Date :
                        <t t-esc="date_from"/>
                        -
                        <t t-esc="date_to"/>
                    </h6>
                </center>
            </div>
            <table id="payroll_table" class="table  table-striped table-custom table-scroll "
                   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;border-collapse: collapse;" border="1">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <th class="center" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">Sno.</th>
                    <th class="center" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">Name</th>
                    <th class="center" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">Slip Number</th>
                    <th class="center" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">Date</th>
                    <t t-foreach="lines['header']" t-as="heading">
                        <th class="center" style="width: max-content;padding-left:10px !important;padding-right:10px !important;"><t t-esc="heading['name']"/></th>
                    </t>
                    <th class="center" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">Net Salary</th>
                </thead>

                <tbody>
                    <t t-set="slno" t-value="1"/>
                    <t t-set="grand_salary" t-value="0.00"/>
                    <t t-foreach="lines['body']['records']" t-as="body">
                        <t t-set="total_salary" t-value="0.00"/>
                        <tr >
                            <td></td>
                            <t t-set="colspan" t-value="len(lines['header']) + 4"/>
                            <td t-attf-colspan="{{ colspan }}" style="padding: 10px !important;font-size:16px;padding-left:10px!important;padding-right:10px !important;">
                                <strong>
                                    <t t-if="order_by == 'employee_wise'" t-esc="lines['body']['records'][body]['employee_name']"/>
                                    <t t-if="order_by == 'department_wise'" t-esc="lines['body']['records'][body]['department_name']"/>
                                    <t t-if="order_by == 'date_wise'" t-esc="lines['body']['records'][body]['date']"/>
                                </strong>
                            </td>


                        </tr>
                        <t t-foreach="lines['body']['records'][body]['row']" t-as="slip">

                            <tr>
                                <td class="center" style="width: max-content;white-space: nowrap;"><t t-esc="slno"/></td>
                               <td style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;"><t t-esc="lines['body']['records'][body]['row'][slip]['employee_name']"/></td>
                               <td style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">
                                   <a href="#" class="beta_redirect_action"
                                   t-att-data-res-id="slip"
                                   t-att-data-model="lines['body']['records'][body]['row'][slip]['model']"
                                   t-att-data-form="False">
                                   <t t-esc="lines['body']['records'][body]['row'][slip]['slip_number']"/>
                                   </a>
                               </td>
                               <td style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;"><t t-esc="lines['body']['records'][body]['row'][slip]['date']"/></td>
                                <t t-foreach="lines['header']" t-as="heading">
                                    <t t-if="heading['salary_rule_id'] in lines['body']['records'][body]['row'][slip]">
                                        <td class="text-right" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;"><t t-esc="'{:.2f}'.format(lines['body']['records'][body]['row'][slip][heading['salary_rule_id']]['total'])"/></td>
                                    </t>
                                    <t t-else="">
                                        <td class="text-right" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">0.00</td>
                                    </t>
                                </t>
                                <td class="text-right" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;">
                                    <t t-esc="'{:.2f}'.format(lines['body']['records'][body]['row'][slip]['net_salary'])"/>
                                    <t t-set="total_salary" t-value="total_salary + lines['body']['records'][body]['row'][slip]['net_salary']"/>
                                    <t t-set="grand_salary" t-value="grand_salary + lines['body']['records'][body]['row'][slip]['net_salary']"/>
                                </td>
                            </tr>
                            <t t-set="slno" t-value="slno + 1"/>
                        </t>
                        <tr>
                            <td></td>
                            <td class="center" colspan="3"> <strong> Total </strong> </td>

                            <t t-foreach="lines['header']" t-as="heading">

                                <t t-if="heading['salary_rule_id'] in lines['body']['records'][body]['grand_total']">
                                    <td class="text-right" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;"><strong><t t-esc="'{:.2f}'.format(lines['body']['records'][body]['grand_total'][heading['salary_rule_id']]['total'])"/></strong></td>
                                </t>
                                <t t-else="">
                                    <td class="text-right" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;"><strong>0.00</strong></td>
                                </t>

                            </t>
                            <td class="text-right" style="padding-left:10px !important;padding-right:10px !important;" > <strong> <t t-esc="'{:.2f}'.format(total_salary)"/> </strong> </td>


                        </tr>
                    </t>
                    <tr >
                        <td  class='center' colspan="4"><strong>Grand Total</strong></td>
                        <t t-foreach="lines['header']" t-as="heading">
                            <t t-if="heading['salary_rule_id'] in lines['body']['final_value']">
                                <td class="text-right" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;"><strong><t t-esc="'{:.2f}'.format(lines['body']['final_value'][heading['salary_rule_id']]['total'])"/></strong></td>
                            </t>
                            <t t-else="">
                                <td class="text-right" style="width: max-content;white-space: nowrap;padding-left:10px !important;padding-right:10px !important;"><strong>0.00</strong></td>
                            </t>
                        </t>
                        <td class="text-right" style="padding-left:10px !important;padding-right:10px !important;"><strong><t t-esc="'{:.2f}'.format(grand_salary)"/></strong></td>
                    </tr>
                </tbody>

            </table>
        </div>
    </template>

</odoo>