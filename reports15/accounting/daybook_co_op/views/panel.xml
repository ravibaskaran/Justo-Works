<odoo>
    <data>

        <!-- ♦ Daybook Form view ♦ -->
        <record id="daybook_co_op_view_form" model="ir.ui.view">  <!--CHANGE THIS-->
            <field name="name">daybook_co_op_view_form</field>  <!--CHANGE THIS-->
            <field name="model">beta.daybook.co.op</field>  <!--CHANGE THIS-->
            <field name="arch" type="xml">
                <form string="daybook_co_op_form">
                    <div class="beta_main_panel" report="DayBook Co Op">  <!--CHANGE THIS-->
                        <div class="m-0 row report_panel">

                            <div class="col-3 my-auto">

                                <!-- ♦ Excel Download ♦ -->
                                <a role="button" style="color: #FFFFFF; border-radius:6px; padding: 0.60rem 2rem;"
                                    title="Download Excel" id="beta_excel_print_daybook_co_op"
                                    class="btn btn-primary fa fa-file-excel-o mr-1">
                                    Excel
                                </a>

                                <!-- ♦ Print ♦ -->
                                <a role="button" style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                    title="Print" class="btn btn-primary fa fa-print mr-1" type="button"
                                    id="beta_direct_print">
                                    Print
                                </a>

                                <!-- ♦ PDF Download ♦ -->
<!--                                <button style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"-->
<!--                                    name="beta_pdf_print" type="object"-->
<!--                                    class="btn btn-primary fa fa-file-pdf-o">-->
<!--                                    PDF-->
<!--                                </button>-->
                                <a role="button" style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                    title="PDF Download" class="btn btn-primary fa fa-file-pdf-o mr-1" type="button"
                                    id="daybook_co_op_pdf_action">
                                    PDF
                                </a>

                                <div style="padding-top: 3px;padding-left: 96px;" class="row">

                                    <!-- ♦ Fetch Data ♦ -->
                                    <button name="get_html" type="object" id="temporary_table"
                                        style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 30px"
                                        class="btn btn-primary o_panel_get_report_beta">
                                        Get Report
                                    </button>

                                </div>
                            </div>
                            <field name="report_id" invisible="1"/>

                            <div class="col-9">
                                <div class="row mr-3">

                                    <!-- ♦ 1st Column ♦-->
                                    <div class="col-4">

                                        <!-- ♦ Date From ♦ -->
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Date From</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="date_from" required="1"/>
                                            </div>
                                        </div>

                                        <!-- ♦ Date To ♦ -->
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Date To</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="date_to" required="1"/>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- ♦ Content Area ♦ -->
                        <div class="mt-4 template_div">
                            <div class="beta_template_area"/>
                            <field name="template_area" class="d-none"/>
                        </div>

                        <!-- ♦ Form Script  ♦ -->
                        <script>
                            $(document).ready(function(){
                                $('.beta_template_area').append($('[name="template_area"]').val())
<!--                                $('span[name="date_from"]').click();-->
                            })
                        </script>

                        <!-- ♦ Form Style ♦ -->
                        <style>
                            html .o_web_client > .o_action_manager > .o_action > .o_content{
                                overflow: overlay;
                            }
                            .o_form_view {
                                padding: 0 0 14px 0px !important;
                                background: #f9f9f9;
                            }
                            .report_panel{
                                padding-bottom: 1rem;
                                box-shadow: 0px 6px 7px #0000003b;
                                padding-top: 14px;
                                background: white;
                                position: fixed;
                                width: 98%;
                                z-index: 1;
                                top: 45px;
                                max-height: 150px;
                            }
                            .template_div{
                                padding-top: 8rem;
                            }
                            .o_field_widget.o_field_many2manytags .o_tag_color_0{
                                box-shadow: inset 0 0 0 1px #777777;
                            }
                            .o_field_widget.o_field_many2manytags .badge{
                                font-size: 11px;
                            }
                            .o_field_many2manytags {
                                max-height: 70px;
                                height: 70px;
                                overflow-y: auto;
                                width: 100%;
                            }
                            .o_field_widget.o_field_many2manytags .badge {
                                font-size: 11px;
                                max-width: 95%;
                            }
                            .o_form_view .o_datepicker {
                                width: 100% !important;
                            }
                            .o_field_widget.o_field_many2manytags .badge .o_badge_text{
                                text-overflow: ellipsis;
                                width: 90%;
                            }
                            .template_div .table thead{
                                top: 95px;
                                position: sticky;
                                background: white;
                            }
                            [name='branch_id'] select {
                                display: none;
                            }
                        </style>

                    </div>
                </form>
            </field>
        </record>

        <!-- ♦ PDF Template ♦ -->
        <template id="beta_reports_pdf">
            <main/>
            <t t-call="web.basic_layout">
                <t t-raw="template_area"/>
            </t>
        </template>

        <!-- ♦ PDF Action ♦ -->
        <record id="daybook_co_op_reports_pdf_action" model="ir.actions.report">
            <field name="name">DayBook Co Op</field>
            <field name="model">beta.daybook.co.op</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">daybook_co_op.beta_reports_pdf</field>
            <field name="report_file">daybook_co_op.beta_reports_pdf</field>
            <field name="binding_model_id" ref="daybook_co_op.model_beta_daybook_co_op"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="beta_reports_base.beta_reports_paper_format_portrait"/>
        </record>

        <!-- ♦ Form Action ♦ -->
        <record id="daybook_co_op_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">DayBook Co Op</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">beta.daybook.co.op</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context" eval="{'default_report_id': ref('daybook_co_op.daybook_co_op_reports_pdf_action')}"/>  <!--CHANGE THIS-->
        </record>

    </data>
</odoo>