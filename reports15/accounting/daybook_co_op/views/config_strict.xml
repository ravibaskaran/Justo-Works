<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ♦ ▼ Inherited 'Configuration Setting'. Form View ▼ ♦-->
    <record id="daybook_config_1" model="ir.ui.view">
        <field name="name">daybook_config_1</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- ♦ Daybook Configuration ♦ -->
            <xpath expr="//div[hasclass('settings')]" position="inside">

                <h2>Daybook</h2>
                <div class="row mt16 o_settings_container" name="dayabook_entries_filter">

                    <!-- ♦ Daybook Filter ♦ -->
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="dayabook_entries_filter" class="o_light_label" force_save="1"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="dayabook_entries_filter" string="Daybook Filter"/>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>

</odoo>