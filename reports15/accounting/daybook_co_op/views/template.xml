            <!-- Notes: Resize the side by side table-->
            <script>
                function resizeHandler() {

                    // Purpose: Treat each container separately
                    $(".container_div").each(function(i, container_div) {

                        // Purpose: Stores the highest rowheight for all tables in this container, per row
                        var aRowHeights = [];

                        // Purpose: Loop through the tables
                        $(container_div).find("table").each(function(indx, table) {

                            // Purpose: Loop through the rows of current table (clear their css height value)
                            $(table).find("tr").css("height", "").each(function(i, tr) {

                            // Purpose: If there is already a row height defined
                            if (aRowHeights[i])

                                // Purpose: Replace value with height of current row if current row is higher.
                                aRowHeights[i] = Math.max(aRowHeights[i], $(tr).height());
                            else

                                // Purpose: Else set it to the height of the current row
                                aRowHeights[i] = $(tr).height();
                            });
                        });

                        // Purpose: Loop through the tables in this container separately again
                        $(container_div).find("table").each(function(i, table) {

                            // Purpose: Set the height of each row to the stored greatest height.
                            $(table).find("tr").each(function(i, tr) {
                                $(tr).css("height", aRowHeights[i]);
                            });
                        });
                    });
                }
                function print_table() {
                    $(".container_div").each(function(i, container_div){
                        var table1_rows = $(container_div).find(".div_1").find("table tbody tr:visible")
                        var table2_rows = $(container_div).find(".div_2").find("table tbody tr:visible")
                        for(var i=0; i &lt; table1_rows.length; i++){
                            var tr = "&lt;tr&gt;"
                            for(var j =0; j &lt; $($(table1_rows[i])[0].cells).length; j++){
                                tr += $($(table1_rows[i])[0].cells)[j].outerHTML
                            }
                            for(var k =0; k &lt; $($(table2_rows[i])[0].cells).length; k++){
                                tr += $($(table2_rows[i])[0].cells)[k].outerHTML
                            }
                            tr += "&lt;/tr&gt;"
                            $('#'+ $(container_div).find(".on_print")[0].id + ' tbody').append(tr);
                        }
                    })
                    $('.div_1').hide()
                    $('.div_2').hide()
                    $('.on_print').show()
                }
                $(document).ready(print_table);
                $(window).resize(print_table);
                $(document).ready(resizeHandler);
                $(window).resize(resizeHandler);

            </script>


