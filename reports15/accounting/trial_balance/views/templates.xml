<odoo>
    <!--CHANGE THIS-->
    <template id="report_trial_balance">
        <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #details-tbl{
                border: none;
                }
                #details-tbl tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #details-tbl tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="4" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="mb24 mt24">
                <center>
                    <h4 class="text-center mb20 ">Trial Balance</h4>
                    <t t-if="data['date_from']">
                        <strong>Date from :</strong>
                        <span t-esc="data['date_from']"/>
                    </t>
                    <t t-if="data['date_to']">&#160;-&#160;<strong>Date to :</strong>
                        <span t-esc="data['date_to']"/>
                    </t>
                </center>
            </div>
            <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Account</th>
                        <t t-if="docs['opening'] and not docs['without_opening']">
                            <t t-set="opening_tot" t-value="0"/>
                            <th class="text-right">Opening</th>
                        </t>
                        <th class="text-right">Debit</th>
                        <t t-set="debit_tot" t-value="0"/>
                        <th class="text-right">Credit</th>
                        <t t-set="credit_tot" t-value="0"/>
                        <t t-if="not docs['opening'] and not docs['without_opening']"/>
                        <t t-if="docs['opening']">
                            <t t-set="balance_tot" t-value="0"/>
                            <th class="text-right">Balance</th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="i" t-value="0"/>
                    <t t-if="auto_unfold or order == 'schedule'">
                        <t t-if="auto_unfold">
                            <t t-set="style2" t-value="'display:none;'"/>
                            <t t-set="direction" t-value="'right'"/>
                        </t>
                        <t t-else="">
                            <t t-set="style2" t-value="'abc'"/>
                            <t t-set="direction" t-value="'down'"/>
                        </t>
                        <t t-foreach="Accounts" t-as="account">
                            <t t-if="'name' not in account" t-set="id" t-value="account['id']"/>
                            <tr t-if="'name' not in account" class="parent" t-att-id="'row123'+ id"
                                title="Click to expand/collapse" style="cursor: pointer;">
                                <td t-att-colspan="2">
                                    <strong>
                                        <span class="o_trial_reports_foldable 1 o_trial_reports_caret_icon">
                                            <i t-att-class="'fa fa-fw fa-caret-'+ direction" role="img"
                                               aria-label="Fold" title="Fold" style="width: 30px;"/>
                                        </span>
                                        <span t-att-style="style" t-esc="account['type']"/>
                                    </strong>
                                </td>
                                <t t-if="account['opening'] and not account['without_opening']">
                                    <td/>
                                </t>
                                <td class="text-right">
                                    <strong>
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(account['total_debit'])"/>
                                    </strong>
                                </td>
                                <td class="text-right">
                                    <strong>
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(account['total_credit'])"/>
                                    </strong>
                                </td>
                                <t t-if="account['opening'] and not account['without_opening']">
                                    <td/>
                                </t>
                                <t t-if="account['opening'] and account['without_opening']">
                                    <td/>
                                </t>
                            </tr>
                            <tr t-else="" t-att-class="'child-row123'+id" t-att-style="style2">
                                <td>
                                    <span t-att-style="style" t-esc="account['code']"/>
                                </td>
                                <td>
                                    <span style="color: white;" t-esc="'..'"/>
                                    <span t-att-style="style" t-esc="account['name']"/>
                                </td>
                                <t t-if="docs['opening'] and not docs['without_opening']">
                                    <td class="text-right">
                                        <t t-set="opening_tot" t-value="opening_tot+account['opening']"/>
                                        <span t-esc="'{0:,.2f}'.format(account['opening'])"/>
                                    </td>
                                </t>
                                <td class="text-right">
                                    <t t-set="debit_tot" t-value="debit_tot+account['debit']"/>
                                    <span t-att-style="style" t-esc="'{0:,.2f}'.format(account['debit'])"/>
                                </td>
                                <td class="text-right">
                                    <t t-set="credit_tot" t-value="credit_tot+account['credit']"/>
                                    <span t-att-style="style" t-esc="'{0:,.2f}'.format(account['credit'])"/>
                                </td>
                                <t t-if="not docs['opening'] and not docs['without_opening']"/>
                                <t t-if="docs['opening']">
                                    <td class="text-right">
                                        <t t-set="balance_tot" t-value="balance_tot+account['balance']"/>
                                        <span t-esc="'{0:,.2f}'.format(account['balance'])"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-foreach="Accounts" t-as="account">
                            <tr t-if="'name' not in account">
                                <td t-att-colspan="4">
                                    <strong>
                                        <span t-att-style="style" t-esc="account['type']"/>
                                    </strong>
                                </td>
                            </tr>
                            <t t-else="">
                                <tr t-if="account['debit'] != 0.00 or account['credit'] !=0.00">
                                    <td>
                                        <span t-att-style="style" t-esc="account['code']"/>
                                    </td>
                                    <td>
                                        <span style="color: white;" t-esc="'..'"/>
                                        <span t-att-style="style" t-esc="account['name']"/>
                                    </td>
                                    <t t-if="docs['opening'] and not docs['without_opening']">
                                        <td class="text-right">
                                            <t t-set="opening_tot" t-value="opening_tot+account['opening']"/>
                                            <span t-esc="'{0:,.2f}'.format(account['opening'])"/>
                                        </td>
                                    </t>
                                    <td class="text-right">
                                        <t t-set="debit_tot" t-value="debit_tot+account['debit']"/>
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(account['debit'])"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-set="credit_tot" t-value="credit_tot+account['credit']"/>
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(account['credit'])"/>
                                    </td>
                                    <t t-if="not docs['opening'] and not docs['without_opening']"/>
                                    <t t-if="docs['opening']">
                                        <td class="text-right">
                                            <t t-set="balance_tot" t-value="balance_tot+account['balance']"/>
                                            <span t-esc="'{0:,.2f}'.format(account['balance'])"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </t>
                    </t>
                    <tr>
                        <td t-att-colspan="2" class="text-center b">Total</td>
                        <t t-if="docs['opening'] and not docs['without_opening']">
                            <td class="text-right b">
                                <span t-esc="'{0:,.2f}'.format(opening_tot)"/>
                            </td>
                        </t>
                        <td class="text-right b">
                            <span t-esc="'{0:,.2f}'.format(debit_tot)"/>
                        </td>
                        <td class="text-right b">
                            <span t-esc="'{0:,.2f}'.format(credit_tot)"/>
                        </td>
                        <t t-if="docs['opening'] ">
                            <td class="text-right b">
                                <span t-esc="'{0:,.2f}'.format(balance_tot)"/>
                            </td>
                        </t>
                    </tr>
                    <t t-if="not docs['opening'] and not docs['without_opening']">
                        <tr>
                            <td t-att-colspan="2" class="text-center b">Trial Difference</td>
                            <td t-att-colspan="2" class="text-right b">
                                <span t-esc="'{0:,.2f}'.format(debit_tot-credit_tot)"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <style>
                .b{font-weight:bold;}
                .table tbody tr:hover {
                background-color: #add8e6;
                }
            </style>
            <script>$(document).ready(function()
                {
                $('.o_trial_reports_caret_icon').click(function()
                {
                var clickedShape = $(this);
                console.log($(this).children('i').first(),"First");
                if ($(this).children('i').first().hasClass('fa-caret-right')){
                $(this).children('i').first().removeClass('fa-caret-right');
                $(this).children('i').first().addClass('fa-caret-down');
                $(this).closest('tr').click();
                $(this).closest('tr')
                .css("cursor", "pointer")
                .attr("title", "Click to expand/collapse")
                .click(function () {
                $(this).siblings('.child-' + this.id).toggle();
                });
                }
                else{
                $(this).children('i').first().removeClass('fa-caret-down');
                $(this).children('i').first().addClass('fa-caret-right');
                $(this).closest('tr').click();
                $(this).closest('tr')
                .css("cursor", "pointer")
                .attr("title", "Click to expand/collapse")
                .click(function () {
                $(this).siblings('.child-' + this.id).toggle();
                });
                }
                });
                });
            </script>
        </div>
    </template>
</odoo>