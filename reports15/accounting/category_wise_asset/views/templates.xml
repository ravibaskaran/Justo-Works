<odoo>
    <!--CHANGE THIS-->
    <template id="report_category_wise_asset">
        <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #summarys-tbl{
                    border: none;
                }
                #summarys-tbl tr th{
                    padding: 5px 10px;
                    border: none;
                    border-top: 1px solid #dee2e6;
                    border-bottom: 1px solid #dee2e6;
                }
                #summarys-tbl tr td{
                    padding: 3px 10px;
                    border: none;
                    border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                    text-align:right !important;
                }
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="15" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center" class="mb4 text-center">
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="15" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="15">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="mb24 mt24">
                <center>
                    <h4 class="text-center mb20">Category Wise Asset Report</h4>
                    <h6 class="text-center">Date From :
                        <t t-esc="date"/>
                        Date To :
                        <t t-esc="date_to"/>
                    </h6>
                </center>
            </div>
            <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped" style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <tr>
                        <th style="text-align: center;" width="5%">Sno</th>
                        <th style="text-align: center;" width="10%">Nomenculture</th>
                        <th style="text-align: center;" width="10%">Make &amp; Type</th>
                        <th style="text-align: center;" width="10%">Ser Number/Regd Number</th>
                        <th style="text-align: center;" width="10%">Date of Procurement</th>
                        <th style="text-align: center;" width="10%">Holder</th>
                        <th style="text-align: center;" width="10%">Appointment/Task</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="lines">
                        <t t-foreach="lines['docsnn']" t-as="doc">
                            <t t-if="doc['name'] == 5">
                                <tr>
                                    <t t-set="i" t-value="1"/>
                                    <td></td>
                                    <td class="text-left" colspan="6">
                                        <h5 style="!important;font-weight:bold;font-size: 1.0rem;margin-top:7px;margin-bottom:7px;" t-esc="doc['category_name']"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="doc['name'] == 1">
                                <tr>
                                    <td class="text-center">
                                        <span t-esc="i"/>
                                    </td>

                                    <td class="text-left">
                                        <span t-esc="doc['asset_name']"/>
                                    </td>

                                    <td class="text-left">
                                        <span t-esc="doc['make']"/>
                                    </td>

                                    <td class="text-left">
                                        <span t-esc="doc['ser_number']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="doc['date']"/>
                                    </td>

                                    <td class="text-left">
                                        <span t-esc="doc['holder']"/>
                                    </td>
                                    <td class="text-left">
                                        <span t-esc="doc['purpose']"/>
                                    </td>
                                    <t t-set="i" t-value="i+1"/>
                                </tr>
                            </t>
                        </t>
                    </t>
                </tbody>
            </table>
        </div>
    </template>
</odoo>