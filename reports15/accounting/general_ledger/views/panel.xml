<odoo>
    <data>
        <record id="general_ledger_view_form" model="ir.ui.view">  <!--CHANGE THIS-->
            <field name="name">general_ledger_view_form</field>  <!--CHANGE THIS-->
            <field name="model">beta.general.ledger</field>  <!--CHANGE THIS-->
            <field name="arch" type="xml">
                <form string="general_ledger_form">
                    <div class="beta_main_panel" report="General Ledger">  <!--CHANGE THIS-->
                        <div class="m-0 row report_panel d-none">
                            <div class="col-3 my-auto">
                                <a role="button" style="color: #FFFFFF; border-radius:6px; padding: 0.60rem 2rem;"
                                   title="Download Excel" id="beta_excel_print"
                                   class="btn btn-primary fa fa-file-excel-o mr-1">
                                    Excel
                                </a>
                                <a role="button" style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                   title="Print" class="btn btn-primary fa fa-print mr-1" type="button"
                                   id="beta_direct_print">
                                    Print
                                </a>
                                <button style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 2rem"
                                        name="beta_pdf_print" type="object"
                                        class="btn btn-primary fa fa-file-pdf-o">
                                    PDF
                                </button>
                                <div style="padding-top: 3px;padding-left: 96px;" class="row">
                                    <button name="get_html" type="object"
                                            style="color: #FFFFFF; border-radius:6px;padding: 0.60rem 30px"
                                            class="btn btn-primary o_panel_get_report_beta">
                                        Get Report
                                    </button>
                                </div>
                            </div>
                            <field name="report_id" invisible="1"/>
                            <div class="col-9">
                                <div class="row mr-3">
                                    <div class="col-4">
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Date From</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="date_from" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Date To</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="date_to" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Opening</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="with_initial" required="1"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="row">
                                            <div class="col-4">
                                                <strong>Accounts</strong>
                                            </div>
                                            <div class="col-8">
                                                <field name="account_ids" widget="many2many_tags"
                                                       options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edit": True}'
                                                       required="1"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="row">
                                            <div class="col-5">
                                                <strong>Day Summary</strong>
                                            </div>
                                            <div class="col-7">
                                                <field name="day_summary" required="1"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-5">
                                                <strong>Month Summary</strong>
                                            </div>
                                            <div class="col-7">
                                                <field name="month_summary" required="1"/>
                                            </div>
                                        </div>
                                        <div attrs="{'invisible': [('month_summary', '=', True)]}" class="row">
                                            <div class="col-5">
                                                <strong>Month Total</strong>
                                            </div>
                                            <div class="col-7">
                                                <field name="month_total" required="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 template_div">
                            <div class="beta_template_area"/>
                            <field name="template_area" class="d-none"/>
                        </div>
                        <script>
                            $(document).ready(function(){
                            $('.beta_template_area').append($('[name="template_area"]').val())
<!--                            $('span[name="date_from"]').click();-->
                            if($('.o_cp_top').length>0){
                            $('.report_panel').css('top', '90px');
                            $('.report_panel').removeClass('d-none');
                            }else{
                            $('.report_panel').removeClass('d-none');
                            }
                            })
                        </script>
                        <style>
                            .o_cp_bottom{
                            display: none !important;
                            }
                            html .o_web_client > .o_action_manager > .o_action > .o_content{
                            overflow: overlay;
                            }
                            .o_form_view {
                            padding: 0 0 14px 0px !important;
                            background: #f9f9f9;
                            }
                            .report_panel{
                            padding-bottom: 1rem;
                            box-shadow: 0px 6px 7px #0000003b;
                            padding-top: 14px;
                            background: white;
                            position: fixed;
                            width: 98%;
                            z-index: 1;
                            top: 45px;
                            max-height: 150px;
                            }
                            .template_div{
                            padding-top: 8rem;
                            }
                            .o_field_widget.o_field_many2manytags .o_tag_color_0{
                            box-shadow: inset 0 0 0 1px #777777;
                            }
                            .o_field_widget.o_field_many2manytags .badge{
                            font-size: 11px;
                            }
                            .o_field_many2manytags {
                            max-height: 70px;
                            height: 70px;
                            overflow-y: auto;
                            width: 100%;
                            }
                            .o_field_widget.o_field_many2manytags .badge {
                            font-size: 11px;
                            max-width: 95%;
                            height: 19px;
                            }
                            .o_form_view .o_datepicker {
                            width: 100% !important;
                            }
                            .o_field_widget.o_field_many2manytags .badge .o_badge_text{
                            text-overflow: ellipsis;
                            width: 90%;
                            }
                            .template_div .table thead{
                            top: 110px;
                            position: sticky;
                            background: white;
                            }
                            [name='branch_id'] select {
                            display: none;
                            }
                        </style>
                    </div>
                </form>
            </field>
        </record>

        <template id="beta_reports_pdf">
            <main/>
            <t t-call="web.basic_layout">
                <t t-raw="template_area"/>
            </t>
        </template>

        <!--CHANGE THIS-->
        <record id="general_ledger_reports_pdf_action" model="ir.actions.report">
            <field name="name">General Ledger</field>
            <field name="model">beta.general.ledger</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">general_ledger.beta_reports_pdf</field>
            <field name="report_file">general_ledger.beta_reports_pdf</field>
            <field name="binding_model_id" ref="general_ledger.model_beta_general_ledger"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="beta_reports_base.beta_reports_paper_format_portrait"/>
        </record>

        <record id="general_ledger_action" model="ir.actions.act_window">  <!--CHANGE THIS-->
            <field name="name">General Ledger</field>  <!--CHANGE THIS-->
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">beta.general.ledger</field>  <!--CHANGE THIS-->
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context" eval="{'default_report_id': ref('general_ledger.general_ledger_reports_pdf_action')}"/>  <!--CHANGE THIS-->
        </record>

    </data>
</odoo>