<odoo>
    <!--CHANGE THIS-->
    <template id="report_general_ledger">
        <div id="wrapwrap" class="page mb80" style="padding-right: 15px;padding-left: 15px;">
            <style type="text/css">
                #tableId2{
                border: none;
                }
                #tableId2 tr th{
                padding: 5px 10px;
                border: none;
                border-top: 1px solid #dee2e6;
                border-bottom: 1px solid #dee2e6;
                }
                #tableId2 tr td{
                padding: 3px 10px;
                border: none;
                border-bottom: 1px solid #dee2e6;
                }
                .text-right{
                text-align:right !important;
                }
                @media pdf {
                .o_beta_report_action a{
                text-decoration: none !important;
                color: inherit !important;
                }
                thead {display: table-row-group;}
                .pagebreak tfoot { border-top: 1px solid !important; display: table-footer-group !important; }
                tbody tr:nth-of-type(#{$table-striped-order}) {
                background-color: $table-accent-bg;}
                .pagebreak{display: block;page-break-after:always
                }
                }
                @media print {
                .o_beta_report_action a{
                text-decoration: none !important;
                color: inherit !important;
                }
                .pagebreak{page-break-after:always}}
                .pagebreak tfoot { border-top: 1px solid !important; display: table-footer-group !important; }
            </style>
            <t t-if="res_company">
                <div class="header">
                    <table t-if="day_summary==False and monthSummary==False" class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="7" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="7">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <table t-else="" class="" width="100%">
                        <tr class="company_info" style="height:130px !important;">
                            <td id="logo_company" class="text-center logo_company" colspan="0"
                                style="float: left;position: absolute;">
                                <div id="img_logo" style="float:left;padding-top: 3px;padding-left: 20px;" class="mb4">
                                    <img style="width: 100px;" t-if="res_company.logo"
                                         t-att-src="image_data_uri(res_company.logo)" alt="Logo"/>
                                </div>
                            </td>
                            <td colspan="5" style="float: left;width: 100%;text-align: center;">
                                <table width="100%" style="margin-top: 12px;text-align:center"
                                       class="mb4 text-center">
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            <h4 style="margin:0;color:#1155cc;font-size: 1.2rem;">
                                                <span t-esc="res_company.name"/>
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-esc="res_company.street"/>,
                                                <span t-esc="res_company.street2"/>,
                                                <span t-esc="res_company.city"/>,
                                                <span t-esc="res_company.state_id.name"/>,
                                                <span t-esc="res_company.country_id.name"/>-
                                                <span t-esc="res_company.zip"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            <p style="margin-bottom:0;">
                                                <span t-if="res_company.phone" style="padding-right:15px">Phone :
                                                    <span t-esc="res_company.phone"/>
                                                </span>
                                                <span t-if="res_company.email">
                                                    Email :
                                                    <span t-esc="res_company.email"/>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            <p t-if="res_company.vat">
                                                <span class="list-inline-item d-inline">
                                                    GSTIN
                                                    :
                                                </span>
                                                <span t-esc="res_company.vat"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            <span t-if="branch_name!=''">Branch :
                                                <t t-esc="branch_name"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5">
                                <div class="row zero_min_height">
                                    <div class="col-12">
                                        <div style="border-bottom: 1px solid #000;"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div class="mb24 mt24">
                <center>
                    <h4 class="text-center mb20">General Ledger</h4>
                    <h6 style="font-size: 13px;" class="text-center">Date :
                        <t t-esc="date_from"/>
                        -
                        <t t-esc="date_to"/>
                    </h6>
                </center>
            </div>
            <table id="tableId2" rules="groups" frame="hsides" border="1" class="table table-bordered table-striped"
                   style="width: 100%;font-size:12px;border-top: 2px solid black;margin-top:10px;">
                <style>.table td{ padding: .8px !important;}</style>
                <thead>
                    <tr>
                        <t t-if="day_summary==False and monthSummary==False">
                            <th class="text-left" width="13%">Date</th>
                            <th class="text-left" width="18%">Partner</th>
                            <th class="text-left" width="14%">Voucher</th>
                            <th class="text-left" width="15%">Description</th>
                        </t>
                        <t t-else="">
                            <th class="text-left" width="60%">Date</th>
                        </t>
                        <th class="text-right" width="13%">Debit</th>
                        <th class="text-right" width="13%">Credit</th>
                        <th class="text-right" width="13%">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="account">
                        <t t-set="balance" t-value="0"/>
                        <t t-set="total_debit" t-value="0"/>
                        <t t-set="total_credit" t-value="0"/>
                        <tr>
                            <t t-if="day_summary==False and monthSummary==False">
                                <td colspan="7" class="text-left" style="padding-left:10px;font-size: 14px;">
                                    <strong>
                                        <t t-esc="lines[account]['name']"/>
                                    </strong>
                                </td>
                            </t>
                            <t t-else="">
                                <td colspan="4" class="text-left" style="padding-left:10px;font-size: 14px;">
                                    <strong>
                                        <t t-esc="lines[account]['name']"/>
                                    </strong>
                                </td>
                            </t>
                        </tr>
                        <tr t-if="with_initial_balance">
                            <t t-if="day_summary==False and monthSummary==False">
                                <td style="border-right: 1px solid white;"/>
                                <td colspan="3" style="padding-left:30px ;font-size: 12px;">Opening Balance</td>
                            </t>
                            <t t-else="">
                                <td style="padding-left:30px ;font-size: 12px;">Opening Balance</td>
                            </t>
                            <td class="text-right">
                                <t t-esc="'{:.2f}'.format(lines[account]['debit'])"/>
                                <t t-set="total_debit" t-value="total_debit + lines[account]['debit']"/>
                            </td>
                            <td class="text-right">
                                <t t-esc="'{:.2f}'.format(lines[account]['credit'])"/>
                                <t t-set="total_credit" t-value="total_credit + lines[account]['credit']"/>
                            </td>
                            <td class="text-right">
                                <t t-set="opening" t-value="lines[account]['credit'] - lines[account]['debit']"/>
                                <t t-set="balance" t-value="balance + opening"/>
                                <t t-esc="'{:.2f}'.format(abs(opening))"/>
                                <t t-if="opening > 0">(Cr)</t>
                                <t t-if="opening &lt; 0">(Dr)</t>
                                <t t-if="opening == 0">
                                    <span style="visibility:hidden;">(Dr)</span>
                                </t>
                            </td>
                        </tr>
                        <t t-set="j" t-value="True"/>
                        <t t-set="z2" t-value="True"/>
                        <t t-set="month_total_debit" t-value="0"/>
                        <t t-set="month_total_credit" t-value="0"/>
                        <t t-set="month_balance" t-value="0"/>
                        <t t-foreach="lines[account]['data']" t-as="row">
                            <t t-if="j and monthTotal">
                                <t t-set="date1" t-value="lines[account]['data'][row]['date']"/>
                                <t t-set="j" t-value="False"/>
                                <t t-set="d" t-value="datetime.datetime.strptime(date1, '%d-%m-%Y')"/>
                                <t t-set="m" t-value="d.strftime('%B')"/>
                                <t t-set="y" t-value="str(d.year)"/>
                                <t t-set="z" t-value="m + '-' + y"/>
                            </t>
                            <t t-if="monthTotal">
                                <t t-set="date2" t-value="lines[account]['data'][row]['date']"/>
                                <t t-set="j2" t-value="False"/>
                                <t t-set="d2" t-value="datetime.datetime.strptime(date2, '%d-%m-%Y')"/>
                                <t t-set="m2" t-value="d2.strftime('%B')"/>
                                <t t-set="y2" t-value="str(d2.year)"/>
                                <t t-set="z2" t-value="m2 + '-' + y2"/>
                                <t t-if="z2 != z">
                                    <tr style="font-weight:bold;">
                                        <t t-if="day_summary==False and monthSummary==False">
                                            <td colspan="4" class="text-center"><t t-esc='z'/>-(Total)
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td class="text-center"><t t-esc='z'/>-(Total)
                                            </td>
                                        </t>
                                        <td class="text-right">
                                            <t t-esc="'{:.2f}'.format(month_total_debit)"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="'{:.2f}'.format(month_total_credit)"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="'{:.2f}'.format(abs(month_balance))"/>
                                            <t t-if="month_balance > 0">(Cr)</t>
                                            <t t-if="month_balance &lt; 0">(Dr)</t>
                                            <t t-if="month_balance == 0">
                                                <span style="visibility:hidden;">(Dr)</span>
                                            </t>
                                        </td>
                                    </tr>
                                    <t t-set="date1" t-value="lines[account]['data'][row]['date']"/>
                                    <t t-set="j" t-value="False"/>
                                    <t t-set="d" t-value="datetime.datetime.strptime(date1, '%d-%m-%Y')"/>
                                    <t t-set="m" t-value="d.strftime('%B')"/>
                                    <t t-set="y" t-value="str(d.year)"/>
                                    <t t-set="z" t-value="m + '-' + y"/>
                                    <t t-set="month_total_debit" t-value="0"/>
                                    <t t-set="month_total_credit" t-value="0"/>
                                    <t t-set="month_balance" t-value="0"/>
                                </t>
                            </t>
                            <tr>
                                <td class="text-left" style="padding-left:40px;padding-right:0;">
                                    <t t-esc="lines[account]['data'][row]['date']"/>
                                </td>
                                <t t-if="day_summary==False and monthSummary==False">
                                    <td class="text-left">
                                        <t t-esc="lines[account]['data'][row]['partner']"/>
                                    </td>
                                    <td>
                                        <a href="#" class="o_beta_report_action"
                                           t-att-data-res-id="lines[account]['data'][row]['move_id']"
                                           t-att-data-model="lines[account]['data'][row]['model']"
                                           t-att-data-form="lines[account]['data'][row]['form']" style="text-decoration: none !important;
                                  color: inherit !important;">
                                            <t t-esc="lines[account]['data'][row]['move']"/>
                                        </a>
                                    </td>
                                    <td class="text-left">
                                        <t t-esc="lines[account]['data'][row]['remarks']"/>
                                    </td>
                                </t>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(lines[account]['data'][row]['debit'])"/>
                                    <t t-set="total_debit"
                                       t-value="total_debit + lines[account]['data'][row]['debit']"/>
                                    <t t-set="month_total_debit"
                                       t-value="month_total_debit + lines[account]['data'][row]['debit']"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(lines[account]['data'][row]['credit'])"/>
                                    <t t-set="total_credit"
                                       t-value="total_credit + lines[account]['data'][row]['credit']"/>
                                    <t t-set="month_total_credit"
                                       t-value="month_total_credit + lines[account]['data'][row]['credit']"/>
                                </td>
                                <td class="text-right">
                                    <t t-set="line_balance"
                                       t-value="lines[account]['data'][row]['credit'] - lines[account]['data'][row]['debit']"/>
                                    <t t-set="balance" t-value="balance + line_balance"/>
                                    <t t-set="month_balance" t-value="month_balance + line_balance"/>
                                    <t t-esc="'{:.2f}'.format(abs(balance))"/>

                                    <t t-if="balance > 0">(Cr)</t>
                                    <t t-if="balance &lt; 0">(Dr)</t>
                                    <t t-if="balance == 0">
                                        <span style="visibility:hidden;">(Dr)</span>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <t t-if="monthTotal">
                            <tr style="font-weight:bold;">
                                <t t-if="day_summary==False and monthSummary==False">
                                    <td colspan="4" class="text-center"><t t-esc='z2'/>-(Total)
                                    </td>
                                </t>
                                <t t-else="">
                                    <td class="text-center"><t t-esc='z2'/>-(Total)
                                    </td>
                                </t>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(month_total_debit)"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(month_total_credit)"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="'{:.2f}'.format(abs(month_balance))"/>
                                    <t t-if="month_balance > 0">(Cr)</t>
                                    <t t-if="month_balance &lt; 0">(Dr)</t>
                                    <t t-if="month_balance == 0">
                                        <span style="visibility:hidden;">(Dr)</span>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <t t-if="day_summary==False and monthSummary==False">
                                <td class="text-center" colspan="4">
                                    <strong>Total</strong>
                                </td>
                            </t>
                            <t t-else="">
                                <td class="text-center">
                                    <strong>Total</strong>
                                </td>
                            </t>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(total_debit)"/>
                                </strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(total_credit)"/>
                                </strong>
                            </td>
                            <td class="text-right">
                                <strong>
                                    <t t-esc="'{:.2f}'.format(abs(balance))"/>
                                    <t t-if="balance > 0">(Cr)</t>
                                    <t t-if="balance &lt; 0">(Dr)</t>
                                    <t t-if="balance == 0">
                                        <span style="visibility:hidden;">(Dr)</span>
                                    </t>
                                </strong>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <script>
                $(document).ready(function () {
                if($('.form-inline table').hasClass('d-none')){
                $('.o_panel_get_report').addClass('d-none');
                }
                });
            </script>
        </div>
    </template>
</odoo>